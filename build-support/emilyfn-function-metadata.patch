+using System.Buffers.Binary;
+using System.Text;
+
+namespace Emilyfn.Core;
+
+// Observed CL47722112 metadata; does not invoke functions or construct call buffers.
+public static class CaptureFunctionMetadata38
+{
+    public sealed record OwnerSize(string Owner, uint StorageSize);
+    public sealed record Function(string Owner, string Kind, uint StorageSize, ushort ParameterBufferSize,
+        uint RawFlags, bool DeclaredNative, ulong? NativeEntryRva);
+    public sealed record Rejection(string Owner, string Reason);
+    public sealed record Observation(List<OwnerSize> OwnerSizes, List<Function> Functions, List<Rejection> Rejections);
+
+    public static Observation Inspect(Func<ulong, int, byte[]> read, ulong imageBase, CaptureReflectionExporter38.Observation reflection)
+    {
+        uint D(ulong a) => BinaryPrimitives.ReadUInt32LittleEndian(read(a, 4));
+        ushort W(ulong a) => BinaryPrimitives.ReadUInt16LittleEndian(read(a, 2));
+        ulong Q(ulong a) => BinaryPrimitives.ReadUInt64LittleEndian(read(a, 8));
+        foreach (var anchor in Anchors)
+            if (!read(checked(imageBase + anchor.Rva), anchor.Bytes.Length).AsSpan().SequenceEqual(anchor.Bytes))
+                throw new InvalidDataException("The image does not match the 38.00 function-layout instructions.");
+
+        // Check executable PE sections instead of treating any image pointer as code.
+        if (W(imageBase) != 0x5a4d) throw new InvalidDataException("Invalid image DOS header.");
+        uint peOffset = D(checked(imageBase + 0x3c));
+        if (peOffset is < 64 or > 0x100000) throw new InvalidDataException("Invalid PE header offset.");
+        ulong pe = checked(imageBase + peOffset);
+        if (D(pe) != 0x4550 || W(pe + 4) != 0x8664 || W(pe + 24) != 0x20b || D(pe + 24 + 56) != 0x18777000)
+            throw new InvalidDataException("Unsupported 38.00 PE image.");
+        ushort sections = W(pe + 6), optionalSize = W(pe + 20);
+        if (sections is 0 or > 96 || optionalSize is < 112 or > 4096)
+            throw new InvalidDataException("Invalid image section table.");
+        var executable = new List<(uint Start, uint End)>();
+        for (uint i = 0; i < sections; i++)
+        {
+            ulong section = checked(pe + 24 + optionalSize + i * 40);
+            uint size = D(section + 8), start = D(section + 12), flags = D(section + 36);
+            if (start > 0x18777000 || size > 0x18777000 - start)
+                throw new InvalidDataException("Image section exceeds module bounds.");
+            if ((flags & 0x20000000) != 0 && size != 0) executable.Add((start, start + size));
+        }
+        if (executable.Count == 0) throw new InvalidDataException("Image has no executable sections.");
+
+        var sizes = new List<OwnerSize>(); var functions = new List<Function>(); var rejected = new List<Rejection>();
+        var fields = reflection.Properties.ToLookup(p => p.Owner, StringComparer.Ordinal);
+        var withProperties = reflection.Owners.Select(o => o.Name).ToHashSet(StringComparer.Ordinal);
+        var seen = new HashSet<string>(StringComparer.Ordinal);
+        foreach (var owner in reflection.Candidates.OrderBy(o => o.Name, StringComparer.Ordinal))
+        {
+            bool isFunction = owner.Kind is "Function" or "DelegateFunction" or "SparseDelegateFunction";
+            if (!isFunction && !withProperties.Contains(owner.Name)) continue;
+            try
+            {
+                if (!seen.Add(owner.Name)) throw new InvalidDataException("Duplicate qualified owner name.");
+                uint storage = D(checked(owner.Address + 0x68)) ^ 0x1937f47b;
+                if (storage > 0x1000000) throw new InvalidDataException("Owner storage size exceeds supported bounds.");
+                foreach (var property in fields[owner.Name])
+                    if ((ulong)property.Offset + (ulong)property.ElementSize * property.ArrayDim > storage)
+                        throw new InvalidDataException("Property exceeds decoded owner storage size.");
+                if (withProperties.Contains(owner.Name)) sizes.Add(new(owner.Name, storage));
+                if (!isFunction) continue;
+                ushort parameters = (ushort)(W(checked(owner.Address + 0xbc)) ^ 0x8250);
+                uint flags = D(checked(owner.Address + 0xb8));
+                ulong native = Q(checked(owner.Address + 0xe0));
+                bool declaredNative = (flags & 0x400) != 0;
+                if (parameters > storage) throw new InvalidDataException("Parameter buffer exceeds owner storage size.");
+                if (native == 0 && declaredNative) throw new InvalidDataException("Native function has no entry pointer.");
+                ulong? rva = null;
+                if (native != 0)
+                {
+                    if (native < imageBase || !executable.Any(s => native - imageBase >= s.Start && native - imageBase < s.End))
+                        throw new InvalidDataException("Function entry is outside executable game sections.");
+                    rva = native - imageBase;
+                }
+                functions.Add(new(owner.Name, owner.Kind, storage, parameters, flags, declaredNative, rva));
+            }
+            catch (InvalidDataException error) { rejected.Add(new(owner.Name, error.Message)); }
+            catch (OverflowException) { rejected.Add(new(owner.Name, "Address overflow.")); }
+        }
+        return new(sizes, functions, rejected);
+    }
+
+    internal static void WriteHeaders(string folder, Observation observation)
+    {
+        static string Cpp(string text) => "\"" + string.Concat(Encoding.UTF8.GetBytes(text).Select(b => "\\" + Convert.ToString(b, 8).PadLeft(3, '0'))) + "\"";
+        using var output = new StreamWriter(Path.Combine(folder, "functions.hpp"), false, new UTF8Encoding(false));
+        output.WriteLine("#pragma once\n#include <array>\n#include <cstdint>\nnamespace emilyfn_functions38 {\n// Metadata only: entry RVAs are not callable wrappers.\ninline constexpr bool sdk_ready=false;\ninline constexpr bool function_dispatch_verified=false;\nstruct OwnerSize { const char* owner; std::uint32_t storage_size; };\nstruct Function { const char* owner; const char* kind; std::uint32_t storage_size; std::uint16_t parameter_buffer_size; std::uint32_t raw_flags; bool declared_native; bool has_native_entry; std::uint64_t native_entry_rva; };\ninline constexpr std::array<OwnerSize, " + observation.OwnerSizes.Count + "> owner_sizes = {{");
+        foreach (var size in observation.OwnerSizes) output.WriteLine("{" + Cpp(size.Owner) + "," + size.StorageSize + "u},");
+        output.WriteLine("}};\ninline constexpr std::array<Function, " + observation.Functions.Count + "> functions = {{");
+        foreach (var f in observation.Functions)
+            output.WriteLine("{" + Cpp(f.Owner) + "," + Cpp(f.Kind) + "," + f.StorageSize + "u," + f.ParameterBufferSize + "u," + f.RawFlags + "u," + (f.DeclaredNative ? "true" : "false") + "," + (f.NativeEntryRva.HasValue ? "true" : "false") + "," + (f.NativeEntryRva ?? 0) + "ull},");
+        output.WriteLine("}};\n}");
+    }
+
+    private static readonly (ulong Rva, byte[] Bytes)[] Anchors = {
+        (0x373d5UL, Convert.FromHexString("48634768ba7bf437194889c14831d148")),
+        (0x3743cUL, Convert.FromHexString("0fb787bc00000048355082000039")),
+        (0x8d7afb3UL, Convert.FromHexString("498b86e0000000"))
+    };
+}
