+using System.Buffers.Binary;
+using System.Text;
+using System.Text.Json;
+namespace Emilyfn.Core;
+
+// Observed capture metadata only. Does not execute code, inject or enable gameplay.
+public static class CaptureReflectionExporter38
+{
+    public sealed record Result(string Folder,int Owners,int Properties,int RejectedChains);
+    public sealed record Owner(ulong Address,string Name,string Kind);
+    public sealed record Property(string Owner,string Name,string Type,uint Offset,uint ElementSize,uint ArrayDim);
+    public sealed record Rejection(string Owner,string Reason);
+    public sealed record Observation(List<Owner> Owners,List<Property> Properties,List<Rejection> Rejections,int ReadableObjects,int InvalidSlots);
+    private static readonly HashSet<string> Kinds = new(){"Class","ScriptStruct","Function","DelegateFunction","SparseDelegateFunction"};
+    public static ulong DecodeLink(ulong stored) => (stored & 1)!=0 ? (stored & ~1UL)^0x47dcc0173f15ec38UL : stored;
+    // Public for offline fixture validation; callers must validate the exact image profile first.
+    public static Observation Inspect(Func<ulong,int,byte[]> read,ulong imageBase,IReadOnlyDictionary<uint,string> names)
+    {
+        uint D(ulong a)=>BinaryPrimitives.ReadUInt32LittleEndian(read(a,4));
+        ulong Q(ulong a)=>BinaryPrimitives.ReadUInt64LittleEndian(read(a,8));
+        string Name(uint stored)=>names.TryGetValue(NamePool38.DecodeIndex(stored),out var n)?n:throw new InvalidDataException("Name index unavailable.");
+        bool Image(ulong a)=>a>=imageBase && a-imageBase<0x18777000;
+        var objects=new List<Owner>();var pointers=new HashSet<ulong>();int invalid=0;
+        ulong table=Q(checked(imageBase+0x16cfacd8));uint count=D(checked(imageBase+0x16cface0));
+        if(table==0 || count is 0 or >1000000) throw new InvalidDataException("Object table is unavailable or outside supported bounds.");
+        for(uint slot=0;slot<count;slot++)
+        {
+            try
+            {
+                ulong a=Q(checked(table+slot*32UL+8)),vt=Q(a);
+                if(!Image(vt))throw new InvalidDataException("Object vtable outside game image.");
+                ulong entry=Q(vt);
+                if(entry<imageBase || entry-imageBase>=0x11000000)throw new InvalidDataException("Invalid virtual function.");
+                ulong klass=Q(checked(a+0x18));string kind=Name(D(checked(klass+0x20))),name=Name(D(checked(a+0x20)));
+                if(!pointers.Add(a))throw new InvalidDataException("Duplicate object.");
+                objects.Add(new(a,name,kind));
+            }
+            catch(InvalidDataException){invalid++;}
+            catch(OverflowException){invalid++;}
+        }
+        foreach(string required in new[]{"Object","Class","Actor","Function"})
+            if(!objects.Any(o=>o.Kind=="Class" && o.Name==required))throw new InvalidDataException("Required core class missing: "+required);
+        var meta=objects.Single(o=>o.Kind=="Class" && o.Name=="Class");
+        if(Q(meta.Address+0x18)!=meta.Address)throw new InvalidDataException("Class self-reference check failed.");
+        string Qualified(ulong a)
+        {
+            var path=new List<string>();var seen=new HashSet<ulong>();
+            while(a!=0)
+            {
+                if(!seen.Add(a)||seen.Count>64)throw new InvalidDataException("Cyclic/excessive outer chain.");
+                path.Add(Name(D(checked(a+0x20))));a=Q(checked(a+8));
+            }
+            path.Reverse();return string.Join('.',path);
+        }
+        var owners=new List<Owner>();var properties=new List<Property>();var errors=new List<Rejection>();
+        var qualifiedOwners=new HashSet<string>();
+        foreach(var obj in objects.Where(o=>Kinds.Contains(o.Kind)&&!o.Name.StartsWith("Default__",StringComparison.Ordinal)))
+        {
+            try
+            {
+                string owner=Qualified(obj.Address);ulong p=DecodeLink(Q(checked(obj.Address+0x48)));
+                var chain=new List<Property>();var seen=new HashSet<ulong>();
+                while(p!=0)
+                {
+                    if(!seen.Add(p)||seen.Count>4096)throw new InvalidDataException("Cyclic/excessive property chain.");
+                    if((Q(checked(p+0x20))&~1UL)!=obj.Address)throw new InvalidDataException("Property owner mismatch.");
+                    string name=Name(D(checked(p+0x1c)));ulong fieldClass=Q(checked(p+8));
+                    if(!Image(fieldClass))throw new InvalidDataException("Field class outside image.");
+                    string type=Name(D(checked(fieldClass+0x30)));
+                    if(!type.EndsWith("Property",StringComparison.Ordinal))throw new InvalidDataException("Unexpected field type.");
+                    uint offset=D(checked(p+0x3c))^0xf045716b, size=D(checked(p+0x28))^0xaf687e4b,dim=D(checked(p+0x60));
+                    if(offset>0x1000000||size is 0 or >0x1000000||dim is 0 or >=1000000||(ulong)size*dim>0x1000000)
+                        throw new InvalidDataException("Implausible property extent.");
+                    chain.Add(new(owner,name,type,offset,size,dim));p=DecodeLink(Q(checked(p+16)));
+                }
+                if(chain.Count>0)
+                {
+                    if(!qualifiedOwners.Add(owner))throw new InvalidDataException("Duplicate qualified owner name.");
+                    owners.Add(new(obj.Address,owner,obj.Kind));properties.AddRange(chain);
+                }
+            }
+            catch(InvalidDataException error){errors.Add(new(obj.Name,error.Message));}
+            catch(OverflowException){errors.Add(new(obj.Name,"Address overflow."));}
+        }
+        if(owners.Count==0)throw new InvalidDataException("No initialized property chains were found. A later initialized capture is required.");
+        return new(owners,properties,errors,objects.Count,invalid);
+    }
+    public static Task<Result> ExportAsync(string dump,string destination)=>Task.Run(()=>CaptureNameExporter38.WithCapture(dump,view=>
+    {
+        var observed=Inspect(view.Read,view.ImageBase,view.Names.ToDictionary(n=>n.Index,n=>n.Name));
+        var owners=observed.Owners.OrderBy(o=>o.Name,StringComparer.Ordinal).ToList();
+        var ids=owners.Select((o,i)=>(o.Name,i)).ToDictionary(x=>x.Name,x=>x.i);
+        var fields=observed.Properties.OrderBy(p=>ids[p.Owner]).ThenBy(p=>p.Offset).ThenBy(p=>p.Name,StringComparer.Ordinal).ToList();
+        string folder=Path.Combine(Path.GetFullPath(destination),"Emilyfn-38-reflection-"+Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(folder);
+        try
+        {
+            string Cpp(string text)=>"\""+string.Concat(Encoding.UTF8.GetBytes(text).Select(b=>"\\"+Convert.ToString(b,8).PadLeft(3,'0')))+"\"";
+            using(var output=new StreamWriter(Path.Combine(folder,"reflection.hpp"),false,new UTF8Encoding(false)))
+            {
+                output.WriteLine("#pragma once\n#include <array>\n#include <cstdint>\nnamespace emilyfn_capture38 {\n// Observed metadata only, not callable SDK bindings.\ninline constexpr bool sdk_ready=false;\ninline constexpr bool complete_reflection=false;\nstruct Owner { const char* name; const char* kind; };\nstruct Property { std::uint32_t owner; const char* name; const char* type; std::uint32_t offset, element_size, array_dim; };\ninline constexpr std::array<Owner, "+owners.Count+"> owners = {{");
+                foreach(var owner in owners)output.WriteLine("{"+Cpp(owner.Name)+","+Cpp(owner.Kind)+"},");
+                output.WriteLine("}};\ninline constexpr std::array<Property, "+fields.Count+"> properties = {{");
+                foreach(var p in fields)output.WriteLine("{"+ids[p.Owner]+"u,"+Cpp(p.Name)+","+Cpp(p.Type)+","+p.Offset+"u,"+p.ElementSize+"u,"+p.ArrayDim+"u},");
+                output.WriteLine("}};\n}");
+            }
+            var report=new { Profile="38.00 CL47722112",view.SourceBytes,SdkReady=false,CompleteReflection=false,FunctionDispatchVerified=false,
+                ReflectedOwners=owners.Count,Properties=fields.Count,observed.ReadableObjects,observed.InvalidSlots,RejectedChains=observed.Rejections,
+                Limitations="Only populated chains are exported. Missing sizes, flags, nested type references, bool masks and callable bindings are not inferred." };
+            File.WriteAllText(Path.Combine(folder,"reflection.json"),JsonSerializer.Serialize(new{Report=report,Owners=owners.Select(o=>new{o.Name,o.Kind}),Properties=fields},new JsonSerializerOptions{WriteIndented=true}));
+            File.WriteAllText(Path.Combine(folder,"README.txt"),"Observed capture metadata only. This is not a full gameplay SDK. See reflection.json for incomplete coverage and rejected chains. Keep runtime metadata private.\n");
+            return new Result(folder,owners.Count,fields.Count,observed.Rejections.Count);
+        }
+        catch{Directory.Delete(folder,true);throw;}
+    }));
+}
