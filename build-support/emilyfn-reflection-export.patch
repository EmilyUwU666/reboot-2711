+using Emilyfn.Core;
+using System.Buffers.Binary;
+static class ReflectionChecks
+{
+    public static void Run()
+    {
+        const ulong image=0x50000,table=0x20000000,objects=0x30000000,field=0x40000000;
+        var segments=new Dictionary<ulong,byte[]>();
+        byte[] Alloc(ulong address,int length){var b=new byte[length];segments.Add(address,b);return b;}
+        void Q(byte[] b,int o,ulong v)=>BinaryPrimitives.WriteUInt64LittleEndian(b.AsSpan(o),v);
+        void D(byte[] b,int o,uint v)=>BinaryPrimitives.WriteUInt32LittleEndian(b.AsSpan(o),v);
+        uint Enc(uint v)=>v==0?0:unchecked(((v-1)^0x6f01622bu)+1);
+        var globals=Alloc(image+0x16cfacd8,16);Q(globals,0,table);D(globals,8,6);
+        var slots=Alloc(table,192);var vt=Alloc(image+0x1000,8);Q(vt,0,image+0x2000);
+        // Class, Object, Actor and Function are class objects; Activate is a Function.
+        uint[] nameIds={2,1,3,4,5};
+        for(int i=0;i<5;i++)
+        {
+            ulong a=objects+(ulong)i*0x100;var b=Alloc(a,0x100);
+            Q(b,0,image+0x1000);Q(b,0x18,i==4?objects+0x300:objects);
+            D(b,0x20,Enc(nameIds[i]));Q(slots,i*32+8,a);
+            if(i==4)Q(b,0x48,(field^0x47dcc0173f15ec38UL)|1);
+        }
+        // Slot 5 deliberately lacks an object, so coverage is reported accurately.
+        var property=Alloc(field,0x70);Q(property,8,image+0x3000);D(property,0x1c,Enc(6));
+        Q(property,0x20,(objects+0x400)|1);D(property,0x28,1^0xaf687e4b);D(property,0x3c,0xf045716b);D(property,0x60,1);
+        var fc=Alloc(image+0x3000,0x40);D(fc,0x30,Enc(7));
+        byte[] Read(ulong a,int n)
+        {
+            foreach(var pair in segments)
+                if(a>=pair.Key && a-pair.Key<=(ulong)pair.Value.Length && (ulong)n<=(ulong)pair.Value.Length-(a-pair.Key))
+                    return pair.Value.AsSpan((int)(a-pair.Key),n).ToArray();
+            throw new InvalidDataException("Missing fixture memory");
+        }
+        var names=new Dictionary<uint,string>{{0,"None"},{1,"Object"},{2,"Class"},{3,"Actor"},{4,"Function"},{5,"Activate"},{6,"bReset"},{7,"BoolProperty"}};
+        var result=CaptureReflectionExporter38.Inspect(Read,image,names);
+        if(result.ReadableObjects!=5 || result.InvalidSlots!=1 || result.Properties.Count!=1 || result.Owners.Count!=1 || result.Rejections.Count!=0)
+            throw new Exception("Reflection fixture coverage mismatch");
+        if(result.Properties[0].Name!="bReset" || result.Properties[0].ElementSize!=1 || result.Properties[0].Offset!=0)
+            throw new Exception("Reflection property decoding mismatch");
+        void Refuse()
+        {
+            try{CaptureReflectionExporter38.Inspect(Read,image,names);}
+            catch(InvalidDataException){return;}
+            throw new Exception("Malformed property chain was accepted");
+        }
+        Q(property,16,field);Refuse();Q(property,16,0);
+        Q(property,0x20,objects|1);Refuse();Q(property,0x20,(objects+0x400)|1);
+        D(property,0x60,0);Refuse();D(property,0x60,1);
+        Q(segments[objects],0x18,objects+0x100);Refuse();
+        Console.WriteLine("Reflection checks passed: core identity, coverage, property decoding, cycles, ownership and bounds.");
+    }
+}
