diff --git a/launcher/Emilyfn.SdkTests/LiveReadRetryChecks.cs b/launcher/Emilyfn.SdkTests/LiveReadRetryChecks.cs
new file mode 100644
--- /dev/null
+++ b/launcher/Emilyfn.SdkTests/LiveReadRetryChecks.cs
@@ -0,0 +1,43 @@
+using Emilyfn.Core;
+
+static class LiveReadRetryChecks
+{
+    public static void Run()
+    {
+        var attempts=new List<LiveReadRetry38.Attempt>();int generation=0,reads=0;
+        int value=LiveReadRetry38.Run(()=>new byte[]{1},()=>
+        {
+            reads++;
+            if(generation==1)throw new InvalidDataException("Name crosses block boundary.");
+            return generation;
+        },()=>generation++,attempts);
+        if(value!=2||generation!=2||reads!=2||attempts.Count!=2||attempts[0].Decoded||!attempts[1].Decoded)
+            throw new Exception("Transient decode failure did not restart with a fresh cache.");
+        attempts.Clear();generation=0;int boundaries=0;
+        value=LiveReadRetry38.Run(()=>new byte[]{(byte)(++boundaries==1?0:1)},()=>generation,()=>generation++,attempts);
+        if(value!=2||attempts.Count!=2||attempts[0].BoundaryCountersStable||!attempts[1].BoundaryCountersStable)
+            throw new Exception("A decoded result with changed counters was accepted.");
+        attempts.Clear();generation=0;bool rejected=false;
+        try { LiveReadRetry38.Run<int>(()=>new byte[]{1},()=>throw new InvalidDataException("block=4, offset=0x1FFF0"),()=>generation++,attempts); }
+        catch(InvalidDataException error) { rejected=error.Message.Contains("block=4")&&error.Message.Contains("3 fresh reads"); }
+        if(!rejected||generation!=3||attempts.Count!=3||attempts.Any(a=>a.Decoded))
+            throw new Exception("Persistent malformed data was accepted or its context lost.");
+        attempts.Clear();generation=0;boundaries=0;rejected=false;
+        try { LiveReadRetry38.Run(()=>new byte[]{(byte)++boundaries},()=>1,()=>generation++,attempts); }
+        catch(InvalidDataException) { rejected=true; }
+        if(!rejected||generation!=3||attempts.Any(a=>a.BoundaryCountersStable))throw new Exception("Unstable reads escaped the retry bound.");
+        attempts.Clear();generation=0;rejected=false;
+        try { LiveReadRetry38.Run<int>(()=>new byte[]{1},()=>throw new TimeoutException(),()=>generation++,attempts); }
+        catch(TimeoutException) { rejected=true; }
+        if(!rejected||generation!=1)throw new Exception("Retry extended an expired read deadline.");
+        var shortBlock=Convert.FromHexString("de9a5c39743b409a");rejected=false;
+        try { NamePool38.DecodeBlocks(new[]{shortBlock}); }
+        catch(InvalidDataException error)
+        {
+            rejected=error.Message.Contains("block=0")&&error.Message.Contains("offset=0x6")&&
+                error.Message.Contains("available=2")&&error.Message.Contains("required=8")&&error.Message.Contains("currentBlock=True");
+        }
+        if(!rejected)throw new Exception("Truncated name lost its block/offset/size diagnostics.");
+        Console.WriteLine("Live read recovery checks passed: fresh-cache retry, changed counters, persistent corruption, retry/deadline bounds and precise name-boundary errors.");
+    }
+}
