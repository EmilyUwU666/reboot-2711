diff --git a/launcher/Emilyfn.Core/LiveReadRetry38.cs b/launcher/Emilyfn.Core/LiveReadRetry38.cs
new file mode 100644
--- /dev/null
+++ b/launcher/Emilyfn.Core/LiveReadRetry38.cs
@@ -0,0 +1,27 @@
+namespace Emilyfn.Core;
+
+// A bounded retry of read-only verification, never a relaxation of its validation.
+internal static class LiveReadRetry38
+{
+    internal sealed record Attempt(int Number,bool BoundaryCountersStable,bool Decoded,string? Failure);
+    internal static T Run<T>(Func<byte[]> boundary,Func<T> inspect,Action resetCache,List<Attempt> attempts)
+    {
+        for(int number=1;number<=3;number++)
+        {
+            resetCache();
+            byte[] before=boundary();
+            T result=default!;bool decoded=false;string? failure=null;
+            try { result=inspect();decoded=true; }
+            catch(InvalidDataException error) { failure=error.Message; }
+            bool stable=before.AsSpan().SequenceEqual(boundary());
+            attempts.Add(new(number,stable,decoded,failure));
+            if(decoded&&stable)return result;
+            if(number==3)
+                throw new InvalidDataException($"Live binding verification failed after {number} fresh reads. " +
+                    (stable?"Boundary counters were unchanged; this does not prove an atomic snapshot. ":"Name pool or object registry changed during the last read. ")+
+                    (failure??"Wait for startup to settle and retry."));
+            Thread.Sleep(75);
+        }
+        throw new InvalidOperationException("Unreachable read retry state.");
+    }
+}
