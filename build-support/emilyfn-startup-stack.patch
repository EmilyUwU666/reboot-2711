+DWORD CaptureGameFrames(Shared* p) {
+    // Capture the current callback stack; export only game-module RVAs, no stack contents.
+    __try {
+        void* frames[MaxFrames]{};
+        const auto count=CaptureStackBackTrace(0,MaxFrames,frames,nullptr);
+        p->totalFrameCount=count;
+        const auto image=reinterpret_cast<std::uint64_t>(GetModuleHandleW(nullptr));
+        if (p->image!=image || !p->imageSize || p->imageSize>0x20000000U) return ERROR_INVALID_DATA;
+        for (USHORT i=0;i<count;++i) {
+            const auto a=reinterpret_cast<std::uint64_t>(frames[i]);
+            if (a>=image && a-image<p->imageSize) p->gameFrameRvas[p->gameFrameCount++]=a-image;
+        }
+        return 0;
+    } __except(EXCEPTION_EXECUTE_HANDLER) { return GetExceptionCode(); }
+}
