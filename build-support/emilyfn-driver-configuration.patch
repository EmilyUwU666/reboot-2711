+        void D(ulong a,uint v)=>Put(a,BitConverter.GetBytes(v));
+        void Q(ulong a,ulong v)=>Put(a,BitConverter.GetBytes(v));
+        void Array(ulong a,ulong p,int n,int c){Q(a,p);D(a+8,(uint)n);D(a+12,(uint)c);}
+        byte[] Read(ulong a,int n)=>Enumerable.Range(0,n).Select(i=>memory.TryGetValue(a+(ulong)i,out var b)?b:throw new InvalidDataException("Missing fixture memory")).ToArray();
+        uint Encode(uint i)=>i==0?0:unchecked(((i-1)^0x6f01622bu)+1);
+        foreach(var a in DriverConfiguration38.Anchors)Put(image+a.Key,a.Value);
+        Put(image+EngineWorldContexts38.AnchorRva,EngineWorldContexts38.Anchor);
+        D(0x2014,1u^RuntimeObjectRegistry38.IndexMask);Q(0x2018,0x1000);D(0x2010,0);
+        Array(0x2fd8,0x4000,1,1);Q(0x4000,0x5000);Q(0x52b8,0x3000);
+        D(0x3014,2u^RuntimeObjectRegistry38.IndexMask);Q(0x3018,0x1100);
+        Array(0x2f50,0x6000,1,1);D(0x6000,Encode(1));D(0x6004,Encode(2));D(0x6008,Encode(3));
+        Array(0x5208,0x7000,1,1);Q(0x7000,0x8000);Q(0x7008,0x6000);
+        D(0x8014,3u^RuntimeObjectRegistry38.IndexMask);D(0x8010,0);Q(0x8018,0x1200);
+        D(0x8210,Encode(1));Q(0x81b0,0x3000);
+        var reflection=new CaptureReflectionExporter38.Observation(new(),new(),new(),0,0,new(){
+            new(0x1000,"/Script/FortniteGame.FortEngine","Class"),new(0x1100,"/Script/Engine.World","Class"),
+            new(0x1200,"/Script/OnlineSubsystemUtils.IpNetDriver","Class")})
+            {Registry=new(4,0,new(){new(1,0x2000),new(2,0x3000),new(3,0x8000)},new())};
+        var names=new Dictionary<uint,string>{{1,"GameNetDriver"},{2,"/Script/OnlineSubsystemUtils.IpNetDriver"},{3,"/Script/Missing.Driver"}};
