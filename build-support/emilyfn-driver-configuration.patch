+using System.Buffers.Binary;
+namespace Emilyfn.Core;
+
+// Exact CL47722112 instruction-derived arrays; observational only.
+public static class DriverConfiguration38
+{
+    internal static readonly Dictionary<ulong,byte[]> Anchors=new()
+    {
+        [0x482F3C3]=Convert.FromHexString(""),
+        [0x1FAFE5E]=Convert.FromHexString(""),
+    };
+    public sealed record Name(uint Index,string? Text);
+    public sealed record Definition(int Ordinal,Name Name,Name ClassPath,Name FallbackClassPath,
+        int LoadedClassMatches,int LoadedFallbackMatches);
+    public sealed record ActiveDriver(int Ordinal,uint? Slot,string? ClassName,Name? Name,
+        int? DefinitionOrdinal,uint? WorldSlot,string? Failure);
+    public sealed record Context(int Ordinal,int? Count,int? Capacity,List<ActiveDriver> Drivers,string? Failure);
+    public sealed record Report(bool InstructionProfileMatched,List<Definition> Definitions,
+        List<Context> Contexts,string? Failure,bool NetworkingCallsAttempted=false,bool GameplayReady=false)
+    {
+        public string Scope=>"Read-only cached, non-atomic configuration inventory. Loaded class matches do not prove constructibility. No driver creation, destruction, world assignment or listen call was made.";
+    }
+    public static Report Inspect(Func<ulong,int,byte[]> read,ulong image,
+        CaptureReflectionExporter38.Observation reflection,IReadOnlyDictionary<uint,string> names,
+        IReadOnlyList<uint> engineSlots)
+    {
+        var definitions=new List<Definition>();var contexts=new List<Context>();bool matched=false;
+        uint D(ulong a)=>BinaryPrimitives.ReadUInt32LittleEndian(read(a,4));
+        ulong Q(ulong a)=>BinaryPrimitives.ReadUInt64LittleEndian(read(a,8));
+        Name Decode(uint value){uint index=NamePool38.DecodeIndex(value);return new(index,names.GetValueOrDefault(index));}
+        (ulong Pointer,int Count,int Capacity) Array(ulong address,int limit)
+        {
+            var b=read(address,16);ulong pointer=BinaryPrimitives.ReadUInt64LittleEndian(b);
+            int count=BinaryPrimitives.ReadInt32LittleEndian(b.AsSpan(8)),capacity=BinaryPrimitives.ReadInt32LittleEndian(b.AsSpan(12));
+            if(count<0||count>limit||capacity<count||capacity>4096||
+                (count>0&&(pointer==0||pointer>long.MaxValue||pointer%8!=0)))
+                throw new InvalidDataException("Unsupported array bounds or alignment.");
+            return(pointer,count,capacity);
+        }
+        var entries=(reflection.Registry?.Entries??new()).GroupBy(e=>e.Address)
+            .Where(g=>g.Count()==1).ToDictionary(g=>g.Key,g=>g.Single());
+        var classes=reflection.Candidates.Where(c=>c.Kind=="Class").ToList();
+        uint Registered(ulong pointer)
+        {
+            if(!entries.TryGetValue(pointer,out var entry)||
+                (D(checked(pointer+0x14))^RuntimeObjectRegistry38.IndexMask)!=entry.Index)
+                throw new InvalidDataException("Object absent from registry or internal index changed.");
+            return entry.Index;
+        }
+        int ClassMatches(Name path)=>path.Text is null?0:classes.Count(c=>c.Name==path.Text);
+        try
+        {
+            foreach(var a in Anchors)
+                if(image==0||!read(checked(image+a.Key),a.Value.Length).AsSpan().SequenceEqual(a.Value))
+                    throw new InvalidDataException("Driver configuration instruction profile mismatch.");
+            var engineCheck=EngineWorldContexts38.Inspect(read,image,reflection,engineSlots);
+            if(!engineCheck.InstructionProfileMatched||engineCheck.Failure is not null)
+                throw new InvalidDataException(engineCheck.Failure??"Engine context profile unavailable.");
+            matched=true;
+            var engineEntries=entries.Values.Where(e=>e.Index==engineCheck.EngineSlot).ToList();
+            if(engineEntries.Count!=1)throw new InvalidDataException("Engine registry identity ambiguous.");
+            ulong engine=engineEntries[0].Address;Registered(engine);
+            var defs=Array(checked(engine+0xf50),256);
+            for(int i=0;i<defs.Count;i++)
+            {
+                ulong a=checked(defs.Pointer+(ulong)i*16);
+                var name=Decode(D(a));var path=Decode(D(a+4));var fallback=Decode(D(a+8));
+                definitions.Add(new(i,name,path,fallback,ClassMatches(path),ClassMatches(fallback)));
+            }
+            var worldContexts=Array(checked(engine+0xfd8),128);
+            for(int i=0;i<worldContexts.Count;i++)
+            {
+                var drivers=new List<ActiveDriver>();int? count=null,capacity=null;
+                try
+                {
+                    ulong context=Q(checked(worldContexts.Pointer+(ulong)i*8));
+                    if(context==0||context>long.MaxValue||context%8!=0)throw new InvalidDataException("Invalid context pointer.");
+                    var active=Array(checked(context+0x208),256);count=active.Count;capacity=active.Capacity;
+                    for(int j=0;j<active.Count;j++)
+                    {
+                        uint? slot=null,worldSlot=null;string? className=null;Name? name=null;int? definition=null;
+                        try
+                        {
+                            ulong a=checked(active.Pointer+(ulong)j*16),driver=Q(a),definitionPointer=Q(a+8);
+                            slot=Registered(driver);
+                            if((D(checked(driver+0x10))&0x10)!=0)throw new InvalidDataException("Active entry points to a class default.");
+                            ulong driverClass=Q(checked(driver+0x18));
+                            var driverClasses=classes.Where(c=>c.Address==driverClass).ToList();
+                            if(driverClasses.Count!=1)throw new InvalidDataException("Driver class identity unavailable or ambiguous.");
+                            className=driverClasses[0].Name;name=Decode(D(checked(driver+0x210)));
+                            if(definitionPointer<defs.Pointer||(definitionPointer-defs.Pointer)%16!=0||
+                                (definitionPointer-defs.Pointer)/16>=(ulong)defs.Count)
+                                throw new InvalidDataException("Definition pointer is outside the configured array.");
+                            definition=(int)((definitionPointer-defs.Pointer)/16);
+                            ulong world=Q(checked(driver+0x1b0));if(world!=0)worldSlot=Registered(world);
+                            drivers.Add(new(j,slot,className,name,definition,worldSlot,null));
+                        }
+                        catch(Exception e) when(e is InvalidDataException or OverflowException)
+                        {drivers.Add(new(j,slot,className,name,definition,worldSlot,e.Message));}
+                    }
+                    contexts.Add(new(i,count,capacity,drivers,null));
+                }
+                catch(Exception e) when(e is InvalidDataException or OverflowException)
+                {contexts.Add(new(i,count,capacity,drivers,e.Message));}
+            }
+            return new(matched,definitions,contexts,null);
+        }
+        catch(Exception e) when(e is InvalidDataException or OverflowException)
+        {return new(matched,definitions,contexts,e.Message);}
+    }
+}
