+        D(0x8014,99u^RuntimeObjectRegistry38.IndexMask);Check(Run().Contexts[0].Drivers[0].Failure is not null,"stale identity");D(0x8014,3u^RuntimeObjectRegistry38.IndexMask);
+        Array(0x5208,0,0,0);Check(Run().Contexts[0].Count==0&&Run().Contexts[0].Failure is null,"empty active array");
