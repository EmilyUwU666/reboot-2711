+        var driver=good.Contexts.Single().Drivers.Single();Check(driver.Failure is null&&driver.Slot==3&&driver.WorldSlot==2&&driver.DefinitionOrdinal==0&&driver.Name?.Text=="GameNetDriver","registered active driver");
+        Check(!good.GameplayReady&&!good.NetworkingCallsAttempted,"observational scope");
