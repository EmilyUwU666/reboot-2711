diff --git a/tests/modern_version_binding_tests.cpp b/tests/modern_version_binding_tests.cpp
new file mode 100644
index 0000000..619d041
--- /dev/null
+++ b/tests/modern_version_binding_tests.cpp
@@ -0,0 +1,50 @@
+#include "../Reboot2711/ModernVersionBinding.h"
+#include <algorithm>
+#include <fstream>
+#include <iostream>
+#include <iterator>
+#include <vector>
+#include <stdexcept>
+using namespace Reboot2711;
+int main(int argc, char** argv)
+{
+    int checks = 0;
+    const auto check = [&](bool ok) { ++checks; if (!ok) throw std::runtime_error("binding check failed"); };
+    std::vector<std::uint8_t> b(1024, 0xcc);
+    const auto install = [&](std::size_t at, std::int32_t storage, std::int32_t format) {
+        for (std::size_t i = 0; i < sizeof(ModernVersionPattern) / sizeof(int); ++i)
+            b[at+i] = ModernVersionPattern[i] < 0 ? 0 : static_cast<std::uint8_t>(ModernVersionPattern[i]);
+        storage -= static_cast<std::int32_t>(at + 45);
+        format -= static_cast<std::int32_t>(at + 67);
+        std::memcpy(b.data()+at+41, &storage, 4);
+        std::memcpy(b.data()+at+63, &format, 4);
+    };
+    check(!FindModernVersionBinding(nullptr, 1024, 0, 1024));
+    check(!FindModernVersionBinding(b.data(), 1024, 1025, 0));
+    check(!FindModernVersionBinding(b.data(), 1024, 64, 1024));
+    check(!FindModernVersionBinding(b.data(), 1024, 64, 32));
+    check(!FindModernVersionBinding(b.data(), 1024, 64, 900));
+    install(100, 70, 800);
+    auto found = FindModernVersionBinding(b.data(), 1024, 64, 900);
+    check(found && found->Storage == 70 && found->Format == 800);
+    install(300, 70, 800);
+    check(!FindModernVersionBinding(b.data(), 1024, 64, 900));
+    std::fill(b.begin(), b.end(), 0xcc);
+    install(100, 63, 800);
+    check(!FindModernVersionBinding(b.data(), 1024, 64, 900));
+    install(100, 70, 964);
+    check(!FindModernVersionBinding(b.data(), 1024, 64, 900));
+    install(100, 70, 70);
+    check(!FindModernVersionBinding(b.data(), 1024, 64, 900));
+    install(100, 70, 800); b[100] = 0;
+    check(!FindModernVersionBinding(b.data(), 1024, 64, 900));
+    if (argc == 2)
+    {
+        std::ifstream stream(argv[1], std::ios::binary);
+        std::vector<std::uint8_t> image((std::istreambuf_iterator<char>(stream)), {});
+        check(image.size() == 411324416);
+        auto actual = FindModernVersionBinding(image.data(), image.size(), 4096, 287428608);
+        check(actual && actual->Storage == 0x90866a2 && actual->Format == 0x29d7e2);
+    }
+    std::cout << checks << " binding checks passed; game functions were not executed.\n";
+}
