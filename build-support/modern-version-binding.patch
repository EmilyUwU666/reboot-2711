+# Modern engine version binding diagnostic
+
+This candidate adds a fallback for the execGetEngineVersion wrapper observed in
+38.00 CL47722112 (UE 5.7). **It does not enable Season 38 gameplay.** The existing
+19-30 / UE 5.0-5.5 compatibility gate is intentionally retained. If initialization
+reaches this fallback on 38.00, the expected next result is a precise unsupported
+build error rather than an engine-version signature error.
+
+The fallback scans only executable .text, requires one matching wrapper, decodes
+its two relative calls, and requires both targets within .text. Disassembly ties
+these calls to version storage and formatting with argument 4. The getter's
+constructor contains 5.7.0, and the formatter reads version fields into a string.
+No absolute game function address is installed in the DLL.
+
+Existing version methods run first. The new resolver is checked against malformed,
+ambiguous and out-of-section targets. Offline validation against the uploaded
+38.00 executable resolves storage RVA 0x90866a2 and formatter RVA 0x29d7e2. This
+establishes static resolution only; no game functions were executed during tests.
+
+This is a developer diagnostic, not a replacement release. The launcher still
+rejects 38.00. Authentication, Unreal object/reflection bindings, map selection,
+server hooks and gameplay require further porting. Releases 31-37 were not supplied
+and are not covered by this validation. Keep the existing working launcher package.
+
+The workflow builds both DLLs and includes their hashes and corresponding source.
+CI does not launch Fortnite or establish runtime compatibility.
diff --git a/Reboot2711/ModernVersionBinding.h b/Reboot2711/ModernVersionBinding.h
new file mode 100644
index 0000000..d42608e
--- /dev/null
+++ b/Reboot2711/ModernVersionBinding.h
@@ -0,0 +1,46 @@
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <optional>
+
+namespace Reboot2711
+{
+    // Derived from 38.00 CL47722112 execGetEngineVersion. This identifies only
+    // the version getter/formatter, not UObject layouts or gameplay support.
+    struct ModernVersionBinding { std::size_t Storage; std::size_t Format; };
+    inline constexpr int ModernVersionPattern[] = { 0x56, 0x57, 0x48, 0x83, 0xEC, 0x38, 0x4C, 0x89, 0xC6, 0x48, 0x8B, 0x05, -1, -1, -1, -1, 0x48, 0x31, 0xE0, 0x48, 0x89, 0x44, 0x24, 0x30, 0x48, 0x8B, 0x42, 0x20, 0x48, 0x83, 0xF8, 0x01, 0x48, 0x83, 0xD8, 0xFF, 0x48, 0x89, 0x42, 0x20, 0xE8, -1, -1, -1, -1, 0x48, 0x8D, 0x7C, 0x24, 0x20, 0x48, 0x89, 0xC1, 0x48, 0x89, 0xFA, 0x41, 0xB8, 0x04, 0x00, 0x00, 0x00, 0xE8, -1, -1, -1, -1 };
+
+    inline std::optional<ModernVersionBinding> FindModernVersionBinding(
+        const std::uint8_t* image, std::size_t size, std::size_t text, std::size_t length)
+    {
+        constexpr auto width = sizeof(ModernVersionPattern) / sizeof(int);
+        if (!image || size > 0xFFFFFFFFull || text > size || length > size - text || length < width)
+            return std::nullopt;
+        std::optional<ModernVersionBinding> result;
+        for (std::size_t pos = text; pos <= text + length - width; ++pos)
+        {
+            bool match = true;
+            for (std::size_t i = 0; i < width; ++i)
+                if (ModernVersionPattern[i] >= 0 && image[pos + i] != ModernVersionPattern[i])
+                { match = false; break; }
+            if (!match) continue;
+            // Ambiguous wrappers must never select an arbitrary call target.
+            if (result) return std::nullopt;
+            const auto relative = [&](std::size_t call) -> std::optional<std::size_t>
+            {
+                std::int32_t displacement = 0;
+                std::memcpy(&displacement, image + pos + call + 1, sizeof(displacement));
+                const auto target = static_cast<std::int64_t>(pos + call + 5) + displacement;
+                if (target < static_cast<std::int64_t>(text)
+                    || target >= static_cast<std::int64_t>(text + length)) return std::nullopt;
+                return static_cast<std::size_t>(target);
+            };
+            const auto storage = relative(40);
+            const auto format = relative(62);
+            if (!storage || !format || *storage == *format) return std::nullopt;
+            result = ModernVersionBinding{*storage, *format};
+        }
+        return result;
+    }
+}
