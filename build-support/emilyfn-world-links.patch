+using System.Buffers.Binary;
+namespace Emilyfn.Core;
+
+public static class WorldLinks38
+{
+    public sealed record Link(string Property,uint? Offset,string Status,uint? TargetSlot=null,string? TargetClass=null,bool? TargetIsDefault=null);
+    public sealed record World(uint Slot,List<Link> Links);
+    public sealed record Report(List<World> Worlds,int OmittedWorlds,string Scope);
+    private static readonly string[] Properties={"PersistentLevel","OwningGameInstance","NetDriver","AuthorityGameMode","GameState"};
+    public static Report Inspect(Func<ulong,int,byte[]> read,CaptureReflectionExporter38.Observation reflection,
+        CaptureFunctionMetadata38.Observation metadata,IReadOnlyList<uint> worldSlots)
+    {
+        const string owner="/Script/Engine.World";
+        var entries=reflection.Registry?.Entries ?? new();
+        var slots=entries.GroupBy(e=>e.Index).Where(g=>g.Count()==1).ToDictionary(g=>g.Key,g=>g.Single());
+        var pointers=entries.GroupBy(e=>e.Address).Where(g=>g.Count()==1).ToDictionary(g=>g.Key,g=>g.Single());
+        var classes=reflection.Candidates.Where(c=>c.Kind=="Class").GroupBy(c=>c.Address)
+            .Where(g=>g.Count()==1).ToDictionary(g=>g.Key,g=>g.Single().Name);
+        var worldClasses=reflection.Candidates.Where(c=>c.Kind=="Class"&&c.Name==owner).ToList();
+        var sizes=metadata.OwnerSizes.Where(s=>s.Owner==owner).ToList();
+        uint D(ulong a)=>BinaryPrimitives.ReadUInt32LittleEndian(read(a,4));
+        ulong Q(ulong a)=>BinaryPrimitives.ReadUInt64LittleEndian(read(a,8));
+        var worlds=new List<World>();
+        foreach(uint slot in worldSlots.Take(16))
+        {
+            var links=new List<Link>();
+            foreach(string name in Properties)
+            {
+                var fields=reflection.Properties.Where(p=>p.Owner==owner&&p.Name==name).ToList();
+                if(fields.Count!=1||sizes.Count!=1||fields[0].Type!="ObjectProperty"||fields[0].ElementSize!=8||fields[0].ArrayDim!=1||
+                    (ulong)fields[0].Offset+8>sizes[0].StorageSize)
+                { links.Add(new(name,null,"Missing, ambiguous or unsupported reflected layout"));continue; }
+                uint offset=fields[0].Offset;
+                try
+                {
+                    if(!slots.TryGetValue(slot,out var source)||worldClasses.Count!=1||
+                        (D(checked(source.Address+0x14))^RuntimeObjectRegistry38.IndexMask)!=slot||
+                        Q(checked(source.Address+0x18))!=worldClasses[0].Address||(D(checked(source.Address+0x10))&0x10)!=0)
+                    {links.Add(new(name,offset,"World identity changed or unavailable"));continue;}
+                    ulong pointer=Q(checked(source.Address+offset));
+                    if(pointer==0){links.Add(new(name,offset,"Null"));continue;}
+                    if(!pointers.TryGetValue(pointer,out var target))
+                    {links.Add(new(name,offset,"Non-null value is not a registered object; encoding or stale reference unresolved"));continue;}
+                    if((D(checked(pointer+0x14))^RuntimeObjectRegistry38.IndexMask)!=target.Index)
+                    {links.Add(new(name,offset,"Target identity changed"));continue;}
+                    ulong klass=Q(checked(pointer+0x18));
+                    if(!classes.TryGetValue(klass,out var targetClass))
+                    {links.Add(new(name,offset,"Target class unresolved",target.Index));continue;}
+                    links.Add(new(name,offset,"Registered object",target.Index,targetClass,(D(checked(pointer+0x10))&0x10)!=0));
+                }
+                catch(Exception e) when(e is InvalidDataException or OverflowException)
+                {links.Add(new(name,offset,"Unreadable or changed memory"));}
+            }
+            worlds.Add(new(slot,links));
+        }
+        return new(worlds,Math.Max(0,worldSlots.Count-16),"Read-only reflected object references; registry membership and internal indices checked. Non-atomic. No raw pointers exported. Does not establish which world is active, reference type compatibility, or gameplay readiness.");
+    }
+}
