+using Emilyfn.Core;
+static class WorldLinksChecks
+{
+    public static void Run()
+    {
+        const string world="/Script/Engine.World";
+        var values=new Dictionary<ulong,ulong> {
+            [0x2014]=1u^RuntimeObjectRegistry38.IndexMask,[0x2018]=0x1000,[0x2010]=0,
+            [0x2080]=0x3000,[0x3014]=2u^RuntimeObjectRegistry38.IndexMask,[0x3018]=0x1100,[0x3010]=0
+        };
+        byte[] Read(ulong a,int n)=>n==4?BitConverter.GetBytes((uint)values[a]):BitConverter.GetBytes(values[a]);
+        var reflection=new CaptureReflectionExporter38.Observation(new(),new(){new(world,"PersistentLevel","ObjectProperty",0x80,8,1)},new(),0,0,
+            new(){new(0x1000,world,"Class"),new(0x1100,"/Script/Engine.Level","Class")})
+            {Registry=new(3,0,new(){new(1,0x2000),new(2,0x3000)},new())};
+        var metadata=new CaptureFunctionMetadata38.Observation(new(){new(world,0x100)},new(),new());
+        WorldLinks38.Link Link()=>WorldLinks38.Inspect(Read,reflection,metadata,new uint[]{1}).Worlds[0].Links[0];
+        void Check(bool b){if(!b)throw new Exception("World-link validation failed");}
+        Check(Link().Status=="Registered object"&&Link().TargetSlot==2&&Link().TargetClass=="/Script/Engine.Level");
+        values[0x2080]=0;Check(Link().Status=="Null");
+        values[0x2080]=0xdead;Check(Link().TargetSlot is null&&Link().Status.StartsWith("Non-null"));
+        values[0x2080]=0x3000;values[0x3014]=3u^RuntimeObjectRegistry38.IndexMask;Check(Link().Status=="Target identity changed");
+        values[0x3014]=2u^RuntimeObjectRegistry38.IndexMask;values[0x2018]=0x1100;Check(Link().Status.StartsWith("World identity"));values[0x2018]=0x1000;
+        metadata.OwnerSizes.Clear();Check(Link().Offset is null);
+        metadata.OwnerSizes.Add(new(world,0x80));Check(Link().Offset is null);
+        metadata.OwnerSizes.Clear();metadata.OwnerSizes.Add(new(world,0x100));
+        var capped=WorldLinks38.Inspect(Read,reflection,metadata,Enumerable.Repeat(1u,20).ToList());Check(capped.Worlds.Count==16&&capped.OmittedWorlds==4);
+        var failed=WorldLinks38.Inspect((a,n)=>throw new InvalidDataException(),reflection,metadata,new uint[]{1});Check(failed.Worlds[0].Links[0].Status=="Unreadable or changed memory");
+        Console.WriteLine("World-link checks passed: registered/null/unregistered targets, stale identities, layout bounds, bounded reports and unreadable memory.");
+    }
+}
