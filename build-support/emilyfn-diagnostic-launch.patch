+using System.Diagnostics;
+using System.Security.Cryptography;
+
+namespace Emilyfn.Core;
+
+public static class DiagnosticGameLaunch
+{
+    // The exact uploaded 38.00 CL47722112 image. This is not a supported gameplay profile.
+    public const string ImageSha256 = "f4ddac1044edd0e8cc123f586f7204de8724989b6adcf25b2e34b4855747a5c0";
+    public static async Task<Process> StartAsync(string executable, string logsDirectory)
+    {
+        if (!OperatingSystem.IsWindows() || !Environment.Is64BitProcess)
+            throw new PlatformNotSupportedException("Diagnostic launch requires Windows x64.");
+        executable = Path.GetFullPath(executable);
+        if (!Path.GetFileName(executable).Equals("FortniteClient-Win64-Shipping.exe", StringComparison.OrdinalIgnoreCase))
+            throw new ArgumentException("Select FortniteClient-Win64-Shipping.exe inside the complete 38.00 build's FortniteGame/Binaries/Win64 folder.");
+        // Keep the verified file read-locked until CreateProcess returns.
+        using var image = new FileStream(executable, FileMode.Open, FileAccess.Read, FileShare.Read);
+        var hash = Convert.ToHexString(await SHA256.HashDataAsync(image)).ToLowerInvariant();
+        if (hash != ImageSha256)
+            throw new InvalidOperationException("This diagnostic path requires the exact uploaded 38.00 CL47722112 executable. The selected file has a different SHA-256. Gameplay support has not been enabled.");
+        var binaryDirectory = Path.GetDirectoryName(executable)!;
+        var gameDirectory = Directory.GetParent(binaryDirectory)?.Parent?.FullName;
+        if (gameDirectory is null || !Directory.Exists(Path.Combine(gameDirectory, "Content", "Paks")))
+            throw new DirectoryNotFoundException("This executable needs the complete matching game installation. FortniteGame/Content/Paks was not found.");
+        Directory.CreateDirectory(logsDirectory);
+        string log = Path.Combine(Path.GetFullPath(logsDirectory), $"diagnostic-38-{DateTime.UtcNow:yyyyMMdd-HHmmss}-{Guid.NewGuid():N}.log");
+        var start = new ProcessStartInfo(executable) { UseShellExecute = false, WorkingDirectory = binaryDirectory };
+        start.ArgumentList.Add("-log");
+        start.ArgumentList.Add("-FORCELOGFLUSH");
+        start.ArgumentList.Add("-abslog=" + log);
+        // No auth/game DLL injection, companion processes, or changes to EAC or launcher requirements.
+        return Process.Start(start) ?? throw new IOException("Windows did not start the diagnostic game process.");
+    }
+}
