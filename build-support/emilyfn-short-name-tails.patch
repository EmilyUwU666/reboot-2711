diff --git a/launcher/Emilyfn.SdkTests/ShortNameTailChecks.cs b/launcher/Emilyfn.SdkTests/ShortNameTailChecks.cs
new file mode 100644
--- /dev/null
+++ b/launcher/Emilyfn.SdkTests/ShortNameTailChecks.cs
@@ -0,0 +1,48 @@
+using Emilyfn.Core;
+using System.Buffers.Binary;
+
+static class ShortNameTailChecks
+{
+    public static void Run()
+    {
+        var none=Convert.FromHexString("de9a5c39743b");
+        var obj=Convert.FromHexString("409a9bba3605879c");
+        byte[] Block(int remainder)
+        {
+            var block=new byte[131072];int end=block.Length-remainder,offset=0;
+            none.CopyTo(block,offset);offset+=none.Length;
+            while((end-offset)%none.Length!=0){obj.CopyTo(block,offset);offset+=obj.Length;}
+            while(offset<end){none.CopyTo(block,offset);offset+=none.Length;}
+            Array.Fill(block,(byte)0xa6,end,remainder);
+            return block;
+        }
+        void Reject(Action action)
+        {
+            try{action();}catch(InvalidDataException){return;}
+            throw new Exception("Truncated name data outside a closed short tail was accepted.");
+        }
+        foreach(int remaining in new[]{2,4,6,8})
+        {
+            var block=Block(remaining);int end=block.Length-remaining;
+            foreach(ushort header in new ushort[]{0xe45e,0x9bc0,0})
+            {
+                BinaryPrimitives.WriteUInt16LittleEndian(block.AsSpan(end),header);
+                var result=NamePool38.DecodeBlocks(new[]{block,obj});
+                if(result[^1].Index!=65536||result[^1].Name!="Object"||result.Any(n=>n.Index==(uint)end/2))
+                    throw new Exception("Unmarked short tail became a name or hid the following block.");
+                if(header!=0)Reject(()=>NamePool38.DecodeBlocks(new[]{block}));
+            }
+        }
+        foreach(int remaining in new[]{10,12,40})
+        {
+            var block=Block(remaining);
+            BinaryPrimitives.WriteUInt16LittleEndian(block.AsSpan(block.Length-remaining),0xe45e);
+            Reject(()=>NamePool38.DecodeBlocks(new[]{block,obj}));
+        }
+        // Small valid names are allowed to use the end of a block exactly.
+        var exact=Block(8);obj.CopyTo(exact,exact.Length-8);
+        var names=NamePool38.DecodeBlocks(new[]{exact,obj});
+        if(!names.Any(n=>n.Index==65532&&n.Name=="Object"))throw new Exception("Valid final short name was discarded.");
+        Console.WriteLine("Short name-tail checks passed: all even remainders below ten bytes, reported 0xE45E header, current-block rejection, larger-overflow rejection and exact-fit preservation.");
+    }
+}
