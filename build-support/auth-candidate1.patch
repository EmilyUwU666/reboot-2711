diff --git a/Tellurium/RequestHook.h b/Tellurium/RequestHook.h
new file mode 100644
index 0000000..f7b9f6d
--- /dev/null
+++ b/Tellurium/RequestHook.h
@@ -0,0 +1,44 @@
+#pragma once
+#include "Startup.h"
+
+namespace Tellurium::RequestHook
+{
+    struct Site { uintptr_t function = 0; uintptr_t slot = 0; };
+
+    inline bool Install(const Site& site, void* hook, void** original)
+    {
+        if (!site.function || !site.slot || !hook || !original ||
+            site.slot % alignof(void*) || !Startup::Readable(site.slot, sizeof(void*)))
+        { Startup::Log("Refusing an invalid or missing request-table entry."); return false; }
+        DWORD protection = 0;
+        auto slot = reinterpret_cast<void* volatile*>(site.slot);
+        if (!VirtualProtect(reinterpret_cast<void*>(site.slot), sizeof(void*), PAGE_READWRITE, &protection))
+        { Startup::Log("Request-table VirtualProtect failed: Windows error=%lu", GetLastError()); return false; }
+        *original = reinterpret_cast<void*>(site.function);
+        const auto previous = InterlockedCompareExchangePointer(slot, hook, *original);
+        DWORD ignored = 0;
+        const bool restored = VirtualProtect(reinterpret_cast<void*>(site.slot), sizeof(void*), protection, &ignored) != FALSE;
+        if (previous != *original)
+        { Startup::Log("Request-table entry changed during initialization; installation skipped."); return false; }
+        if (!restored)
+        {
+            InterlockedCompareExchangePointer(slot, *original, hook);
+            VirtualProtect(reinterpret_cast<void*>(site.slot), sizeof(void*), protection, &ignored);
+            Startup::Log("Request-table protection restore failed; hook rolled back.");
+            return false;
+        }
+        return true;
+    }
+
+    inline void Remove(const Site& site, void* hook)
+    {
+        DWORD protection = 0;
+        if (!VirtualProtect(reinterpret_cast<void*>(site.slot), sizeof(void*), PAGE_READWRITE, &protection))
+        { Startup::Log("Hook rollback could not change page protection: Windows error=%lu", GetLastError()); return; }
+        InterlockedCompareExchangePointer(reinterpret_cast<void* volatile*>(site.slot),
+            reinterpret_cast<void*>(site.function), hook);
+        DWORD ignored = 0;
+        if (!VirtualProtect(reinterpret_cast<void*>(site.slot), sizeof(void*), protection, &ignored))
+            Startup::Log("Hook rollback could not restore page protection: Windows error=%lu", GetLastError());
+    }
+}
diff --git a/Tellurium/ScanRange.h b/Tellurium/ScanRange.h
new file mode 100644
index 0000000..e6f5e40
--- /dev/null
+++ b/Tellurium/ScanRange.h
@@ -0,0 +1,79 @@
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+// Range-only helpers keep scanners inside the supplied PE section.
+namespace Tellurium::ScanRange
+{
+    inline uintptr_t Pattern(const uint8_t* data, size_t length,
+        const uint8_t* bytes, const uint8_t* enabled, size_t count)
+    {
+        if (!data || !bytes || !enabled || !count || count > length) return 0;
+        size_t anchor = 0;
+        while (anchor < count && !(enabled[anchor / 8] & (1u << (anchor % 8)))) ++anchor;
+        if (anchor == count) return 0; // A pattern must identify at least one byte.
+        const size_t last = length - count;
+        size_t i = 0;
+        while (i <= last)
+        {
+            const auto match = static_cast<const uint8_t*>(
+                std::memchr(data + i + anchor, bytes[anchor], last - i + 1));
+            if (!match) break;
+            i = static_cast<size_t>(match - data) - anchor;
+            bool found = true;
+            for (size_t j = 0; j < count; ++j)
+                if ((enabled[j / 8] & (1u << (j % 8))) && data[i + j] != bytes[j])
+                { found = false; break; }
+            if (found) return reinterpret_cast<uintptr_t>(data + i);
+            ++i;
+        }
+        return 0;
+    }
+
+    inline uintptr_t StringReference(const uint8_t* code, size_t codeSize,
+        const uint8_t* rdata, size_t rdataSize, const void* string, size_t stringSize)
+    {
+        if (!code || !rdata || !string || codeSize < 7 || !stringSize || stringSize > rdataSize)
+            return 0;
+        const uintptr_t dataStart = reinterpret_cast<uintptr_t>(rdata);
+        const uintptr_t lastString = dataStart + rdataSize - stringSize;
+        size_t i = 0;
+        while (i <= codeSize - 7)
+        {
+            const auto opcode = static_cast<const uint8_t*>(
+                std::memchr(code + i + 1, 0x8d, codeSize - 7 - i + 1));
+            if (!opcode) break;
+            i = static_cast<size_t>(opcode - code) - 1;
+            // REX.W LEA reg,[RIP+disp32], including REX.R for r8-r15.
+            if ((code[i] & 0xfb) == 0x48 && (code[i + 2] & 0xc7) == 0x05)
+            {
+                int32_t displacement = 0;
+                std::memcpy(&displacement, code + i + 3, sizeof(displacement));
+                const uintptr_t next = reinterpret_cast<uintptr_t>(code + i + 7);
+                const uintptr_t target = displacement >= 0
+                    ? next + static_cast<uint32_t>(displacement)
+                    : next - static_cast<uintptr_t>(-static_cast<int64_t>(displacement));
+                if (target >= dataStart && target <= lastString &&
+                    std::memcmp(reinterpret_cast<const void*>(target), string, stringSize) == 0)
+                    return reinterpret_cast<uintptr_t>(code + i);
+            }
+            ++i;
+        }
+        return 0;
+    }
+
+    inline uintptr_t PointerSlot(const uint8_t* data, size_t length, uintptr_t target)
+    {
+        if (!data || !target || length < sizeof(uintptr_t)) return 0;
+        const size_t skip = (alignof(uintptr_t) -
+            reinterpret_cast<uintptr_t>(data) % alignof(uintptr_t)) % alignof(uintptr_t);
+        for (size_t i = skip; i <= length - sizeof(uintptr_t); i += alignof(uintptr_t))
+        {
+            uintptr_t value = 0;
+            std::memcpy(&value, data + i, sizeof(value));
+            if (value == target) return reinterpret_cast<uintptr_t>(data + i);
+        }
+        return 0;
+    }
+}
diff --git a/Tellurium/Startup.h b/Tellurium/Startup.h
new file mode 100644
index 0000000..3c67962
--- /dev/null
+++ b/Tellurium/Startup.h
@@ -0,0 +1,72 @@
+#pragma once
+#include <windows.h>
+#include <cstdio>
+#include <cstdarg>
+#include <cstdint>
+
+namespace Tellurium::Startup
+{
+    inline wchar_t LogPath[MAX_PATH] = {};
+    inline SRWLOCK LogLock = SRWLOCK_INIT;
+
+    inline void Log(const char* format, ...)
+    {
+        char line[768] = {};
+        va_list args;
+        va_start(args, format);
+        vsnprintf_s(line, sizeof(line), _TRUNCATE, format, args);
+        va_end(args);
+        AcquireSRWLockExclusive(&LogLock);
+        FILE* file = nullptr;
+        if (*LogPath && _wfopen_s(&file, LogPath, L"ab") == 0 && file)
+        {
+            fprintf(file, "[%llu] %s\r\n", static_cast<unsigned long long>(GetTickCount64()), line);
+            fclose(file);
+        }
+        ReleaseSRWLockExclusive(&LogLock);
+        OutputDebugStringA(line);
+    }
+
+    inline void Begin()
+    {
+        wchar_t temp[MAX_PATH] = {};
+        const DWORD length = GetTempPathW(MAX_PATH, temp);
+        if (length && length < MAX_PATH)
+            swprintf_s(LogPath, L"%sReboot-27.11-Auth-startup.log", temp);
+        FILE* file = nullptr;
+        if (*LogPath && _wfopen_s(&file, LogPath, L"wb") == 0 && file) fclose(file);
+        Log("Reboot 27.11 Auth candidate 1; Tellurium 8750678312c011888b82878fb1d011b97b33fff5; PID=%lu", GetCurrentProcessId());
+        Log("Backend=http://127.0.0.1:3551; routing=Default; memory patch=off; push widget patch=off");
+    }
+
+    inline void Fail(const char* reason)
+    {
+        Log("ERROR: %s", reason);
+        char message[1024] = {};
+        sprintf_s(message,
+            "Authentication initialization stopped.\n\n%s\n\n"
+            "Diagnostic log: %%TEMP%%\\Reboot-27.11-Auth-startup.log\n\n"
+            "Close this game instance before retrying. This is an experimental build.", reason);
+        MessageBoxA(nullptr, message, "Reboot 27.11 - Tellurium Auth candidate 1", MB_OK | MB_ICONERROR);
+    }
+
+    inline bool Readable(uintptr_t address, size_t length)
+    {
+        if (!address || !length || address + length < address) return false;
+        const uintptr_t end = address + length;
+        while (address < end)
+        {
+            MEMORY_BASIC_INFORMATION info = {};
+            if (!VirtualQuery(reinterpret_cast<const void*>(address), &info, sizeof(info)) ||
+                info.State != MEM_COMMIT || (info.Protect & (PAGE_GUARD | PAGE_NOACCESS))) return false;
+            const DWORD access = info.Protect & 0xff;
+            if (access != PAGE_READONLY && access != PAGE_READWRITE && access != PAGE_WRITECOPY &&
+                access != PAGE_EXECUTE_READ && access != PAGE_EXECUTE_READWRITE && access != PAGE_EXECUTE_WRITECOPY)
+                return false;
+            const uintptr_t next = reinterpret_cast<uintptr_t>(info.BaseAddress) + info.RegionSize;
+            if (next <= address) return false;
+            address = next;
+        }
+        return true;
+    }
+}
