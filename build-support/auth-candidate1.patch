diff --git a/tests/auth_scan_tests.cpp b/tests/auth_scan_tests.cpp
new file mode 100644
index 0000000..a7702e7
--- /dev/null
+++ b/tests/auth_scan_tests.cpp
@@ -0,0 +1,99 @@
+#include "../Tellurium/ScanRange.h"
+#include <array>
+#include <cstdlib>
+#include <iostream>
+#include <random>
+
+static unsigned checks = 0;
+static void require(bool pass, const char* description)
+{
+    ++checks;
+    if (!pass) { std::cerr << "FAIL: " << description << '\n'; std::exit(1); }
+}
+
+int main()
+{
+    using namespace Tellurium::ScanRange;
+    const uint8_t signature[] = {0x48, 0x89, 0x5c};
+    const uint8_t mask[] = {7};
+    std::array<uint8_t, 32> bytes{};
+    auto address = reinterpret_cast<uintptr_t>(bytes.data());
+    bytes[29] = 0x48; bytes[30] = 0x89; bytes[31] = 0x5c;
+    require(Pattern(bytes.data(), bytes.size(), signature, mask, 3) == address + 29, "last possible pattern position");
+    bytes[29] = 0;
+    require(!Pattern(bytes.data(), bytes.size(), signature, mask, 3), "tail must check first signature byte");
+    require(!Pattern(bytes.data(), 2, signature, mask, 3), "short section");
+    require(Pattern(signature, 3, signature, mask, 3) == reinterpret_cast<uintptr_t>(signature), "exact-sized section");
+    require(!Pattern(nullptr, 3, signature, mask, 3), "null section");
+    const uint8_t wildcard[] = {6};
+    require(Pattern(bytes.data(), bytes.size(), signature, wildcard, 3) == address + 29, "leading wildcard returns pattern start");
+    const uint8_t empty[] = {0};
+    require(!Pattern(bytes.data(), bytes.size(), signature, empty, 3), "all-wildcard signature rejected");
+
+    // Compare against a separate brute-force oracle, including section tails and bit-mask boundaries.
+    std::mt19937 random(2711);
+    for (unsigned trial = 0; trial < 2000; ++trial)
+    {
+        std::array<uint8_t, 80> hay{};
+        std::array<uint8_t, 20> needle{};
+        std::array<uint8_t, 3> enabled{};
+        const size_t n = 1 + random() % hay.size();
+        const size_t m = 1 + random() % needle.size();
+        for (auto& byte : hay) byte = static_cast<uint8_t>(random() % 5);
+        for (size_t j = 0; j < m; ++j)
+        {
+            needle[j] = static_cast<uint8_t>(random() % 5);
+            if (random() % 2) enabled[j / 8] |= static_cast<uint8_t>(1u << (j % 8));
+        }
+        enabled[(m - 1) / 8] |= static_cast<uint8_t>(1u << ((m - 1) % 8));
+        uintptr_t expected = 0;
+        for (size_t i = 0; i + m <= n; ++i)
+        {
+            bool match = true;
+            for (size_t j = 0; j < m; ++j)
+                if ((enabled[j / 8] & (1u << (j % 8))) && hay[i + j] != needle[j]) match = false;
+            if (match) { expected = reinterpret_cast<uintptr_t>(hay.data() + i); break; }
+        }
+        require(Pattern(hay.data(), n, needle.data(), enabled.data(), m) == expected, "pattern oracle");
+    }
+
+    std::array<uint8_t, 256> image{};
+    auto code = image.data() + 64;
+    auto data = image.data() + 160;
+    const char text[] = "request";
+    std::memcpy(data, text, sizeof(text));
+    const auto lea = [&](size_t index, const uint8_t* target)
+    {
+        code[index] = 0x48; code[index + 1] = 0x8d; code[index + 2] = 0x0d;
+        const auto displacement = static_cast<int32_t>(target - (code + index + 7));
+        std::memcpy(code + index + 3, &displacement, sizeof(displacement));
+    };
+    lea(0, data);
+    require(StringReference(code, 7, data, sizeof(text), text, sizeof(text)) == reinterpret_cast<uintptr_t>(code), "LEA at first and final position");
+    require(!StringReference(code, 6, data, sizeof(text), text, sizeof(text)), "truncated LEA");
+    code[2] = 0x09;
+    require(!StringReference(code, 7, data, sizeof(text), text, sizeof(text)), "non-RIP LEA rejected");
+    code[2] = 0x0d; code[0] = 0x4c;
+    require(StringReference(code, 7, data, sizeof(text), text, sizeof(text)) != 0, "REX.R LEA");
+    require(!StringReference(code, 7, data, sizeof(text) - 1, text, sizeof(text)), "string cannot cross data boundary");
+    std::memset(code, 0, 32);
+    lea(25, data);
+    require(StringReference(code, 32, data, sizeof(text), text, sizeof(text)) == reinterpret_cast<uintptr_t>(code + 25), "non-SIMD tail LEA");
+    std::memcpy(image.data(), text, sizeof(text));
+    std::memset(code, 0, 32);
+    lea(0, image.data());
+    require(StringReference(code, 7, image.data(), sizeof(text), text, sizeof(text)) != 0, "negative RIP displacement");
+    std::memset(code, 0, 32); code[0] = 0x8d;
+    require(!StringReference(code, 32, data, sizeof(text), text, sizeof(text)), "opcode without preceding prefix");
+
+    alignas(uintptr_t) std::array<uint8_t, 32> pointers{};
+    constexpr uintptr_t target = 0x123456789abcdef0ull;
+    std::memcpy(pointers.data() + 24, &target, sizeof(target));
+    require(PointerSlot(pointers.data(), 32, target) == reinterpret_cast<uintptr_t>(pointers.data() + 24), "last pointer slot");
+    require(!PointerSlot(pointers.data(), 31, target), "partial pointer not read");
+    require(PointerSlot(pointers.data() + 1, 31, target) == reinterpret_cast<uintptr_t>(pointers.data() + 24), "unaligned range start");
+    require(!PointerSlot(pointers.data(), 32, 0), "missing function rejected");
+    const uintptr_t sameLow = target ^ (uintptr_t(1) << 48);
+    require(!PointerSlot(pointers.data(), 32, sameLow), "compare full 64-bit pointer");
+    std::cout << checks << " scanner checks passed\n";
+}
