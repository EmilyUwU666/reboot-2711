@@ -0,0 +1,98 @@
+#include "../Tellurium/RequestHook.h"
+#include "../Tellurium/ScanRange.h"
+#include "../Tellurium/Unreal.h"
+#include "../Tellurium/URL.h"
+#include "../Tellurium/Options.h"
+#include "../Tellurium/Redirection.h"
+#include <cstdlib>
+#include <iostream>
+
+static unsigned checks = 0;
+static void require(bool pass, const char* description)
+{
+    ++checks;
+    if (!pass) { std::cerr << "FAIL: " << description << '\n'; std::exit(1); }
+}
+static void Original() {}
+static void Replacement() {}
+static void Other() {}
+static void* GameAllocator(void* pointer, __int64 size, unsigned int)
+{
+    if (!size) { std::free(pointer); return nullptr; }
+    return std::realloc(pointer, static_cast<size_t>(size));
+}
+int main()
+{
+    using namespace Tellurium;
+    const auto page = static_cast<uint8_t*>(VirtualAlloc(nullptr, 8192, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE));
+    require(page != nullptr, "allocate test pages");
+    auto slot = reinterpret_cast<void**>(page);
+    *slot = reinterpret_cast<void*>(Original);
+    DWORD old = 0;
+    require(VirtualProtect(page, 4096, PAGE_READONLY, &old) != FALSE, "read-only request table");
+    RequestHook::Site site{reinterpret_cast<uintptr_t>(Original), reinterpret_cast<uintptr_t>(slot)};
+    void* original = nullptr;
+    require(!RequestHook::Install({site.function, 0}, reinterpret_cast<void*>(Replacement), &original), "no slot must fail without a null write");
+    require(!original, "missing slot leaves original untouched");
+    require(RequestHook::Install(site, reinterpret_cast<void*>(Replacement), &original), "install read-only table hook");
+    require(*slot == reinterpret_cast<void*>(Replacement) && original == reinterpret_cast<void*>(Original), "hook and original both set");
+    MEMORY_BASIC_INFORMATION info{};
+    VirtualQuery(page, &info, sizeof(info));
+    require(info.Protect == PAGE_READONLY, "table protection restored");
+    require(!RequestHook::Install(site, reinterpret_cast<void*>(Other), &original), "do not replace a changed table slot");
+    require(*slot == reinterpret_cast<void*>(Replacement), "existing hook preserved after rejected write");
+    RequestHook::Remove(site, reinterpret_cast<void*>(Replacement));
+    require(*slot == reinterpret_cast<void*>(Original), "rollback restores original");
+    require(VirtualProtect(page + 4096, 4096, PAGE_NOACCESS, &old) != FALSE, "guard next page");
+    require(!Startup::Readable(reinterpret_cast<uintptr_t>(page + 4092), 8), "cross-page read rejected");
+    require(!RequestHook::Install({site.function, reinterpret_cast<uintptr_t>(page + 4096)}, reinterpret_cast<void*>(Replacement), &original), "inaccessible slot rejected");
+    const uint8_t signature[] = {0x48, 0x89};
+    const uint8_t enabled[] = {3};
+    require(!ScanRange::Pattern(page + 4095, 1, signature, enabled, 2), "scanner stops before no-access page");
+    VirtualFree(page, 0, MEM_RELEASE);
+
+    Unreal::FMemory__Realloc = reinterpret_cast<uintptr_t>(GameAllocator);
+    Unreal::FString shortHost = L"x";
+    require(!shortHost.ends_with(L"ol.epicgames.com"), "short domain suffix does not underflow");
+    require(!shortHost.starts_with(L"longer"), "short prefix bounded");
+    require(!shortHost.contains(L"longer"), "substring search bounded");
+    auto invalid = shortHost.substr(Unreal::FString::npos);
+    require(!invalid.String, "invalid substring offset");
+    auto clipped = shortHost.substr(0, 100);
+    require(clipped.Length == 2 && clipped.String[0] == L'x', "substring clipped to available characters");
+    clipped.Dealloc();
+    const auto route = [&](const wchar_t* input, bool valid, bool redirects, const wchar_t* expected)
+    {
+        Unreal::FString value(const_cast<wchar_t*>(input));
+        URL parsed(value);
+        require(parsed.Valid == valid, "URL validity");
+        if (valid)
+        {
+            require(Redirection::ShouldRedirect(parsed) == redirects, "domain routing");
+            auto reconstructed = parsed.GetUrl();
+            require(std::wstring_view(reconstructed.String) == expected, "URL roundtrip");
+            reconstructed.Dealloc();
+        }
+        parsed.Dealloc();
+        value.Dealloc();
+    };
+    route(L"https://fortnite-public-service-prod11.ol.epicgames.com/fortnite/api/test?x=1", true, true,
+        L"https://fortnite-public-service-prod11.ol.epicgames.com/fortnite/api/test?x=1");
+    route(L"http://127.0.0.1:3551/", true, false, L"http://127.0.0.1:3551/");
+    route(L"https://x/", true, false, L"https://x/");
+    route(L"https://notol.epicgames.com/", true, false, L"https://notol.epicgames.com/");
+    route(L"https://ol.epicgames.com", true, true, L"https://ol.epicgames.com/");
+    route(L"https://ol.epicgames.com?x=1", true, true, L"https://ol.epicgames.com/?x=1");
+    route(L"", false, false, L"");
+    route(L"garbage", false, false, L"");
+    route(L"https:///", false, false, L"");
+    route(L"https://user:pass@ol.epicgames.com/", false, false, L"");
+    Unreal::FString source = L"https://ol.epicgames.com/api?x=1";
+    URL redirected(source);
+    redirected.SetHost<Backend>();
+    auto rewritten = redirected.GetUrl();
+    require(std::wstring_view(rewritten.String) == L"http://127.0.0.1:3551/api?x=1", "backend rewrite preserves path and query");
+    rewritten.Dealloc();
+    redirected.DeallocPathQuery();
+    std::cout << checks << " Windows hook and URL checks passed\n";
+}
