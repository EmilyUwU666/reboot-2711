+using Emilyfn.Core;
+using System.Text.Json;
+var root = Path.GetFullPath(args[0]);
+Directory.CreateDirectory(root);
+var input = Path.Combine(root, "input"); Directory.CreateDirectory(input);
+void Write(string name, object data, string stamp = "123") => File.WriteAllText(Path.Combine(input, name + ".json"), JsonSerializer.Serialize(new { version = 10202, updated_at = stamp, data }));
+Write("ClassesInfo", new object[] { new Dictionary<string, object> { ["UObject"] = new object[] { new { __InheritInfo = new[] { "" } }, new { __MDKClassSize = 0 } } } });
+Write("StructsInfo", new object[] { new Dictionary<string, object> { ["FTest\"\\é"] = new object[] { new { __InheritInfo = new[] { "" } }, new { __MDKClassSize = 8 }, new Dictionary<string, object> { ["Value"] = new object[] { new object[] { "uint64", "D", "", Array.Empty<object>() }, 0, 8, 1 } } } } });
+Write("FunctionsInfo", new object[] { new Dictionary<string, object> { ["UObject"] = new object[] { new Dictionary<string, object> { ["Test"] = new object[] { new object[] { "void", "D", "", Array.Empty<object>() }, Array.Empty<object>(), 1234, "Native" } } } } });
+var result = await SdkHeaderExporter.ExportAsync(input, root, "38.00-CL-test");
+if (result.Types != 2 || result.Members != 1 || result.Functions != 1) throw new Exception("Counts differ");
+var header = File.ReadAllText(Path.Combine(result.Folder, "members.hpp"));
+if (!header.Contains("\\042\\134\\303\\251")) throw new Exception("Unsafe C++ string encoding");
+var manifest = File.ReadAllText(Path.Combine(result.Folder, "manifest.json"));
+if (!manifest.Contains("\"RuntimeVerified\": false") || !manifest.Contains("Sha256")) throw new Exception("Missing provenance");
+Write("FunctionsInfo", Array.Empty<object>(), "different");
+bool rejected = false;
+try { await SdkHeaderExporter.ExportAsync(input, root, "38.00"); } catch (InvalidDataException) { rejected = true; }
+if (!rejected) throw new Exception("Mixed snapshots accepted");
+File.WriteAllText(Path.Combine(root, "sdk-smoke.cpp"), "#include \"" + result.Folder.Replace('\\','/') + "/sdk.hpp\"\nstatic_assert(emilyfn_sdk::types.size() == 2);\nstatic_assert(emilyfn_sdk::members[0].size == 8);\nstatic_assert(emilyfn_sdk::functions[0].reported_address == 1234);\nstatic_assert(!emilyfn_sdk::runtime_verified);\nint main() {}\n");
+Console.WriteLine("SDK exporter checks passed: counts, C++ escaping, provenance and mixed-snapshot rejection.");
