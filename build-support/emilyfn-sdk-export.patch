+using Emilyfn.Core;
+using Microsoft.Win32;
+using System.Diagnostics;
+using System.Windows;
+using System.Windows.Controls;
+
+namespace Emilyfn.App;
+
+public sealed class SdkExportWindow : Window
+{
+    private readonly TextBox build = new() { Margin = new Thickness(0, 8, 0, 12) };
+    private readonly Button export = new() { Content = "Choose decoded dump and export headers" };
+    private readonly TextBlock status = new() { TextWrapping = TextWrapping.Wrap, Margin = new Thickness(0, 12, 0, 0) };
+    private bool busy;
+    public SdkExportWindow()
+    {
+        Title = "Emilyfn — SDK metadata headers"; Width = 720; Height = 400; WindowStartupLocation = WindowStartupLocation.CenterOwner;
+        var panel = new StackPanel { Margin = new Thickness(24) };
+        panel.Children.Add(new TextBlock { Text = "Generate SDK metadata headers", FontSize = 20 });
+        panel.Children.Add(new TextBlock { Text = "Import ClassesInfo.json, StructsInfo.json and FunctionsInfo.json from one Dumpspace snapshot. Exports C++17 class, property and function metadata. Raw memory dumps cannot be decoded here yet; live 38.00 SDK generation is still unavailable.", TextWrapping = TextWrapping.Wrap, Margin = new Thickness(0, 12, 0, 12) });
+        panel.Children.Add(new TextBlock { Text = "Source dump build and CL (as reported by its author)" });
+        panel.Children.Add(build); panel.Children.Add(export); panel.Children.Add(status); Content = panel;
+        export.Click += async (_, _) => await Export();
+        Closing += (_, e) => { if (busy) e.Cancel = true; };
+    }
+    private async Task Export()
+    {
+        if (string.IsNullOrWhiteSpace(build.Text)) { status.Text = "Enter the source dump's build and CL first."; return; }
+        var source = new OpenFolderDialog { Title = "Choose folder containing decoded Dumpspace JSON" };
+        if (source.ShowDialog(this) != true) return;
+        var output = new OpenFolderDialog { Title = "Choose SDK output folder" };
+        if (output.ShowDialog(this) != true) return;
+        busy = true; export.IsEnabled = build.IsEnabled = false; status.Text = "Generating headers…";
+        try
+        {
+            var result = await SdkHeaderExporter.ExportAsync(source.FolderName, output.FolderName, build.Text.Trim());
+            status.Text = $"Saved {result.Types:N0} types, {result.Members:N0} members and {result.Functions:N0} functions to {result.Folder}. These are source metadata, not verified live bindings.";
+            try { Process.Start(new ProcessStartInfo("explorer.exe") { UseShellExecute = true, ArgumentList = { result.Folder } }); } catch { }
+        }
+        catch (Exception error) { status.Text = error.Message; }
+        finally { busy = false; export.IsEnabled = build.IsEnabled = true; }
+    }
+}
