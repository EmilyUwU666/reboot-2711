+using System.Security.Cryptography;
+using System.Text;
+using System.Text.Json;
+
+namespace Emilyfn.Core;
+
+// Produces reflection metadata headers, never unverified object layouts or dispatch wrappers.
+public static class SdkHeaderExporter
+{
+    public sealed record Result(string Folder, int Types, int Members, int Functions);
+    private sealed record Input(string Name, byte[] Bytes, JsonDocument Document);
+    public static Task<Result> ExportAsync(string source, string destination, string sourceBuild) =>
+        Task.Run(() => Export(source, destination, sourceBuild));
+
+    private static Result Export(string source, string destination, string sourceBuild)
+    {
+        if (string.IsNullOrWhiteSpace(sourceBuild) || sourceBuild.Length > 200 || sourceBuild.Any(char.IsControl))
+            throw new ArgumentException("Enter the dump's source build, including its CL when known.");
+        var inputs = new List<Input>();
+        string? folder = null;
+        try
+        {
+            foreach (string name in new[] { "ClassesInfo.json", "StructsInfo.json", "FunctionsInfo.json" })
+            {
+                var path = Path.Combine(source, name);
+                if (!File.Exists(path)) throw new FileNotFoundException($"Missing {name}. Select a decoded Dumpspace SDK folder, not a raw .dmp file.");
+                if (new FileInfo(path).Length > 256L * 1024 * 1024) throw new IOException($"{name} exceeds the 256 MB import limit.");
+                var bytes = File.ReadAllBytes(path);
+                var doc = JsonDocument.Parse(bytes);
+                inputs.Add(new(name, bytes, doc));
+                if (doc.RootElement.GetProperty("version").GetInt32() != 10202 ||
+                    doc.RootElement.GetProperty("data").ValueKind != JsonValueKind.Array)
+                    throw new InvalidDataException($"{name} is not a supported Dumpspace 10202 document.");
+            }
+            // A mixed snapshot can silently give incompatible class and function definitions.
+            if (inputs.Select(i => i.Document.RootElement.GetProperty("updated_at").ToString()).Distinct().Count() != 1)
+                throw new InvalidDataException("The input files have different snapshot timestamps. Use files from the same dump.");
+            var types = new List<string>(); var members = new List<string>(); var functions = new List<string>();
+            foreach (var input in inputs.Take(2))
+            foreach (var entry in input.Document.RootElement.GetProperty("data").EnumerateArray())
+            foreach (var type in entry.EnumerateObject())
+            {
+                long size = -1; string inherit = "";
+                foreach (var field in type.Value.EnumerateArray())
+                foreach (var property in field.EnumerateObject())
+                {
+                    if (property.Name == "__MDKClassSize") { size = Number(property.Value); continue; }
+                    if (property.Name == "__InheritInfo") { inherit = property.Value.GetRawText(); continue; }
+                    if (property.Name.StartsWith("__", StringComparison.Ordinal)) continue;
+                    var v = property.Value;
+                    if (v.ValueKind != JsonValueKind.Array || v.GetArrayLength() < 4)
+                        throw new InvalidDataException($"Unsupported member in {type.Name}.");
+                    long offset = Number(v[1]), width = Number(v[2]), count = Number(v[3]);
+                    long bit = v.GetArrayLength() > 4 ? Number(v[4]) : -1;
+                    members.Add($"{{{Quote(type.Name)}, {Quote(property.Name)}, {Quote(v[0].GetRawText())}, {offset}ULL, {width}ULL, {count}ULL, {bit}}}");
+                }
+                if (size < 0) throw new InvalidDataException($"Missing size for {type.Name}.");
+                types.Add($"{{{Quote(type.Name)}, {Quote(input.Name == "ClassesInfo.json" ? "class" : "struct")}, {size}ULL, {Quote(inherit)}}}");
+            }
+            foreach (var entry in inputs[2].Document.RootElement.GetProperty("data").EnumerateArray())
+            foreach (var owner in entry.EnumerateObject())
+            foreach (var item in owner.Value.EnumerateArray())
+            foreach (var fn in item.EnumerateObject())
+            {
+                var v = fn.Value;
+                if (v.ValueKind != JsonValueKind.Array || v.GetArrayLength() < 4)
+                    throw new InvalidDataException($"Unsupported function in {owner.Name}.");
+                functions.Add($"{{{Quote(owner.Name)}, {Quote(fn.Name)}, {Quote(v[0].GetRawText())}, {Quote(v[1].GetRawText())}, {Number(v[2])}ULL, {Quote(v[3].GetString() ?? "")}}}");
+            }
+            folder = Path.Combine(Path.GetFullPath(destination), "Emilyfn-SDK-" + Guid.NewGuid().ToString("N"));
+            Directory.CreateDirectory(folder);
+            string header = "#pragma once\n#include <array>\n#include <cstdint>\n#include <string_view>\n\nnamespace emilyfn_sdk {\n" +
+                "// Source metadata only. Addresses are unverified; no dispatch or live-object access is generated.\n" +
+                "struct Type { std::string_view name, kind; std::uint64_t reported_size; std::string_view inheritance_json; };\n" +
+                "struct Member { std::string_view owner, name, type_json; std::uint64_t offset, size, array_count; std::int64_t bit_index; };\n" +
+                "struct Function { std::string_view owner, name, return_type_json, parameters_json; std::uint64_t reported_address; std::string_view reported_flags; };\n" +
+                $"inline constexpr std::string_view source_build = {Quote(sourceBuild)};\n" +
+                "inline constexpr bool runtime_verified = false;\n";
+            WriteTable(folder, "types.hpp", header, "Type", "types", types);
+            WriteTable(folder, "members.hpp", header, "Member", "members", members);
+            WriteTable(folder, "functions.hpp", header, "Function", "functions", functions);
+            // Common declarations live in one header, avoiding redefinitions when tables are included together.
+            File.WriteAllText(Path.Combine(folder, "metadata.hpp"), header + "}\n", new UTF8Encoding(false));
+            File.WriteAllText(Path.Combine(folder, "sdk.hpp"), "#pragma once\n#include \"types.hpp\"\n#include \"members.hpp\"\n#include \"functions.hpp\"\n", new UTF8Encoding(false));
+            File.WriteAllText(Path.Combine(folder, "manifest.json"), JsonSerializer.Serialize(new {
+                Format = "Emilyfn SDK metadata headers v1", SourceBuildLabel = sourceBuild,
+                BuildLabelVerified = false, RuntimeVerified = false,
+                Types = types.Count, Members = members.Count, Functions = functions.Count,
+                Inputs = inputs.Select(i => new { File = i.Name, Sha256 = Convert.ToHexString(SHA256.HashData(i.Bytes)).ToLowerInvariant() })
+            }, new JsonSerializerOptions { WriteIndented = true }));
+            File.WriteAllText(Path.Combine(folder, "README.txt"),
+                "Emilyfn SDK metadata headers (C++17)\nInclude sdk.hpp to inspect emilyfn_sdk::types, members and functions.\n" +
+                "Generated from decoded Dumpspace 10202 JSON; not from a raw memory dump.\n" +
+                "The source build label is user supplied, not independently verified. See manifest.json for input hashes.\n" +
+                "Reported zero sizes, flags and addresses are preserved, not inferred or corrected.\n" +
+                "These headers describe the source dump. They do not provide C++ object layouts, callable wrappers, global offsets, or playable build support.\n" +
+                "Never use another CL's addresses without independent validation.\n");
+            return new(folder, types.Count, members.Count, functions.Count);
+        }
+        catch
+        {
+            if (folder is not null && Directory.Exists(folder)) Directory.Delete(folder, true);
+            throw;
+        }
+        finally { foreach (var input in inputs) input.Document.Dispose(); }
+    }
+    private static long Number(JsonElement value)
+    {
+        if (!value.TryGetInt64(out var number) || number < 0) throw new InvalidDataException("A dump offset, size or address is invalid.");
+        return number;
+    }
+    private static void WriteTable(string folder, string file, string header, string type, string name, List<string> rows)
+    {
+        using var output = new StreamWriter(Path.Combine(folder, file), false, new UTF8Encoding(false));
+        output.WriteLine("#pragma once\n#include \"metadata.hpp\"\nnamespace emilyfn_sdk {");
+        output.WriteLine($"inline constexpr std::array<{type}, {rows.Count}> {name} = {{{{");
+        foreach (var row in rows) output.WriteLine(row + ",");
+        output.WriteLine("}};\n}");
+    }
+    private static string Quote(string text)
+    {
+        // Fixed three-digit octal escapes avoid both source injection and ambiguous C++ hex escapes.
+        var result = new StringBuilder("\"");
+        foreach (var b in Encoding.UTF8.GetBytes(text))
+            if (b >= 32 && b <= 126 && b != 34 && b != 92) result.Append((char)b);
+            else result.Append('\\').Append(Convert.ToString(b, 8).PadLeft(3, '0'));
+        return result.Append('"').ToString();
+    }
+}
