+++ b/launcher/Emilyfn.Tests/native/child.cpp
@@ -0,0 +1,28 @@
+#include <windows.h>
+#include <cstdio>
+#include <string>
+
+int wmain(int argc, wchar_t** argv)
+{
+    wchar_t module[MAX_PATH]{};
+    GetModuleFileNameW(nullptr, module, MAX_PATH);
+    std::wstring receipt = std::wstring(module) + L".started-" + std::to_wstring(GetCurrentProcessId());
+    auto file = CreateFileW(receipt.c_str(), GENERIC_WRITE, FILE_SHARE_READ, nullptr, CREATE_ALWAYS, 0, nullptr);
+    if (file != INVALID_HANDLE_VALUE) CloseHandle(file);
+    std::wstring log;
+    for (int i = 1; i < argc; i++)
+        if (std::wstring(argv[i]).rfind(L"-abslog=", 0) == 0) log = argv[i] + 8;
+    for (int i = 0; i < 1200; i++)
+    {
+        if (!log.empty() && GetModuleHandleW(L"Reboot-S19-S30-Auth.dll"))
+        {
+            FILE* out = nullptr;
+            _wfopen_s(&out, log.c_str(), L"ab");
+            if (out) { fputs("[UOnlineAccountCommon::ContinueLoggingIn] (Completed)\n", out); fclose(out); }
+            puts("[UOnlineAccountCommon::ContinueLoggingIn] (Completed)"); fflush(stdout);
+            log.clear();
+        }
+        Sleep(50);
+    }
+    return 0;
+}
diff --git a/launcher/Emilyfn.Tests/native/module.cpp b/launcher/Emilyfn.Tests/native/module.cpp
new file mode 100644
index 0000000..4b2e8c1
--- /dev/null
+++ b/launcher/Emilyfn.Tests/native/module.cpp
@@ -0,0 +1,43 @@
+#include <winsock2.h>
+#include <windows.h>
+#include <cstdio>
+#include <string>
+#pragma comment(lib,"Ws2_32.lib")
+#ifndef MODULE_ROLE
+#define MODULE_ROLE 0
+#endif
+
+static DWORD WINAPI Work(void*)
+{
+    wchar_t temporary[MAX_PATH]{};
+    GetTempPathW(MAX_PATH, temporary);
+    const wchar_t* role = MODULE_ROLE == 0 ? L"Auth" : MODULE_ROLE == 1 ? L"Server" : L"Client";
+    const auto path = std::wstring(temporary) + L"Reboot-S19-S30-" + role + L"-startup.log";
+    FILE* file = nullptr;
+    _wfopen_s(&file, path.c_str(), MODULE_ROLE == 0 ? L"wb" : L"ab");
+    if (file)
+    {
+        if (MODULE_ROLE == 0)
+        {
+            fprintf(file, "Synthetic auth fixture; PID=%lu\n", GetCurrentProcessId());
+            if (GetEnvironmentVariableW(L"EMILYFN_TEST_FAIL_AUTH", nullptr, 0)) fputs("ERROR: intentional authentication fixture failure\n", file);
+            else fputs("READY: game and EOS authentication hooks installed\n", file);
+        }
+        else fprintf(file, "[PID %lu] S19-S30 candidate 1 SDK initialized; synthetic fixture\n", GetCurrentProcessId());
+        fclose(file);
+    }
+    if (MODULE_ROLE == 1)
+    {
+        WSADATA data{}; WSAStartup(MAKEWORD(2,2), &data);
+        auto socket = ::socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+        sockaddr_in address{}; address.sin_family = AF_INET; address.sin_addr.s_addr = htonl(INADDR_LOOPBACK); address.sin_port = htons(7777);
+        if (bind(socket, reinterpret_cast<sockaddr*>(&address), sizeof(address)) == 0) Sleep(60000);
+        closesocket(socket); WSACleanup();
+    }
+    return 0;
+}
+BOOL WINAPI DllMain(HMODULE, DWORD reason, LPVOID)
+{
+    if (reason == DLL_PROCESS_ATTACH) { auto thread = CreateThread(nullptr, 0, Work, nullptr, 0, nullptr); if (thread) CloseHandle(thread); }
+    return TRUE;
+}
