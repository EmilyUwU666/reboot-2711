diff --git a/launcher/Emilyfn.Tests/FeatureChecks.cs b/launcher/Emilyfn.Tests/FeatureChecks.cs
new file mode 100644
index 0000000..7d8242b
--- /dev/null
+++ b/launcher/Emilyfn.Tests/FeatureChecks.cs
@@ -0,0 +1,115 @@
+using Emilyfn.Core;
+using System.Buffers.Binary;
+using System.IO.Pipes;
+using System.Text;
+using System.Text.Json;
+
+internal static class FeatureChecks
+{
+    public static async Task<int> RunAsync(string root,string game,string executable)
+    {
+        var checks=0;
+        void Check(bool value,string message) { if(!value)throw new Exception(message); checks++; }
+        for(var season=19;season<=30;season++)
+        {
+            foreach(var encoding in new[]{Encoding.ASCII,Encoding.Unicode})
+            {
+                var tag=encoding.GetBytes($"5.4.0-1+++Fortnite+Release-{season}.11\0\0");
+                using var data=new MemoryStream(); data.WriteByte(1); data.Write(tag); data.Position=0;
+                Check(BuildDetector.ReadEmbeddedRelease(data)==$"{season}.11","compiled branch detects game release in both encodings");
+            }
+        }
+        using(var data=new MemoryStream())
+        {
+            data.Write(new byte[1024*1024+240]); data.Write(Encoding.Unicode.GetBytes("+++Fortnite+Release-27.11\0\0")); data.Position=0;
+            Check(BuildDetector.ReadEmbeddedRelease(data)=="27.11","branch tag across buffer boundary");
+        }
+        foreach(var text in new[]{"5.4.0-1234", "folder27.11", "+++Fortnite+Release-27.110\0\0", "+++Fortnite+Release-27.11\0\0+++Fortnite+Release-30.00\0\0"})
+        {
+            using var data=new MemoryStream(Encoding.ASCII.GetBytes(text));
+            Check(BuildDetector.ReadEmbeddedRelease(data) is null,"unrelated, malformed and ambiguous releases are not guessed");
+        }
+        Check(BuildDetector.NormalizeRoot(executable)==game,"executable normalizes to installation root");
+        Check(BuildDetector.NormalizeRoot(Path.Combine(game,"FortniteGame"))==game,"FortniteGame normalizes to root");
+        var result=BuildDetector.Scan([game,game+Path.DirectorySeparatorChar],CancellationToken.None);
+        Check(result.Builds.Count==1 && result.Builds[0].Release=="27.11","installation discovery validates and deduplicates roots");
+        Check(BuildDetector.Scan([root],new CancellationToken(true)).Incomplete,"scan cancellation returns partial result");
+        Check(BuildDetector.Scan([root],CancellationToken.None,maxDirectories:1).Incomplete,"scan directory budget is bounded");
+        var manifestDirectory=Path.Combine(root,"epic manifests"); Directory.CreateDirectory(manifestDirectory);
+        File.WriteAllText(Path.Combine(manifestDirectory,"fortnite.item"),JsonSerializer.Serialize(new {InstallLocation=game}));
+        File.WriteAllText(Path.Combine(manifestDirectory,"broken.item"),"{invalid");
+        File.WriteAllText(Path.Combine(manifestDirectory,"wrong-shape.item"),"[]");
+        var installed=Path.Combine(root,"LauncherInstalled.dat");
+        File.WriteAllText(installed,JsonSerializer.Serialize(new {InstallationList=new[]{new {InstallLocation=game}}}));
+        Check(BuildDetector.ManifestRoots(manifestDirectory,installed).Single()==game,"Epic manifest formats and malformed records");
+        var idleHost=new SessionStatus(GameRole.Host,LaunchStage.Idle,"Idle");
+        var idleClient=new SessionStatus(GameRole.Client,LaunchStage.Idle,"Idle");
+        var selected=new GameInstall("test",game,"19.40");
+        var activity=DiscordPresence.Describe(selected,new(GameRole.Host,LaunchStage.Listening,"Private path",123,"27.11"),idleClient,1234567);
+        Check(activity.Details=="Fortnite 27.11" && activity.State=="Hosting a local server","presence uses actual running build rather than newly selected build");
+        Check(DiscordPresence.Describe(selected,idleHost,new(GameRole.Client,LaunchStage.Active,"Private path",456,"30.00"),1234567).State=="Client active","presence does not invent match state");
+        var serialized=Encoding.UTF8.GetString(DiscordPresence.ActivityPayload(activity));
+        Check(!serialized.Contains(game) && !serialized.Contains("Private path"),"presence excludes paths and internal diagnostic details");
+        foreach(var id in new[]{"", "bot-token", "123", "000000000000000000", "123456789012345678901"})Check(!DiscordPresence.ValidApplicationId(id),"invalid application ID rejected");
+        Check(DiscordPresence.ValidApplicationId("123456789012345678"),"application ID accepted");
+        var badHeader=new byte[8];BinaryPrimitives.WriteInt32LittleEndian(badHeader.AsSpan(4),1024*1024+1);
+        try { await DiscordPresence.ReadFrameAsync(new MemoryStream(badHeader),CancellationToken.None); throw new Exception("Oversized frame was accepted"); }
+        catch(InvalidDataException) { checks++; }
+        using var timeout=new CancellationTokenSource(TimeSpan.FromSeconds(15));
+        var token=timeout.Token;
+        var pipeName="emilyfn-rpc-test-"+Guid.NewGuid().ToString("N");
+        var pipe=new NamedPipeServerStream(pipeName,PipeDirection.InOut,1,PipeTransmissionMode.Byte,PipeOptions.Asynchronous);
+        await using var presence=new DiscordPresence([pipeName],TimeSpan.FromMilliseconds(100),TimeSpan.FromMilliseconds(80));
+        try
+        {
+            presence.Update(activity);
+            await presence.ConfigureAsync(true,"123456789012345678");
+            await pipe.WaitForConnectionAsync(token);
+            var handshake=await DiscordPresence.ReadFrameAsync(pipe,token);
+            using(var json=JsonDocument.Parse(handshake.Payload))Check(handshake.Opcode==0 && json.RootElement.GetProperty("client_id").GetString()=="123456789012345678","IPC handshake uses configured public app ID");
+            // Deliberately fragment READY across header/payload boundaries.
+            var ready=Encoding.UTF8.GetBytes("{\"cmd\":\"DISPATCH\",\"evt\":\"READY\",\"data\":{\"v\":1}}");
+            var header=new byte[8];BinaryPrimitives.WriteInt32LittleEndian(header,1);BinaryPrimitives.WriteInt32LittleEndian(header.AsSpan(4),ready.Length);
+            await pipe.WriteAsync(header.AsMemory(0,3),token);await pipe.WriteAsync(header.AsMemory(3),token);
+            await pipe.WriteAsync(ready.AsMemory(0,7),token);await pipe.WriteAsync(ready.AsMemory(7),token);
+            var first=await DiscordPresence.ReadFrameAsync(pipe,token);
+            using(var json=JsonDocument.Parse(first.Payload))Check(first.Opcode==1 && json.RootElement.GetProperty("args").GetProperty("activity").GetProperty("details").GetString()=="Fortnite 27.11","fragmented READY followed by correct SET_ACTIVITY");
+            await DiscordPresence.WriteFrameAsync(pipe,3,[1,2,3,4],token);
+            var pong=false;
+            while(!pong) { var frame=await DiscordPresence.ReadFrameAsync(pipe,token);if(frame.Opcode==4){Check(frame.Payload.SequenceEqual(new byte[]{1,2,3,4}),"PING payload echoed in PONG");pong=true;} }
+            await DiscordPresence.WriteFrameAsync(pipe,1,Encoding.UTF8.GetBytes("{\"cmd\":\"SET_ACTIVITY\",\"evt\":null,\"data\":{}}"),token);
+            while(presence.Status!="Connected")await Task.Delay(10,token);
+            Check(presence.Status=="Connected","presence connection reported after activity acknowledgement");
+            presence.Update(new("Fortnite 30.00","Client active",1234567));
+            var updated=false;
+            while(!updated)
+            {
+                var frame=await DiscordPresence.ReadFrameAsync(pipe,token);if(frame.Opcode!=1)continue;
+                using var json=JsonDocument.Parse(frame.Payload);
+                updated=json.RootElement.GetProperty("args").GetProperty("activity").GetProperty("details").GetString()=="Fortnite 30.00";
+            }
+            Check(updated,"presence changes follow the latest state");
+            pipe.Dispose();
+            pipe=new NamedPipeServerStream(pipeName,PipeDirection.InOut,1,PipeTransmissionMode.Byte,PipeOptions.Asynchronous);
+            await pipe.WaitForConnectionAsync(token);
+            Check((await DiscordPresence.ReadFrameAsync(pipe,token)).Opcode==0,"Discord reconnect sends a new handshake");
+            await DiscordPresence.WriteFrameAsync(pipe,1,ready,token);
+            var reconnect=await DiscordPresence.ReadFrameAsync(pipe,token);
+            using(var json=JsonDocument.Parse(reconnect.Payload))Check(json.RootElement.GetProperty("args").GetProperty("activity").GetProperty("details").GetString()=="Fortnite 30.00","reconnect restores latest presence");
+            var stop=presence.ConfigureAsync(false,"");
+            var cleared=false;
+            while(!cleared)
+            {
+                var frame=await DiscordPresence.ReadFrameAsync(pipe,token);if(frame.Opcode!=1)continue;
+                using var json=JsonDocument.Parse(frame.Payload);
+                cleared=json.RootElement.GetProperty("args").GetProperty("activity").ValueKind==JsonValueKind.Null;
+            }
+            await stop;
+            Check(cleared && presence.Status=="Disabled","disable clears presence before closing IPC");
+            await presence.ConfigureAsync(true,"not-an-id");
+            Check(presence.Status.Contains("Application ID"),"missing ID has a useful setup status");
+        }
+        finally { pipe.Dispose(); }
+        return checks;
+    }
+}
diff --git a/launcher/Emilyfn.Tests/Program.cs b/launcher/Emilyfn.Tests/Program.cs
new file mode 100644
index 0000000..d7b902c
--- /dev/null
+++ b/launcher/Emilyfn.Tests/Program.cs
@@ -0,0 +1,153 @@
+using Emilyfn.Core;
+using System.Collections.Concurrent;
+using System.Diagnostics;
+using System.Net;
+using System.Net.Sockets;
+using System.Text;
+using System.Text.Json;
+
+var checks = 0;
+void Check(bool condition, string message) { if (!condition) throw new Exception(message); checks++; }
+void Throws(Action action, string message) { try { action(); } catch { checks++; return; } throw new Exception(message); }
+async Task Until(Func<bool> condition, string description)
+{
+    var clock = Stopwatch.StartNew();
+    while (!condition() && clock.Elapsed < TimeSpan.FromSeconds(15)) await Task.Delay(50);
+    Check(condition(), description);
+}
+var root = Path.Combine(Path.GetTempPath(), "Emilyfn tests " + Guid.NewGuid().ToString("N"));
+Directory.CreateDirectory(root);
+LauncherEngine? engine = null;
+Process? unrelated = null;
+Process? suspended = null;
+using var backendCancellation = new CancellationTokenSource();
+TcpListener? listener = null;
+BackendManager? bundled = null;
+try
+{
+    for (var season = 19; season <= 30; season++)
+    {
+        Check(Releases.Valid($"{season}.00") && Releases.Valid($"{season}.40"), $"Season {season} range");
+        Check(Releases.FromMetadata($"5.4.0-123+++Fortnite+Release-{season}.11") == $"{season}.11", "engine/game separation");
+    }
+    foreach (var release in new[] { "18.40", "31.00", "5.4.0", "27.110", "27.011", "027.11", "27.1", "27.11 -foo" }) Check(!Releases.Valid(release), "invalid release rejected");
+    Check(Releases.FromMetadata("5.4.0", "5.4") is null, "engine metadata is not a Fortnite release");
+    Check(Releases.FromMetadata("5.5.0-1+++Fortnite+Release-31.00") == "31.00", "out-of-range metadata remains visible for rejection");
+    Check(Releases.Island("19.40") == "Artemis" && Releases.Island("24.40") == "Asteria" && Releases.Island("27.11") == "Athena" && Releases.Island("30.40") == "Helios", "island mapping");
+    Throws(() => LaunchProtocol.ValidateName("a\" -flag"), "argument name validation");
+    var clientArgs = LaunchProtocol.Arguments("Emily", GameRole.Client, true, @"C:\path with spaces\client.log", ["-epicapp=Fortnite"]);
+    var hostArgs = LaunchProtocol.Arguments("Emily", GameRole.Host, true, @"C:\path with spaces\host.log", ["-epicapp=Fortnite"]);
+    Check(!clientArgs.Contains("-nullrhi") && hostArgs.Contains("-nullrhi"), "headless applies only to host");
+    Check(clientArgs.Single(a => a.StartsWith("-AUTH_LOGIN")) != hostArgs.Single(a => a.StartsWith("-AUTH_LOGIN")), "host and player use distinct local profiles");
+    Check(clientArgs.Contains(@"-abslog=C:\path with spaces\client.log"), "argument boundaries retain spaces");
+    foreach (var line in new[] { "-AUTH_PASSWORD=secret", "Authorization: Bearer secret", "{\"access_token\":\"secret\"}", "refresh_token=secret", "-caldera=secret" })
+        Check(!LaunchProtocol.Redact(line).Contains("secret"), "credential redaction: " + line.Split('=')[0]);
+    var signals = new LogSignals();
+    signals.Observe("[UOnlineAccountCommon::ContinueLoggingIn] Started");
+    Check(!signals.Login.Task.IsCompleted, "partial login is not ready");
+    signals.Observe("[UOnlineAccountCommon::ContinueLoggingIn] (Completed)");
+    Check(signals.Login.Task.IsCompletedSuccessfully, "completed login detected");
+    signals.Observe("LogWindows: Fatal error!");
+    Check(signals.FatalError.Task.IsCompleted, "game fatal is detected");
+    var store = new SettingsStore(Path.Combine(root, "settings"));
+    var setting = new LauncherSettings { DisplayName = "Emily", Installations = [new("a", @"D:\Games\27.11", "27.11")], SelectedId = "a" };
+    store.Save(setting);
+    Check(store.Load().SelectedId == "a" && store.Load().Installations[0].Directory == @"D:\Games\27.11", "atomic settings round trip");
+    File.WriteAllText(Path.Combine(store.DirectoryPath, "settings.json"), "{broken");
+    Check(store.Load().Installations.Count == 0 && Directory.GetFiles(store.DirectoryPath, "*.invalid-*").Length == 1, "corrupt settings retained for recovery");
+    Throws(() => LaunchProtocol.RequireMatching(new("a", root, "19.00"), new("b", root, "27.11")), "mixed release blocked");
+    var broken = Path.Combine(root, "broken.dll"); File.WriteAllBytes(broken, [0x4d, 0x5a]);
+    Throws(() => PeImage.RequireX64(broken, true), "truncated PE rejected");
+    var fixtureRoot = Path.GetFullPath(args[0]);
+    var package = Path.Combine(root, "package");
+    Directory.CreateDirectory(Path.Combine(package, "resources", "dlls"));
+    File.WriteAllText(Path.Combine(package, "compatibility-args.json"), JsonSerializer.Serialize(new[] { "-epicapp=Fortnite" }));
+    foreach (var name in new[] { "Auth", "Client", "Server" }) File.Copy(Path.Combine(fixtureRoot, $"Reboot-S19-S30-{name}.dll"), Path.Combine(package, "resources", "dlls", $"Reboot-S19-S30-{name}.dll"));
+    var game = Path.Combine(root, "game folder");
+    var binary = Path.Combine(game, "FortniteGame", "Binaries", "Win64"); Directory.CreateDirectory(binary);
+    var executable = Path.Combine(binary, "FortniteClient-Win64-Shipping.exe");
+    File.Copy(Path.Combine(fixtureRoot, "test-child.exe"), executable);
+    Directory.CreateDirectory(Path.Combine(game, "FortniteGame", "Content", "Paks"));
+    File.WriteAllText(Path.Combine(game, "FortniteGame", "Content", "Paks", "synthetic.pak"), "This is a test marker, not game data.");
+    Check(Releases.Inspect(game).Release == "27.11", "version resource and installation inspection");
+    checks += await FeatureChecks.RunAsync(root, game, executable);
+    checks += await DownloadChecks.RunAsync(root, executable);
+    suspended = NativeWindows.StartSuspendedCompanion(executable);
+    await Task.Delay(150);
+    Check(!suspended.HasExited && !File.Exists(executable + ".started-" + suspended.Id), "companion stays suspended without running its entry point");
+    suspended.Kill(true); await suspended.WaitForExitAsync(); suspended.Dispose(); suspended = null;
+    listener = new TcpListener(IPAddress.Loopback, 3551); listener.Start();
+    var backendTask = Task.Run(async () =>
+    {
+        while (!backendCancellation.IsCancellationRequested)
+        {
+            using var connection = await listener.AcceptTcpClientAsync(backendCancellation.Token);
+            using var stream = connection.GetStream();
+            using var request = new StreamReader(stream, Encoding.ASCII, false, 1024, leaveOpen: true);
+            while (await request.ReadLineAsync(backendCancellation.Token) is { Length: > 0 }) { }
+            var json = "{\"appId\":\"Fortnite\",\"token\":\"synthetic\"}";
+            var response = Encoding.ASCII.GetBytes($"HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: {json.Length}\r\nConnection: close\r\n\r\n{json}");
+            await stream.WriteAsync(response, backendCancellation.Token);
+        }
+    });
+    engine = new LauncherEngine(package, Path.Combine(root, "data"));
+    var states = new ConcurrentQueue<SessionStatus>(); engine.StatusChanged += states.Enqueue;
+    var install = new GameInstall("fixture", game, "27.11");
+    await engine.StartAsync(GameRole.Host, install, setting).WaitAsync(TimeSpan.FromSeconds(25));
+    var host = states.Last(s => s.Role == GameRole.Host);
+    Check(host.Stage == LaunchStage.Listening && host.Pid is int && NativeWindows.OwnsUdpPort(host.Pid.Value, 7777), "host readiness belongs to the launched PID");
+    Check(!NativeWindows.OwnsUdpPort(Environment.ProcessId, 7777), "another process cannot satisfy host readiness");
+    await engine.StartAsync(GameRole.Client, install, setting).WaitAsync(TimeSpan.FromSeconds(25));
+    var client = states.Last(s => s.Role == GameRole.Client);
+    Check(client.Stage == LaunchStage.Active && client.Pid != host.Pid, "staged authentication/login/client module succeeds");
+    var clientStages = states.Where(s => s.Role == GameRole.Client).Select(s => s.Stage).ToList();
+    Check(clientStages.IndexOf(LaunchStage.Authentication) < clientStages.IndexOf(LaunchStage.Login) && clientStages.IndexOf(LaunchStage.Login) < clientStages.IndexOf(LaunchStage.LoadingModule), "module order is preserved");
+    using (var crashed = Process.GetProcessById(client.Pid!.Value)) crashed.Kill(true);
+    await Until(() => states.Any(s => s.Role == GameRole.Client && s.Stage == LaunchStage.Failed && s.Detail.Contains("0x")), "unexpected exit retains exit code");
+    await Until(() => !engine.HasSession(GameRole.Client), "crashed client releases its session");
+    Environment.SetEnvironmentVariable("EMILYFN_TEST_FAIL_AUTH", "1");
+    try
+    {
+        var failed = false;
+        try { await engine.StartAsync(GameRole.Client, install, setting).WaitAsync(TimeSpan.FromSeconds(20)); }
+        catch (InvalidOperationException) { failed = true; }
+        Check(failed, "auth failure stops startup instead of waiting forever");
+    }
+    finally { Environment.SetEnvironmentVariable("EMILYFN_TEST_FAIL_AUTH", null); }
+    await Until(() => !engine.HasSession(GameRole.Client), "failed startup cleans up its process");
+    unrelated = Process.Start(new ProcessStartInfo(executable) { UseShellExecute = false });
+    await engine.StopAllAsync();
+    Check(!engine.HasSession(GameRole.Host) && !engine.HasSession(GameRole.Client), "Stop all clears owned sessions");
+    Check(unrelated is { HasExited: false }, "Stop all leaves unrelated processes running");
+    Check(await engine.Backend.HealthyAsync(CancellationToken.None), "Stop all leaves an existing external backend running");
+    await engine.ExportLogsAsync(Path.Combine(root, "diagnostics.zip"));
+    Check(new FileInfo(Path.Combine(root, "diagnostics.zip")).Length > 0, "diagnostic ZIP is produced");
+    backendCancellation.Cancel(); listener.Stop();
+    try { await backendTask; } catch (OperationCanceledException) { } catch (SocketException) { } catch (ObjectDisposedException) { }
+    if (args.Length > 1)
+    {
+        var backendData = Path.Combine(root, "bundled backend data");
+        Directory.CreateDirectory(backendData);
+        bundled = new BackendManager(Path.GetFullPath(args[1]), backendData, Console.WriteLine);
+        await bundled.EnsureAsync(CancellationToken.None);
+        Check(bundled.Status == "Running · bundled" && await bundled.HealthyAsync(CancellationToken.None), "bundled backend starts from a copied runtime");
+        var marker = Path.Combine(backendData, "backend-candidate1", "Emilyfn-profile-preservation-test.txt");
+        File.WriteAllText(marker, "Keep existing local data");
+        await bundled.EnsureAsync(CancellationToken.None);
+        Check(File.Exists(marker), "reusing the running backend preserves data");
+        await bundled.StopOwnedAsync();
+        Check(!await bundled.HealthyAsync(CancellationToken.None), "owned backend stops with the launcher");
+        await bundled.EnsureAsync(CancellationToken.None);
+        Check(File.Exists(marker) && await bundled.HealthyAsync(CancellationToken.None), "restarting uses the existing backend data");
+        await bundled.StopOwnedAsync();
+    }
+    Console.WriteLine($"{checks} Emilyfn checks passed, including native x64 DLL loading, staged launch, UDP ownership, crash reporting, process cleanup, backend lifecycle, automatic build detection, download installation and Discord IPC. Synthetic game and Discord fixtures only; Fortnite gameplay and live Discord presence are not covered.");
+}
+finally
+{
+    if (engine is not null) await engine.StopAllAsync();
+    if (bundled is not null) await bundled.StopOwnedAsync();
+    foreach (var process in new[] { unrelated, suspended }) if (process is not null) { try { if (!process.HasExited) { process.Kill(true); await process.WaitForExitAsync(); } } catch { } process.Dispose(); }
+    backendCancellation.Cancel(); listener?.Stop();
+    try { Directory.Delete(root, true); } catch { }
+}
