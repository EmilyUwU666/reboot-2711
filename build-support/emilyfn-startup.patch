diff --git a/launcher/Emilyfn.Tests/StartupChecks.cs b/launcher/Emilyfn.Tests/StartupChecks.cs
new file mode 100644
index 0000000..bcb5605
--- /dev/null
+++ b/launcher/Emilyfn.Tests/StartupChecks.cs
@@ -0,0 +1,124 @@
+using Emilyfn.Core;
+using System.Buffers.Binary;
+using System.IO.Compression;
+using System.Net;
+using System.Security.Cryptography;
+using System.Text;
+
+internal static class StartupChecks
+{
+    // A small, non-runnable PE fixture. No Fortnite executable/code is included.
+    private static byte[] ProtectedFixture(bool longDisplacements = false)
+    {
+        var bytes = new byte[0x3400];
+        void U16(int offset, ushort value) => BinaryPrimitives.WriteUInt16LittleEndian(bytes.AsSpan(offset), value);
+        void U32(int offset, uint value) => BinaryPrimitives.WriteUInt32LittleEndian(bytes.AsSpan(offset), value);
+        void U64(int offset, ulong value) => BinaryPrimitives.WriteUInt64LittleEndian(bytes.AsSpan(offset), value);
+        U16(0, 0x5a4d); U32(0x3c, 0x80); U32(0x80, 0x4550);
+        U16(0x84, 0x8664); U16(0x86, 1); U16(0x94, 240); U16(0x96, 0x22);
+        const int optional = 0x98;
+        U16(optional, 0x20b); U64(optional + 24, 0x140000000);
+        U32(optional + 32, 0x1000); U32(optional + 36, 0x200);
+        U32(optional + 56, 0x4000); U32(optional + 60, 0x400); U16(optional + 68, 2);
+        U32(optional + 108, 16); U32(optional + 112 + 9 * 8, 0x1000); U32(optional + 116 + 9 * 8, 40);
+        const int section = optional + 240;
+        Encoding.ASCII.GetBytes(".text").CopyTo(bytes, section);
+        U32(section + 8, 0x3000); U32(section + 12, 0x1000);
+        U32(section + 16, 0x3000); U32(section + 20, 0x400); U32(section + 36, 0x60000020);
+        U64(0x400 + 24, 0x140001040); U64(0x440, 0x140001100);
+        var position = 0x500;
+        var displacement = longDisplacements ? 0x200 : 0x68;
+        foreach (var value in Encoding.ASCII.GetBytes(GameExecutable.EpicLauncherMessage + '\0'))
+        {
+            if (displacement <= 127)
+            { bytes[position++] = 0xc6; bytes[position++] = 0x44; bytes[position++] = 0x24; bytes[position++] = (byte)displacement; }
+            else
+            { bytes[position++] = 0xc6; bytes[position++] = 0x84; bytes[position++] = 0x24; U32(position, (uint)displacement); position += 4; }
+            bytes[position++] = value;
+            displacement++;
+        }
+        return bytes;
+    }
+
+    private sealed class ArchiveHandler(byte[] archive) : HttpMessageHandler
+    {
+        protected override Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken token)
+            => Task.FromResult(new HttpResponseMessage(HttpStatusCode.OK) { Content = new ByteArrayContent(archive) });
+    }
+
+    public static async Task<int> RunAsync(string root, string normalExecutable, string package, LauncherSettings settings)
+    {
+        var checks = 0;
+        void Check(bool value, string message) { if (!value) throw new Exception(message); checks++; }
+        var path = Path.Combine(root, "protected-fixture.exe");
+        bool Detect(byte[] bytes) { File.WriteAllBytes(path, bytes); return GameExecutable.HasEpicLauncherStub(path); }
+        Check(!GameExecutable.HasEpicLauncherStub(normalExecutable), "ordinary x64 executable passes protected-stub inspection");
+        Check(Detect(ProtectedFixture()), "recognizes startup message spanning short and long stack displacements");
+        Check(Detect(ProtectedFixture(true)), "recognizes long stack displacements");
+        foreach (var (offset, value, description) in new[] {
+            (0x98 + 16, 0x1100U, "normal entry point"),
+            (0x98 + 120, 0x1200U, "ordinary imports"),
+            (0x98 + 112 + 9 * 8, 0U, "no TLS"),
+            (0x98 + 116 + 9 * 8, 12U, "truncated TLS directory"),
+            (0x98 + 240 + 36, 0x40000040U, "message only in a non-executable section") })
+        {
+            var bytes = ProtectedFixture(); BinaryPrimitives.WriteUInt32LittleEndian(bytes.AsSpan(offset), value);
+            Check(!Detect(bytes), description + " does not falsely match the protected startup stub");
+        }
+        var differentMessage = ProtectedFixture(); differentMessage[0x504] = (byte)'X';
+        Check(!Detect(differentMessage), "partial message is not sufficient");
+        var wrongDestination = ProtectedFixture(); wrongDestination[0x508]++;
+        Check(!Detect(wrongDestination), "nonconsecutive stack writes are not treated as a message");
+        var noTlsCallback = ProtectedFixture(); Array.Clear(noTlsCallback, 0x440, 8);
+        Check(!Detect(noTlsCallback), "unused code outside a TLS callback is not matched");
+        var invalidCallback = ProtectedFixture(); BinaryPrimitives.WriteUInt64LittleEndian(invalidCallback.AsSpan(0x440), ulong.MaxValue);
+        Check(!Detect(invalidCallback), "out-of-range callback is bounded");
+        Check(!Detect(ProtectedFixture()[..0x580]), "truncated callback code cannot match the full message");
+        var plainText = ProtectedFixture(); Array.Clear(plainText, 0x500, 1000);
+        Encoding.ASCII.GetBytes(GameExecutable.EpicLauncherMessage).CopyTo(plainText, 0x500);
+        Check(!Detect(plainText), "plain diagnostic text alone does not trigger the instruction signature");
+
+        var game = Path.Combine(root, "protected installation");
+        var executable = Path.Combine(game, "FortniteGame", "Binaries", "Win64", "FortniteClient-Win64-Shipping.exe");
+        Directory.CreateDirectory(Path.GetDirectoryName(executable)!);
+        Directory.CreateDirectory(Path.Combine(game, "FortniteGame", "Content", "Paks"));
+        File.WriteAllText(Path.Combine(game, "FortniteGame", "Content", "Paks", "test.pak"), "synthetic");
+        var protectedBytes = ProtectedFixture(); File.WriteAllBytes(executable, protectedBytes);
+        var blocked = false;
+        try { Releases.Inspect(game); }
+        catch (InvalidDataException error) { blocked = error.Message == GameExecutable.UnsupportedMessage; }
+        Check(blocked, "browse/import fails with an actionable protected-executable explanation");
+        var progress = new List<string>();
+        Check(BuildDetector.Scan([game], CancellationToken.None, progress.Add).Builds.Count == 0 && progress.Any(p => p == GameExecutable.UnsupportedMessage), "automatic detection reports why the installation was skipped");
+
+        var states = new List<SessionStatus>();
+        var engine = new LauncherEngine(package, Path.Combine(root, "protected launch diagnostics"));
+        engine.StatusChanged += states.Add;
+        blocked = false;
+        try { await engine.StartAsync(GameRole.Host, new("protected", game, "30.40"), settings); }
+        catch (InvalidDataException error) { blocked = error.Message == GameExecutable.UnsupportedMessage; }
+        finally { await engine.StopAllAsync(); }
+        Check(blocked && states.All(s => s.Pid is null) && !states.Any(s => s.Stage == LaunchStage.Authentication), "saved manual release cannot start a protected image or reach authentication");
+        Check(states.Any(s => s.Stage == LaunchStage.Failed && s.Detail == GameExecutable.UnsupportedMessage), "preflight failure reaches launcher status");
+        Check(SHA256.HashData(File.ReadAllBytes(executable)).SequenceEqual(SHA256.HashData(protectedBytes)), "inspection leaves the executable unchanged");
+        var exported = Path.Combine(root, "protected-diagnostics.zip");
+        await engine.ExportLogsAsync(exported);
+        using (var diagnostics = ZipFile.OpenRead(exported))
+        using (var text = new StreamReader(diagnostics.GetEntry("launcher/Emilyfn.log")!.Open()))
+            Check((await text.ReadToEndAsync()).Contains(GameExecutable.UnsupportedMessage), "exported diagnostics retain the preflight cause");
+
+        using var archive = new MemoryStream();
+        using (var zip = new ZipArchive(archive, ZipArchiveMode.Create, true))
+        {
+            using (var entry = zip.CreateEntry("FortniteGame/Binaries/Win64/FortniteClient-Win64-Shipping.exe").Open()) entry.Write(protectedBytes);
+            using (var entry = zip.CreateEntry("FortniteGame/Content/Paks/test.pak").Open()) entry.WriteByte(1);
+        }
+        var parent = Path.Combine(root, "protected download");
+        using var downloader = new BuildDownloader(new ArchiveHandler(archive.ToArray()));
+        blocked = false;
+        try { await downloader.InstallAsync("https://builds.example/protected.zip", parent, "30.40", "", null, CancellationToken.None); }
+        catch (InvalidDataException error) { blocked = error.Message == GameExecutable.UnsupportedMessage; }
+        Check(blocked && !Directory.EnumerateFileSystemEntries(parent).Any(), "protected downloads are rejected without installing or leaving partial files");
+        return checks;
+    }
+}
