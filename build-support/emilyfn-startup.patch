diff --git a/launcher/Emilyfn.Core/GameExecutable.cs b/launcher/Emilyfn.Core/GameExecutable.cs
new file mode 100644
index 0000000..773ed2a
--- /dev/null
+++ b/launcher/Emilyfn.Core/GameExecutable.cs
@@ -0,0 +1,101 @@
+using System.Buffers.Binary;
+using System.Reflection.PortableExecutable;
+
+namespace Emilyfn.Core;
+
+public static class GameExecutable
+{
+    public const string EpicLauncherMessage = "Please launch the game through the Epic Games launcher.";
+    public const string UnsupportedMessage = "This Fortnite executable contains an Epic-launcher-only startup stub. Emilyfn cannot start this copy. Use a compatible installation of the same Fortnite release; changing the release number or DLL timeout will not make this file compatible.";
+
+    public static void RequireDirectLaunch(string executable)
+    {
+        try
+        {
+            if (HasEpicLauncherStub(executable)) throw new InvalidDataException(UnsupportedMessage);
+        }
+        catch (BadImageFormatException error)
+        {
+            throw new InvalidDataException("The selected game executable has invalid PE headers. Check the installation files.", error);
+        }
+    }
+
+    // Recognize the specific startup stub found in the supplied file. TLS, missing
+    // version metadata, packing, or a zero entry point alone are not proof of it.
+    // This reads bounded file ranges only; it never loads or modifies the executable.
+    public static bool HasEpicLauncherStub(string executable)
+    {
+        using var stream = File.OpenRead(executable);
+        using var image = new PEReader(stream, PEStreamOptions.LeaveOpen);
+        var headers = image.PEHeaders;
+        var pe = headers.PEHeader ?? throw new InvalidDataException("The game executable has no PE optional header.");
+        if (pe.Magic != PEMagic.PE32Plus || pe.AddressOfEntryPoint != 0
+            || pe.ImportTableDirectory.RelativeVirtualAddress != 0
+            || pe.ThreadLocalStorageTableDirectory.RelativeVirtualAddress == 0
+            || pe.ThreadLocalStorageTableDirectory.Size < 40) return false;
+
+        byte[] ReadRva(ulong rva, int count, bool executableSection = false)
+        {
+            foreach (var section in headers.SectionHeaders)
+            {
+                if (section.VirtualAddress < 0 || section.PointerToRawData < 0 || section.SizeOfRawData <= 0) continue;
+                if (executableSection && (section.SectionCharacteristics & SectionCharacteristics.MemExecute) == 0) continue;
+                var start = (ulong)section.VirtualAddress;
+                if (rva < start || rva - start >= (ulong)section.SizeOfRawData) continue;
+                var delta = rva - start;
+                var offset = (long)section.PointerToRawData + (long)delta;
+                if (offset < 0 || offset >= stream.Length) return [];
+                var available = Math.Min((long)section.SizeOfRawData - (long)delta, stream.Length - offset);
+                var bytes = new byte[(int)Math.Min(count, available)];
+                stream.Position = offset;
+                stream.ReadExactly(bytes);
+                return bytes;
+            }
+            return [];
+        }
+
+        var tls = ReadRva((uint)pe.ThreadLocalStorageTableDirectory.RelativeVirtualAddress, 40);
+        if (tls.Length < 40) return false;
+        var callbackTable = BinaryPrimitives.ReadUInt64LittleEndian(tls.AsSpan(24));
+        if (callbackTable < pe.ImageBase) return false;
+        var callbacks = ReadRva(callbackTable - pe.ImageBase, 8 * 16);
+        for (var index = 0; index + 8 <= callbacks.Length; index += 8)
+        {
+            var callback = BinaryPrimitives.ReadUInt64LittleEndian(callbacks.AsSpan(index));
+            if (callback == 0) break;
+            if (callback < pe.ImageBase) continue;
+            if (ContainsStackMessage(ReadRva(callback - pe.ImageBase, 8192, true))) return true;
+        }
+        return false;
+    }
+
+    private static bool ContainsStackMessage(ReadOnlySpan<byte> code)
+    {
+        // The message is built using consecutive mov byte ptr [rsp+disp], imm8
+        // instructions, with short and long stack displacements. Match the entire
+        // NUL-terminated literal and consecutive destinations, not stray text.
+        for (var start = 0; start < code.Length; start++)
+        {
+            var position = start;
+            long previous = -1;
+            for (var character = 0; character <= EpicLauncherMessage.Length; character++)
+            {
+                var remaining = code[position..];
+                int length, displacement;
+                byte value;
+                if (remaining.Length >= 5 && remaining[0] == 0xc6 && remaining[1] == 0x44 && remaining[2] == 0x24)
+                { length = 5; displacement = (sbyte)remaining[3]; value = remaining[4]; }
+                else if (remaining.Length >= 8 && remaining[0] == 0xc6 && remaining[1] == 0x84 && remaining[2] == 0x24)
+                { length = 8; displacement = BinaryPrimitives.ReadInt32LittleEndian(remaining[3..]); value = remaining[7]; }
+                else break;
+                if (displacement < 0 || displacement > 4096 || (character > 0 && displacement != previous + 1)) break;
+                var expected = character < EpicLauncherMessage.Length ? (byte)EpicLauncherMessage[character] : (byte)0;
+                if (value != expected) break;
+                if (character == EpicLauncherMessage.Length) return true;
+                previous = displacement;
+                position += length;
+            }
+        }
+        return false;
+    }
+}
