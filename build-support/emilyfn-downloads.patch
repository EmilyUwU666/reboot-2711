diff --git a/launcher/Emilyfn.Core/BuildDownloader.cs b/launcher/Emilyfn.Core/BuildDownloader.cs
new file mode 100644
index 0000000..ac34d78
--- /dev/null
+++ b/launcher/Emilyfn.Core/BuildDownloader.cs
@@ -0,0 +1,182 @@
+using System.Diagnostics;
+using System.IO.Compression;
+using System.Net;
+using System.Security.Cryptography;
+using System.Text.RegularExpressions;
+
+namespace Emilyfn.Core;
+
+public sealed record DownloadProgress(string Stage, long Bytes, long? Total, double BytesPerSecond = 0)
+{
+    public double Percent => Total is > 0 ? Math.Clamp(100d * Bytes / Total.Value, 0, 100) : 0;
+    public string Label => $"{Stage} · {Bytes / 1048576d:N1} MiB" + (Total is > 0 ? $" / {Total / 1048576d:N1} MiB" : "") + (BytesPerSecond > 0 ? $" · {BytesPerSecond / 1048576d:N1} MiB/s" : "");
+}
+
+/// <summary>Installs a direct HTTPS ZIP into a new directory. Never executes archive content.</summary>
+public sealed class BuildDownloader : IDisposable
+{
+    private const long Limit = 512L * 1024 * 1024 * 1024;
+    private readonly HttpClient http;
+    public BuildDownloader(HttpMessageHandler? handler = null)
+    {
+        http = new HttpClient(handler ?? new HttpClientHandler { AllowAutoRedirect = false }) { Timeout = Timeout.InfiniteTimeSpan };
+        http.DefaultRequestHeaders.UserAgent.ParseAdd("Emilyfn/0.3.0");
+    }
+    public static Uri ValidateUrl(string text)
+    {
+        if (!Uri.TryCreate(text, UriKind.Absolute, out var uri) || uri.Scheme != "https" || string.IsNullOrEmpty(uri.Host) || uri.UserInfo.Length > 0 || uri.Fragment.Length > 0)
+            throw new ArgumentException("Paste a direct HTTPS ZIP download link without a username, password or fragment.");
+        return uri;
+    }
+    public Task<GameInstall> InstallAsync(string url, string parent, string release, string checksum, IProgress<DownloadProgress>? progress, CancellationToken token)
+    {
+        var uri = ValidateUrl(url.Trim());
+        return InstallWithProviderAsync(parent, release, checksum, (zip, ct) => DownloadAsync(uri, zip, progress, ct), progress, token);
+    }
+    public async Task<GameInstall> InstallWithProviderAsync(string parent, string release, string checksum, Func<string, CancellationToken, Task> acquire, IProgress<DownloadProgress>? progress, CancellationToken token)
+    {
+        if (!Releases.Valid(release)) throw new ArgumentException("Enter a release between 19.xx and 30.xx, such as 30.40.");
+        checksum = checksum.Trim();
+        if (checksum.Length > 0 && !Regex.IsMatch(checksum, "^[a-fA-F0-9]{64}$")) throw new ArgumentException("SHA256 must be 64 hexadecimal characters, or leave it empty.");
+        if (string.IsNullOrWhiteSpace(parent) || !Path.IsPathFullyQualified(parent)) throw new ArgumentException("Choose an absolute installation folder.");
+        parent = Path.GetFullPath(parent);
+        Directory.CreateDirectory(parent);
+        var destination = Path.Combine(parent, "Fortnite-" + release);
+        if (Directory.Exists(destination) || File.Exists(destination)) throw new IOException("That build folder already exists. Choose a different installation folder.");
+        var work = Path.Combine(parent, ".emilyfn-download-" + Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(work);
+        try
+        {
+            var zip = Path.Combine(work, "build.zip");
+            await acquire(zip, token);
+            if (new FileInfo(zip).Length is 0 or > Limit) throw new InvalidDataException("The archive is empty or exceeds the 512 GiB limit.");
+            if (checksum.Length > 0)
+            {
+                progress?.Report(new("Verifying SHA256", 0, null));
+                await using var verify = File.OpenRead(zip);
+                var digest = await SHA256.HashDataAsync(verify, token);
+                if (!Convert.ToHexString(digest).Equals(checksum, StringComparison.OrdinalIgnoreCase)) throw new InvalidDataException("SHA256 mismatch. The downloaded archive was discarded.");
+            }
+            var unpacked = Path.Combine(work, "unpacked");
+            await ExtractAsync(zip, unpacked, progress, token);
+            progress?.Report(new("Checking build", 0, null));
+            var executables = Directory.EnumerateFiles(unpacked, "FortniteClient-Win64-Shipping.exe", SearchOption.AllDirectories).Take(2).ToArray();
+            if (executables.Length != 1) throw new InvalidDataException("The ZIP must contain exactly one complete Windows Fortnite build.");
+            var found = Releases.Inspect(executables[0], token);
+            if (found.Release is null) throw new InvalidDataException("The executable's release could not be verified. Use a build with readable Fortnite release metadata.");
+            if (found.Release != release) throw new InvalidDataException($"The ZIP contains Fortnite {found.Release}, not {release}. Nothing was installed.");
+            token.ThrowIfCancellationRequested();
+            Directory.Move(found.Root, destination);
+            progress?.Report(new("Installed", 1, 1));
+            return new(Guid.NewGuid().ToString("N"), destination, found.Release);
+        }
+        catch (HttpRequestException) { throw new IOException("Download failed. Check the direct ZIP link and your connection, then retry."); }
+        finally
+        {
+            for (var attempt = 0; Directory.Exists(work); attempt++)
+            {
+                try { Directory.Delete(work, true); break; }
+                catch (IOException) when (attempt < 9) { await Task.Delay(200); }
+                catch (UnauthorizedAccessException) when (attempt < 9) { await Task.Delay(200); }
+            }
+        }
+    }
+    private async Task DownloadAsync(Uri uri, string file, IProgress<DownloadProgress>? progress, CancellationToken token)
+    {
+        HttpResponseMessage? response = null;
+        try
+        {
+            for (int redirect = 0; redirect <= 5; redirect++)
+            {
+                using var headers = CancellationTokenSource.CreateLinkedTokenSource(token);
+                headers.CancelAfter(TimeSpan.FromSeconds(45));
+                try { response = await http.GetAsync(uri, HttpCompletionOption.ResponseHeadersRead, headers.Token); }
+                catch (OperationCanceledException) when (!token.IsCancellationRequested) { throw new IOException("The download server did not respond in time. Retry the download."); }
+                if ((int)response.StatusCode is >= 300 and < 400)
+                {
+                    var next = response.Headers.Location;
+                    response.Dispose(); response = null;
+                    if (next is null || redirect == 5) throw new IOException("The download link has too many redirects or a missing destination.");
+                    uri = ValidateUrl(new Uri(uri, next).AbsoluteUri);
+                    continue;
+                }
+                break;
+            }
+            response!.EnsureSuccessStatusCode();
+            if (response.StatusCode != HttpStatusCode.OK) throw new IOException("The server did not return a complete download.");
+            if (response.Content.Headers.ContentType?.MediaType?.Contains("html", StringComparison.OrdinalIgnoreCase) == true) throw new IOException("This link opens a webpage. Paste the direct ZIP download link instead.");
+            var total = response.Content.Headers.ContentLength;
+            if (total is > Limit || total is 0) throw new IOException("The download is empty or exceeds the 512 GiB limit.");
+            CheckSpace(file, total ?? 256L * 1024 * 1024);
+            await using var input = await response.Content.ReadAsStreamAsync(token);
+            await using var output = new FileStream(file, FileMode.CreateNew, FileAccess.Write, FileShare.None, 131072, true);
+            var buffer = new byte[131072]; long received = 0; var clock = Stopwatch.StartNew(); long last = -250;
+            progress?.Report(new("Downloading", 0, total));
+            while (true)
+            {
+                using var stall = CancellationTokenSource.CreateLinkedTokenSource(token); stall.CancelAfter(TimeSpan.FromSeconds(90));
+                int count;
+                try { count = await input.ReadAsync(buffer, stall.Token); }
+                catch (OperationCanceledException) when (!token.IsCancellationRequested) { throw new IOException("The download stalled. Check your connection and retry."); }
+                if (count == 0) break;
+                received += count;
+                if (received > Limit || total is not null && received > total) throw new IOException("The download exceeds its expected size.");
+                await output.WriteAsync(buffer.AsMemory(0, count), token);
+                if (clock.ElapsedMilliseconds - last >= 250) { progress?.Report(new("Downloading", received, total, received / Math.Max(.001, clock.Elapsed.TotalSeconds))); last = clock.ElapsedMilliseconds; }
+            }
+            if (total is not null && received != total) throw new IOException("The download was incomplete. Retry the download.");
+        }
+        finally { response?.Dispose(); }
+    }
+    private static void CheckSpace(string path, long needed)
+    {
+        var drive = new DriveInfo(Path.GetPathRoot(Path.GetFullPath(path))!);
+        if (drive.IsReady && drive.AvailableFreeSpace < needed + 256L * 1024 * 1024) throw new IOException("There is not enough free disk space for this build and its temporary files.");
+    }
+    private static async Task ExtractAsync(string zip, string root, IProgress<DownloadProgress>? progress, CancellationToken token)
+    {
+        using var archive = ZipFile.OpenRead(zip);
+        if (archive.Entries.Count is 0 or > 500000) throw new InvalidDataException("The ZIP is empty or contains too many entries.");
+        Directory.CreateDirectory(root);
+        var prefix = Path.GetFullPath(root) + Path.DirectorySeparatorChar;
+        var destinations = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+        var entries = new List<(ZipArchiveEntry Entry, string Path, bool Directory)>();
+        long total = 0;
+        foreach (var entry in archive.Entries)
+        {
+            token.ThrowIfCancellationRequested();
+            var name = entry.FullName.Replace('\\', '/');
+            var parts = name.TrimEnd('/').Split('/');
+            if (name.StartsWith('/') || parts.Any(p => p.Length == 0 || p is "." or ".." || p.EndsWith('.') || p.EndsWith(' ') || p.IndexOfAny([':', '*', '?', '"', '<', '>', '|', '\0']) >= 0 || p.Any(char.IsControl) || Regex.IsMatch(p, @"^(CON|PRN|AUX|NUL|COM[0-9]|LPT[0-9])(\.|$)", RegexOptions.IgnoreCase)))
+                throw new InvalidDataException("The ZIP contains an unsafe file path.");
+            if (((entry.ExternalAttributes >> 16) & 0xF000) is 0xA000 || (entry.ExternalAttributes & (int)FileAttributes.ReparsePoint) != 0) throw new InvalidDataException("Archive links are not supported.");
+            var target = Path.GetFullPath(Path.Combine(root, name.Replace('/', Path.DirectorySeparatorChar)));
+            if (!target.StartsWith(prefix, StringComparison.OrdinalIgnoreCase) || !destinations.Add(target)) throw new InvalidDataException("The ZIP contains duplicate or unsafe paths.");
+            total = checked(total + entry.Length);
+            if (total > Limit) throw new InvalidDataException("Extracted content exceeds the 512 GiB limit.");
+            entries.Add((entry, target, name.EndsWith('/')));
+        }
+        CheckSpace(root, total);
+        long extracted = 0; var clock = Stopwatch.StartNew(); long last = -250;
+        var buffer = new byte[131072];
+        foreach (var item in entries)
+        {
+            token.ThrowIfCancellationRequested();
+            if (item.Directory) { Directory.CreateDirectory(item.Path); continue; }
+            Directory.CreateDirectory(Path.GetDirectoryName(item.Path)!);
+            await using var source = item.Entry.Open();
+            await using var target = new FileStream(item.Path, FileMode.CreateNew, FileAccess.Write, FileShare.None, 131072, true);
+            long entryBytes = 0;
+            int count;
+            while ((count = await source.ReadAsync(buffer, token)) > 0)
+            {
+                entryBytes += count; extracted += count;
+                if (entryBytes > item.Entry.Length || extracted > total) throw new InvalidDataException("Archive content exceeds its declared size.");
+                await target.WriteAsync(buffer.AsMemory(0, count), token);
+                if (clock.ElapsedMilliseconds - last >= 250) { progress?.Report(new("Extracting", extracted, total)); last = clock.ElapsedMilliseconds; }
+            }
+            if (entryBytes != item.Entry.Length) throw new InvalidDataException("The ZIP contains an incomplete file.");
+        }
+    }
+    public void Dispose() => http.Dispose();
+}
diff --git a/launcher/README.md b/launcher/README.md
index 5833f91..a1de3af 100644
--- a/launcher/README.md
+++ b/launcher/README.md
@@ -93,3 +93,60 @@ IPC protocol: https://docs.discord.com/developers/topics/rpc .
 The Windows build tests this protocol with a local synthetic named-pipe server,
 including fragmented frames, PING/PONG, reconnect and presence clearing. A real
 Discord application ID/account is needed to verify the live profile display.
+
+
+## Download and install builds (0.3.0)
+
+In Library, paste a **direct HTTPS ZIP link**, enter the release (for example
+30.40), choose an installation parent folder and select Download and install.
+An optional SHA256 from your source verifies the downloaded archive. The launcher
+follows up to five HTTPS redirects, shows transferred MiB and speed, extracts the
+ZIP and checks the actual Fortnite release before adding it to Library. A ZIP may
+have one enclosing folder, but must contain exactly one complete Windows build.
+No game files or Epic account credentials are bundled.
+
+The install is committed to a new `Fortnite-<release>` folder only after validation.
+Existing folders are never overwritten. Temporary ZIP/extraction files are removed
+on success, cancellation or error. Keep enough disk space for the compressed ZIP
+and extracted game at the same time. There is a 512 GiB download/extraction limit.
+Cancellation and failed transfers restart from the beginning; HTTP resume, RAR,
+7z, split archives and Epic manifest/chunk downloads are not implemented. A browser
+landing page is not a direct ZIP link. Unknown/mismatched releases are rejected.
+
+Only a verified installation is registered; downloaded files are not executed by
+the installer. Installing 30.40 does not add LEGO Fortnite or Festival server support.
+Tests use in-memory HTTP responses and synthetic builds, covering redirects, hash
+mismatches, version mismatch, traversal, links, duplicate paths, cancellation,
+truncated downloads and preserving existing installations. Real multi-gigabyte
+Fortnite downloads remain to be tested with the user's chosen source.
+
+### Public build picker
+
+The embedded catalog includes 13 direct ZIP links for 19.01, 19.10, 20.10, 20.20,
+20.40, 21.00, 21.10, 21.50, 23.40, 23.50, 24.20, 25.11 and 26.30. Select a build,
+choose the destination, then Download and install; the link is filled automatically.
+Source and credit: https://github.com/llamaqwerty/fortnite-builds-archive (read
+2026-09-16). Links belong to third-party hosts and may expire. No checksum was
+published in the source table; optional manual SHA256 verification remains available.
+The direct-link catalog excludes sharing pages, RAR/7z and a mislabeled 19.00 row
+that pointed to 19.01. A download link is not a guarantee of gameplay compatibility
+or file contents.
+
+### FortForge catalog
+
+FortForge build detail links for available PC releases 19.xx–30.xx are also included,
+with changelist numbers to distinguish variants. These links were read from the
+public chapter/season pages at https://www.fortforge.co.uk/builds on 2026-09-16.
+FortForge **does list 30.40**; the other archive's unavailable entry is superseded.
+Select a FortForge entry and Download and install. Emilyfn opens FortForge inside a
+WebView2 window, uses its normal Download Build button and queue, and captures the
+ZIP into the install staging folder. If the automatic button click is too early,
+click Download Build in that window. Closing it cancels the transfer.
+
+Requires Microsoft Edge WebView2 Runtime (separate from the bundled .NET runtime).
+If missing, install it from https://developer.microsoft.com/microsoft-edge/webview2.
+FortForge controls availability, queue timing and file format. No temporary queue
+URLs or tokens are stored in the catalog. RAR/7z downloads are rejected with an
+explanation. Only a completed ZIP that passes installation validation is registered.
+The FortForge UI and its 30.40 queue were observed live; a complete 101 GB game
+transfer and live Windows WebView2 integration have not been validated here.
