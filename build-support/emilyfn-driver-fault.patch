+#include "DriverFault38.h"
+#include <cassert>
+using EmilyfnDriverFault38::Record;
+__declspec(noinline) DWORD Fault(void* memory,Record& record,std::uint64_t image,std::uint32_t size) {
+ __try {volatile auto value=*static_cast<volatile unsigned char*>(memory);(void)value;return 0;}
+ __except(EmilyfnDriverFault38::Capture(record,GetExceptionInformation(),image,size,2)){return GetExceptionCode();}
+}
+int main() {
+ EXCEPTION_RECORD e{};e.ExceptionCode=EXCEPTION_ACCESS_VIOLATION;e.NumberParameters=2;
+ e.ExceptionAddress=reinterpret_cast<void*>(0x100123ULL);e.ExceptionInformation[0]=1;e.ExceptionInformation[1]=0x18;
+ auto r=EmilyfnDriverFault38::Describe(&e,0x100000,0x1000,2);
+ assert(r.stage==2&&r.inImage==1&&r.instructionRva==0x123&&r.access==2&&r.targetKind==1&&r.targetOffset==0x18);
+ e.ExceptionInformation[0]=8;e.ExceptionInformation[1]=0x100fff;
+ r=EmilyfnDriverFault38::Describe(&e,0x100000,0x1000,1);assert(r.access==3&&r.targetKind==2&&r.targetOffset==0xfff);
+ e.ExceptionAddress=reinterpret_cast<void*>(0x101000ULL);e.ExceptionInformation[1]=0xabcdef00;
+ r=EmilyfnDriverFault38::Describe(&e,0x100000,0x1000,2);assert(!r.inImage&&!r.instructionRva&&r.targetKind==3&&!r.targetOffset);
+ e.NumberParameters=1;r=EmilyfnDriverFault38::Describe(&e,0x100000,0x1000,2);assert(!r.access&&!r.targetKind);
+ r=EmilyfnDriverFault38::Describe(nullptr,0x100000,0x1000,2);assert(!r.inImage&&!r.access);
+ const auto base=reinterpret_cast<std::uint64_t>(GetModuleHandleW(nullptr));
+ const auto dos=reinterpret_cast<const IMAGE_DOS_HEADER*>(base);
+ const auto nt=reinterpret_cast<const IMAGE_NT_HEADERS64*>(base+static_cast<std::uint64_t>(dos->e_lfanew));
+ void* memory=VirtualAlloc(nullptr,4096,MEM_COMMIT|MEM_RESERVE,PAGE_NOACCESS);assert(memory);
+ Record real{};const auto code=Fault(memory,real,base,nt->OptionalHeader.SizeOfImage);
+ assert(code==EXCEPTION_ACCESS_VIOLATION&&real.stage==2&&real.inImage==1&&real.instructionRva<nt->OptionalHeader.SizeOfImage);
+ assert(real.access==1&&real.targetKind==3&&real.targetOffset==0);
+ assert(VirtualFree(memory,0,MEM_RELEASE));
+}
