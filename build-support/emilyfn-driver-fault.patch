--- /dev/null
+++ b/launcher/native/ThreadProbe/DriverFault38.h
@@ -0,0 +1,29 @@
+#pragma once
+#include <windows.h>
+#include <cstdint>
+namespace EmilyfnDriverFault38 {
+struct Record {
+ std::uint32_t stage=0,access=0,inImage=0,targetKind=0;
+ std::uint64_t instructionRva=0,targetOffset=0;
+};
+static_assert(sizeof(Record)==32);
+// Only game-relative locations and near-null offsets leave the exception filter.
+// Other memory addresses (including heap/session data) are not exported.
+inline Record Describe(const EXCEPTION_RECORD* e,std::uint64_t image,std::uint32_t size,std::uint32_t stage) {
+ Record r{};r.stage=stage;if(!e)return r;
+ const auto pc=reinterpret_cast<std::uint64_t>(e->ExceptionAddress);
+ if(image&&pc>=image&&pc-image<size){r.inImage=1;r.instructionRva=pc-image;}
+ if((e->ExceptionCode==EXCEPTION_ACCESS_VIOLATION||e->ExceptionCode==EXCEPTION_IN_PAGE_ERROR)&&e->NumberParameters>=2) {
+  switch(e->ExceptionInformation[0]){case 0:r.access=1;break;case 1:r.access=2;break;case 8:r.access=3;break;default:break;}
+  const auto target=static_cast<std::uint64_t>(e->ExceptionInformation[1]);
+  if(target<65536){r.targetKind=1;r.targetOffset=target;}
+  else if(image&&target>=image&&target-image<size){r.targetKind=2;r.targetOffset=target-image;}
+  else r.targetKind=3;
+ }
+ return r;
+}
+inline LONG Capture(Record& out,const EXCEPTION_POINTERS* info,std::uint64_t image,std::uint32_t size,std::uint32_t stage) {
+ out=Describe(info?info->ExceptionRecord:nullptr,image,size,stage);
+ return EXCEPTION_EXECUTE_HANDLER;
+}
+}
