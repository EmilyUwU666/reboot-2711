+int main() {
+    constexpr std::uint64_t image=0x50000,table=0x20000000,chunk=0x22000000,obj=0x7ff4841bca38;
+    std::map<std::uint64_t,std::vector<unsigned char>> memory;
+    auto put=[&](std::uint64_t at,auto value) {auto& b=memory[at];b.resize(sizeof(value));std::memcpy(b.data(),&value,sizeof(value));};
+    auto read=[&](std::uint64_t at,void* out,std::size_t n) {
+        const auto found=memory.find(at);
+        if(found==memory.end() || found->second.size()!=n)return false;
+        std::memcpy(out,found->second.data(),n);return true;
+    };
+    const auto check=[&](bool expected) {if(EmilyfnRegistry38::Member(read,image,obj)!=expected)throw std::runtime_error("Registry membership guard failed");};
+    const auto index=std::uint32_t{65536};
+    put(image+0x16cfaf94,std::uint32_t{65537^0xff3b3ceb});
+    put(image+0x16cfaf80,table^std::uint64_t{0xffffffff40f0f3b4});
+    put(obj+0x14,index^0x753838abU);put(table+8,chunk);
+    put(chunk,(obj>>3)&std::uint64_t{0x3fff00000000});put(chunk+8,static_cast<std::uint32_t>(obj>>3)^0xcc9e16dbU);
+    check(true);
+    put(obj+0x14,std::uint32_t{65537^0x753838ab});check(false);put(obj+0x14,index^0x753838abU);
+    put(chunk+8,static_cast<std::uint32_t>((obj+8)>>3)^0xcc9e16dbU);check(false);
+    put(chunk+8,static_cast<std::uint32_t>(obj>>3)^0xcc9e16dbU);
+    put(table+8,std::uint64_t{0});check(false);put(table+8,chunk);
+    put(image+0x16cfaf94,std::uint32_t{4194305^0xff3b3ceb});check(false);
+    put(image+0x16cfaf94,std::uint32_t{65537^0xff3b3ceb});
+    put(table+8,std::uint64_t{0xffffffffffffffff});check(false);put(table+8,chunk);
+    memory.erase(obj+0x14);check(false);
+    std::cout<<"Native registry checks passed: encoded membership, chunk boundary, stale object, invalid count, null/overflow and unreadable memory.\n";
