+using System.Buffers.Binary;
+static class RegistryFixture
+{
+    // Independent fixture encoding, shared by reflection and target-selection tests.
+    public static byte[] Create(Func<ulong,int,byte[]> alloc,ulong image,ulong chunk,int capacity,uint count)
+    {
+        var a=Convert.FromHexString("8b40144835ab383875b9eb3c3bff330d6d4dcf1639c87d300fb7c848bab4f3f040ffffffff483315414dcf16c1e810488d0c49c1e10348030cc2");
+        var b=Convert.FromHexString("428b44c10841b9db169ecc4931c148b800000000ff3f00004a2304c14c09c80f84fb00000048c1e0034839c2");
+        a.CopyTo(alloc(image+0x6213,a.Length),0);b.CopyTo(alloc(image+0x23eee,b.Length),0);
+        var globals=alloc(image+0x16cfaf80,24);
+        BinaryPrimitives.WriteUInt64LittleEndian(globals,(chunk-0x1000)^0xffffffff40f0f3b4UL);
+        Count(globals,count);
+        var pointers=alloc(chunk-0x1000,16);BinaryPrimitives.WriteUInt64LittleEndian(pointers,chunk);
+        var slots=alloc(chunk,capacity*24);
+        for(int i=0;i<capacity;i++)Set(slots,i,0);
+        return slots;
+    }
+    public static void Count(byte[] globals,uint count)=>BinaryPrimitives.WriteUInt32LittleEndian(globals.AsSpan(20),count^0xff3b3ceb);
+    public static void Set(byte[] slots,int index,ulong address)
+    {
+        BinaryPrimitives.WriteUInt64LittleEndian(slots.AsSpan(index*24),(address>>3)&0x3fff00000000UL);
