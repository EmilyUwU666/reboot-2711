diff --git a/launcher/native/ThreadProbe/Registry38.h b/launcher/native/ThreadProbe/Registry38.h
new file mode 100644
--- /dev/null
+++ b/launcher/native/ThreadProbe/Registry38.h
@@ -0,0 +1,23 @@
+#pragma once
+#include <cstdint>
+#include <cstddef>
+namespace EmilyfnRegistry38 {
+inline constexpr std::uint64_t ChunksRva=0x16cfaf80,CountRva=0x16cfaf94;
+inline constexpr std::uint64_t MaxUser=0x7fffffffffffULL;
+// Every address used below is bounded before read; callback still uses ReadProcessMemory.
+template<class Reader> bool Member(Reader&& read,std::uint64_t image,std::uint64_t object) {
+    if (!image || image>MaxUser-CountRva-4 || !object || object>MaxUser-0x18) return false;
+    std::uint32_t count=0,index=0,low=0;
+    std::uint64_t chunks=0,chunk=0,packed=0;
+    if (!read(image+CountRva,&count,sizeof(count)) || !read(image+ChunksRva,&chunks,sizeof(chunks)) ||
+        !read(object+0x14,&index,sizeof(index))) return false;
+    count^=0xff3b3ceb; index^=0x753838ab; chunks^=0xffffffff40f0f3b4ULL;
+    if (!count || count>4194304 || index>=count || !chunks || chunks>MaxUser-512) return false;
+    if (!read(chunks+static_cast<std::uint64_t>(index>>16)*8,&chunk,sizeof(chunk)) ||
+        !chunk || chunk>MaxUser-65536*24) return false;
+    const auto item=chunk+static_cast<std::uint64_t>(index&65535)*24;
+    if (!read(item,&packed,sizeof(packed)) || !read(item+8,&low,sizeof(low))) return false;
+    const auto decoded=((packed&0x3fff00000000ULL)|(low^0xcc9e16dbU))<<3;
+    return decoded==object;
+}
+}
