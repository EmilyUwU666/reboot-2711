--- /dev/null
+++ b/launcher/Emilyfn.Core/RuntimeObjectRegistry38.cs
@@ -0,0 +1,48 @@
+using System.Buffers.Binary;
+namespace Emilyfn.Core;
+
+// CL47722112: instruction-derived chunk and packed object pointer decoding.
+public static class RuntimeObjectRegistry38
+{
+    public const ulong ChunksRva=0x16cfaf80,CountRva=0x16cfaf94;
+    public const uint CountMask=0xff3b3ceb,IndexMask=0x753838ab;
+    public const ulong ChunksMask=0xffffffff40f0f3b4;
+    public sealed record Entry(uint Index,ulong Address);
+    public sealed record Rejection(uint Index,string Reason);
+    public sealed record Observation(uint Slots,int EmptySlots,List<Entry> Entries,List<Rejection> Rejections);
+    public static ulong DecodeObject(ulong packed,uint low)=>( (packed&0x3fff00000000UL)|(low^0xcc9e16dbu) )<<3;
+    public static byte[] ReadBoundary(Func<ulong,int,byte[]> read,ulong image) =>
+        read(checked(image+ChunksRva),8).Concat(read(checked(image+CountRva),4)).ToArray();
+    public static Observation Inspect(Func<ulong,int,byte[]> read,ulong image)
+    {
+        foreach(var anchor in Anchors)
+            if(!read(checked(image+anchor.Rva),anchor.Bytes.Length).AsSpan().SequenceEqual(anchor.Bytes))
+                throw new InvalidDataException("The image does not match the 38.00 runtime object-registry instructions.");
+        uint count=BinaryPrimitives.ReadUInt32LittleEndian(read(checked(image+CountRva),4))^CountMask;
+        ulong chunks=BinaryPrimitives.ReadUInt64LittleEndian(read(checked(image+ChunksRva),8))^ChunksMask;
+        if(count is 0 or >4194304 || chunks==0 || chunks>long.MaxValue)throw new InvalidDataException("Runtime object registry is uninitialized or outside supported bounds.");
+        var pointers=read(chunks,checked((int)((count+65535)/65536)*8));
+        var entries=new List<Entry>();var rejected=new List<Rejection>();int empty=0;
+        for(uint i=0;i<count;i++)
+        {
+            try
+            {
+                ulong chunk=BinaryPrimitives.ReadUInt64LittleEndian(pointers.AsSpan((int)(i>>16)*8,8));
+                if(chunk==0 || chunk>long.MaxValue)throw new InvalidDataException("Missing registry chunk.");
+                var item=read(checked(chunk+(i&65535)*24UL),24);
+                ulong obj=DecodeObject(BinaryPrimitives.ReadUInt64LittleEndian(item),BinaryPrimitives.ReadUInt32LittleEndian(item.AsSpan(8)));
+                if(obj==0){empty++;continue;}
+                uint index=BinaryPrimitives.ReadUInt32LittleEndian(read(checked(obj+0x14),4))^IndexMask;
+                if(index!=i)throw new InvalidDataException("Object internal index does not match the registry slot.");
+                entries.Add(new(i,obj));
+            }
+            catch(InvalidDataException error){rejected.Add(new(i,error.Message));}
+            catch(OverflowException){rejected.Add(new(i,"Registry address overflow."));}
+        }
+        return new(count,empty,entries,rejected);
+    }
+    private static readonly (ulong Rva,byte[] Bytes)[] Anchors={
+        (0x6213UL,Convert.FromHexString("8b40144835ab383875b9eb3c3bff330d6d4dcf1639c87d300fb7c848bab4f3f040ffffffff483315414dcf16c1e810488d0c49c1e10348030cc2")),
+        (0x23eeeUL,Convert.FromHexString("428b44c10841b9db169ecc4931c148b800000000ff3f00004a2304c14c09c80f84fb00000048c1e0034839c2"))
+    };
+}
