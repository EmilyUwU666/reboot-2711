+using System.Buffers.Binary;
+namespace Emilyfn.Core;
+
+// Read-only validation of the instruction-derived engine context array.
+public static class EngineWorldContexts38
+{
+    public const ulong AnchorRva=0xC5A5990;
+    public static readonly byte[] Anchor=Convert.FromHexString("486389e00f00004885c974244c8b87d80f000048c1e1034531c94b8b0408483990b8020000");
+    public sealed record Entry(int Ordinal,string Status,uint? WorldSlot=null,bool ExactWorldClass=false);
+    public sealed record Report(bool InstructionProfileMatched,uint? EngineSlot,int? Count,int? Capacity,
+        List<Entry> Contexts,string? Failure,bool GameplayReady=false)
+    {public string Scope=>"Read-only cached inspection; array and object reads are not an atomic snapshot. No context or networking function was invoked.";}
+    public static Report Inspect(Func<ulong,int,byte[]> read,ulong image,
+        CaptureReflectionExporter38.Observation reflection,IReadOnlyList<uint> engineSlots)
+    {
+        bool matched=false;uint? engineSlot=null;int? count=null,capacity=null;var contexts=new List<Entry>();
+        uint D(ulong a)=>BinaryPrimitives.ReadUInt32LittleEndian(read(a,4));
+        ulong Q(ulong a)=>BinaryPrimitives.ReadUInt64LittleEndian(read(a,8));
+        try
+        {
+            if(image==0||!read(checked(image+AnchorRva),Anchor.Length).AsSpan().SequenceEqual(Anchor))
+                throw new InvalidDataException("World-context instruction profile mismatch or unavailable.");
+            matched=true;
+            if(engineSlots.Count!=1)throw new InvalidDataException("A unique FortEngine instance is required.");
+            engineSlot=engineSlots[0];
+            var entries=reflection.Registry?.Entries??new();
+            var engines=entries.Where(e=>e.Index==engineSlot.Value).ToList();
+            var classes=reflection.Candidates.Where(c=>c.Kind=="Class"&&c.Name=="/Script/FortniteGame.FortEngine").ToList();
+            if(engines.Count!=1||classes.Count!=1)throw new InvalidDataException("Engine identity unavailable.");
+            ulong engine=engines[0].Address;
+            if((D(checked(engine+0x14))^RuntimeObjectRegistry38.IndexMask)!=engineSlot||
+                Q(checked(engine+0x18))!=classes[0].Address||(D(checked(engine+0x10))&0x10)!=0)
+                throw new InvalidDataException("Engine identity changed or is a class default.");
+            byte[] Before()=>read(checked(engine+0xfd8),16);
+            var before=Before();ulong array=BinaryPrimitives.ReadUInt64LittleEndian(before);
+            count=BinaryPrimitives.ReadInt32LittleEndian(before.AsSpan(8));capacity=BinaryPrimitives.ReadInt32LittleEndian(before.AsSpan(12));
+            if(count<0||count>128||capacity<count||capacity>4096||(count>0&&(array==0||array>long.MaxValue)))
+                throw new InvalidDataException("World-context array bounds are unsupported.");
+            var byPointer=entries.GroupBy(e=>e.Address).Where(g=>g.Count()==1).ToDictionary(g=>g.Key,g=>g.Single());
+            var worlds=reflection.Candidates.Where(c=>c.Kind=="Class"&&c.Name=="/Script/Engine.World").ToList();
+            for(int i=0;i<count;i++)
+            {
+                ulong context=Q(checked(array+(ulong)i*8));
+                if(context==0){contexts.Add(new(i,"Null context"));continue;}
+                if(context>long.MaxValue)throw new InvalidDataException("Invalid context address.");
+                ulong world=Q(checked(context+0x2b8));
+                if(world==0){contexts.Add(new(i,"Null world"));continue;}
+                if(!byPointer.TryGetValue(world,out var item)){contexts.Add(new(i,"World is not registered"));continue;}
+                if((D(checked(world+0x14))^RuntimeObjectRegistry38.IndexMask)!=item.Index)
+                {contexts.Add(new(i,"World identity changed"));continue;}
+                bool exact=worlds.Count==1&&Q(checked(world+0x18))==worlds[0].Address;
+                contexts.Add(new(i,exact?"Registered World":"Registered object; world class unresolved",item.Index,exact));
+            }
+            return new(matched,engineSlot,count,capacity,contexts,null);
+        }
+        catch(Exception e) when(e is InvalidDataException or OverflowException)
+        {return new(matched,engineSlot,count,capacity,contexts,e.Message);}
+    }
+}
