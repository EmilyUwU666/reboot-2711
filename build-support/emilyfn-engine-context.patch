@@ -0,0 +1,28 @@
+using Emilyfn.Core;
+static class EngineWorldContextChecks
+{
+    public static void Run()
+    {
+        ulong image=0x10000000;
+        var values=new Dictionary<ulong,byte[]>();
+        void D(ulong a,uint n)=>values[a]=BitConverter.GetBytes(n);
+        void Q(ulong a,ulong n)=>values[a]=BitConverter.GetBytes(n);
+        byte[] Read(ulong a,int n)=>values.TryGetValue(a,out var b)&&b.Length==n?b:throw new InvalidDataException("Missing fixture memory");
+        values[image+EngineWorldContexts38.AnchorRva]=EngineWorldContexts38.Anchor.ToArray();
+        D(0x2014,1u^RuntimeObjectRegistry38.IndexMask);Q(0x2018,0x1000);D(0x2010,0);
+        values[0x2fd8]=BitConverter.GetBytes(0x4000UL).Concat(BitConverter.GetBytes(1)).Concat(BitConverter.GetBytes(1)).ToArray();
+        Q(0x4000,0x5000);Q(0x52b8,0x3000);D(0x3014,2u^RuntimeObjectRegistry38.IndexMask);Q(0x3018,0x1100);
+        var reflection=new CaptureReflectionExporter38.Observation(new(),new(),new(),0,0,
+            new(){new(0x1000,"/Script/FortniteGame.FortEngine","Class"),new(0x1100,"/Script/Engine.World","Class")})
+            {Registry=new(3,0,new(){new(1,0x2000),new(2,0x3000)},new())};
+        EngineWorldContexts38.Report Run()=>EngineWorldContexts38.Inspect(Read,image,reflection,new uint[]{1});
+        void Check(bool b){if(!b)throw new Exception("Engine world-context check failed");}
+        Check(Run().Failure is null&&Run().Contexts.Single().WorldSlot==2&&!Run().GameplayReady);
+        Q(0x52b8,0);Check(Run().Contexts.Single().Status=="Null world");
+        Q(0x52b8,0x7777);Check(Run().Contexts.Single().Status=="World is not registered");
+        Q(0x52b8,0x3000);D(0x3014,3u^RuntimeObjectRegistry38.IndexMask);Check(Run().Contexts.Single().Status=="World identity changed");
+        values[0x2fd8]=BitConverter.GetBytes(0x4000UL).Concat(BitConverter.GetBytes(129)).Concat(BitConverter.GetBytes(129)).ToArray();Check(Run().Failure is not null);
+        values[image+EngineWorldContexts38.AnchorRva][0]^=1;Check(!Run().InstructionProfileMatched);
+        Console.WriteLine("Engine context checks passed: profile, registry identities, null/unregistered worlds and bounded arrays.");
+    }
+}
