@@ -0,0 +1,48 @@
+using System.Text.RegularExpressions;
+
+namespace Emilyfn.Core;
+
+public static partial class LaunchProtocol
+{
+    [GeneratedRegex(@"^[A-Za-z0-9_-]{1,24}$", RegexOptions.CultureInvariant)] private static partial Regex NameRegex();
+    [GeneratedRegex(@"(?i)(-?AUTH_(?:LOGIN|PASSWORD)|(?:access|refresh|id)_token|authorization|password|caldera|fltoken)([""']?\s*[=:]\s*)(""[^""]*""|[^\s,;]+)")] private static partial Regex SecretsRegex();
+    [GeneratedRegex(@"(?i)bearer\s+[^\s"",;]+|eyJ[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+")]
+    private static partial Regex TokensRegex();
+    public static string Redact(string line) => TokensRegex().Replace(SecretsRegex().Replace(line, "$1$2[redacted]"), "[redacted]");
+    public static bool LoginCompleted(string line) => line.Contains("[UOnlineAccountCommon::ContinueLoggingIn]", StringComparison.Ordinal) && line.Contains("(Completed)", StringComparison.Ordinal);
+    public static bool Fatal(string line) => line.Contains("Fatal error!", StringComparison.OrdinalIgnoreCase) || line.Contains("Unhandled Exception:", StringComparison.OrdinalIgnoreCase);
+    public static string ValidateName(string name) => NameRegex().IsMatch(name) ? name : throw new ArgumentException("Use 1-24 letters, numbers, underscores or hyphens for your local name.");
+    public static IReadOnlyList<string> Arguments(string name, GameRole role, bool headless, string logFile, IReadOnlyList<string> compatibility)
+    {
+        ValidateName(name);
+        var args = new List<string>(compatibility);
+        var account = role == GameRole.Host ? name + "_host" : name;
+        // Local backend profile identifiers; no real Epic account credentials are used.
+        args.Add("-AUTH_LOGIN=" + account + (role == GameRole.Host ? "@host.emilyfn.local" : "@player.emilyfn.local"));
+        args.Add("-AUTH_PASSWORD=EmilyfnLocal");
+        args.Add("-AUTH_TYPE=epic");
+        args.AddRange(["-stdout", "-FullStdOutLogOutput", "-FORCELOGFLUSH", "-abslog=" + logFile]);
+        if (role == GameRole.Host)
+        {
+            args.AddRange(["-nosplash", "-nosound"]);
+            if (headless) args.Add("-nullrhi");
+        }
+        return args;
+    }
+    public static void RequireMatching(GameInstall selected, GameInstall? other)
+    {
+        if (other is not null && (!string.Equals(selected.Release, other.Release, StringComparison.Ordinal) || !string.Equals(Path.GetFullPath(selected.Directory), Path.GetFullPath(other.Directory), StringComparison.OrdinalIgnoreCase)))
+            throw new InvalidOperationException("Stop the other game instance before switching installations. Host and client must use the same build.");
+    }
+}
+public sealed class LogSignals
+{
+    public TaskCompletionSource Login { get; } = new(TaskCreationOptions.RunContinuationsAsynchronously);
+    public TaskCompletionSource FatalError { get; } = new(TaskCreationOptions.RunContinuationsAsynchronously);
+    public string? Error { get; private set; }
+    public void Observe(string line)
+    {
+        if (LaunchProtocol.LoginCompleted(line)) Login.TrySetResult();
+        if (LaunchProtocol.Fatal(line)) { Error = LaunchProtocol.Redact(line); FatalError.TrySetResult(); }
+    }
+}
diff --git a/launcher/Emilyfn.Core/LauncherEngine.cs b/launcher/Emilyfn.Core/LauncherEngine.cs
new file mode 100644
index 0000000..5a6a95c
--- /dev/null
+++ b/launcher/Emilyfn.Core/LauncherEngine.cs
@@ -0,0 +1,265 @@
+using System.Collections.Concurrent;
+using System.Diagnostics;
+using System.IO.Compression;
+using System.Text;
+using System.Text.Json;
+
+namespace Emilyfn.Core;
+
+public sealed class LauncherEngine
+{
+    private sealed class Session(GameRole role, GameInstall install)
+    {
+        public GameRole Role = role;
+        public GameInstall Install = install;
+        public CancellationTokenSource Cancellation = new();
+        public TaskCompletionSource Ready = new(TaskCreationOptions.RunContinuationsAsynchronously);
+        public Task Work = Task.CompletedTask;
+        public Process? Process;
+        public List<Process> Companions = [];
+        public LogSignals Signals = new();
+        public string LogFile = "";
+    }
+    private readonly ConcurrentDictionary<GameRole, Session> sessions = new();
+    private readonly SemaphoreSlim launchGate = new(1, 1);
+    private readonly object logLock = new();
+    private readonly string resources;
+    private readonly string[] compatibility;
+    private int stopGeneration;
+    public string DataRoot { get; }
+    public string LogsRoot => Path.Combine(DataRoot, "logs");
+    public BackendManager Backend { get; }
+    public event Action<SessionStatus>? StatusChanged;
+    public event Action<string>? Logged;
+    public bool HasSession(GameRole role) => sessions.ContainsKey(role);
+    public LauncherEngine(string packageRoot, string dataRoot)
+    {
+        DataRoot = dataRoot;
+        Directory.CreateDirectory(LogsRoot);
+        resources = Path.Combine(packageRoot, "resources");
+        var file = Path.Combine(packageRoot, "compatibility-args.json");
+        compatibility = File.Exists(file) ? JsonSerializer.Deserialize<string[]>(File.ReadAllText(file)) ?? [] : [];
+        Backend = new BackendManager(resources, dataRoot, Log);
+    }
+    public void Log(string message)
+    {
+        var line = $"[{DateTime.Now:HH:mm:ss}] {LaunchProtocol.Redact(message)}";
+        lock (logLock)
+        {
+            try { File.AppendAllText(Path.Combine(LogsRoot, "Emilyfn.log"), line + Environment.NewLine); } catch (IOException) { }
+        }
+        Logged?.Invoke(line);
+    }
+    private void State(Session session, LaunchStage stage, string detail)
+    {
+        if (!sessions.TryGetValue(session.Role, out var current) || !ReferenceEquals(current, session)) return;
+        StatusChanged?.Invoke(new(session.Role, stage, detail, session.Process?.Id));
+        Log($"{session.Role}: {detail}");
+    }
+    public async Task PlayAsync(GameInstall install, LauncherSettings settings)
+    {
+        var generation = Volatile.Read(ref stopGeneration);
+        if (settings.AutoHost) await StartAsync(GameRole.Host, install, settings);
+        if (generation != Volatile.Read(ref stopGeneration)) throw new OperationCanceledException("Launch was stopped.");
+        await StartAsync(GameRole.Client, install, settings);
+    }
+    public async Task StartAsync(GameRole role, GameInstall install, LauncherSettings settings)
+    {
+        if (sessions.TryGetValue(role, out var existing)) { LaunchProtocol.RequireMatching(install, existing.Install); await existing.Ready.Task; return; }
+        LaunchProtocol.ValidateName(settings.DisplayName);
+        if (!Releases.Valid(install.Release)) throw new InvalidOperationException("Choose an installed 19.xx-30.xx build.");
+        foreach (var other in sessions.Values) LaunchProtocol.RequireMatching(install, other.Install);
+        var session = new Session(role, install);
+        if (!sessions.TryAdd(role, session)) throw new InvalidOperationException("That instance is already starting.");
+        State(session, LaunchStage.Checking, "Checking installation");
+        session.Work = RunAsync(session, settings.DisplayName, settings.HeadlessHost);
+        await session.Ready.Task;
+    }
+    private async Task RunAsync(Session session, string displayName, bool headless)
+    {
+        var token = session.Cancellation.Token;
+        Task? tail = null;
+        var gateHeld = false;
+        try
+        {
+            await launchGate.WaitAsync(token); gateHeld = true;
+            foreach (var other in sessions.Values) LaunchProtocol.RequireMatching(session.Install, other.Install);
+            var inspected = Releases.Inspect(session.Install.Directory);
+            if (inspected.Release is not null && inspected.Release != session.Install.Release) throw new InvalidOperationException("The executable metadata differs from the saved release. Remove and add this installation again.");
+            if (compatibility.Length == 0) throw new FileNotFoundException("Compatibility settings are missing. Extract the full Emilyfn package.");
+            var dllRoot = Path.Combine(resources, "dlls");
+            var auth = Path.Combine(dllRoot, "Reboot-S19-S30-Auth.dll");
+            var module = Path.Combine(dllRoot, session.Role == GameRole.Host ? "Reboot-S19-S30-Server.dll" : "Reboot-S19-S30-Client.dll");
+            PeImage.RequireX64(auth, true); PeImage.RequireX64(module, true);
+            State(session, LaunchStage.Checking, "Starting local backend");
+            await Backend.EnsureAsync(token);
+            token.ThrowIfCancellationRequested();
+            var binaryDirectory = Path.GetDirectoryName(session.Install.Executable)!;
+            // Compatibility companions belong to this session and are never resumed.
+            foreach (var companion in new[] { "FortniteLauncher.exe", "FortniteClient-Win64-Shipping_EAC.exe" })
+            {
+                var path = Path.Combine(binaryDirectory, companion);
+                if (File.Exists(path)) session.Companions.Add(NativeWindows.StartSuspendedCompanion(path));
+            }
+            session.LogFile = Path.Combine(LogsRoot, $"{DateTime.UtcNow:yyyyMMdd-HHmmssfff}-{session.Role}-{session.Install.Release}.log");
+            var info = new ProcessStartInfo(session.Install.Executable) { WorkingDirectory = binaryDirectory, UseShellExecute = false, RedirectStandardOutput = true, RedirectStandardError = true, CreateNoWindow = true };
+            foreach (var argument in LaunchProtocol.Arguments(displayName, session.Role, headless, session.LogFile, compatibility)) info.ArgumentList.Add(argument);
+            info.Environment["OPENSSL_ia32cap"] = "~0x20000000";
+            session.Process = new Process { StartInfo = info };
+            session.Process.OutputDataReceived += (_, e) => { if (e.Data is not null) session.Signals.Observe(e.Data); };
+            session.Process.ErrorDataReceived += (_, e) => { if (e.Data is not null) session.Signals.Observe(e.Data); };
+            session.Process.Start();
+            session.Process.BeginOutputReadLine(); session.Process.BeginErrorReadLine();
+            State(session, LaunchStage.Starting, $"Process started · PID {session.Process.Id}");
+            tail = TailAsync(session, token);
+            State(session, LaunchStage.Authentication, "Loading local authentication");
+            await Task.Run(() => NativeWindows.Inject(session.Process, auth, token), token);
+            var authLog = Path.Combine(Path.GetTempPath(), "Reboot-S19-S30-Auth-startup.log");
+            await WaitAsync(session, () =>
+            {
+                var text = ReadLog(authLog);
+                if (!System.Text.RegularExpressions.Regex.IsMatch(text, $@"\bPID={session.Process.Id}(?!\d)")) return false;
+                if (text.Contains("ERROR:", StringComparison.Ordinal)) throw new InvalidOperationException("Authentication initialization failed. See the authentication diagnostic log.");
+                return text.Contains("READY: game and EOS authentication hooks installed", StringComparison.Ordinal);
+            }, TimeSpan.FromSeconds(70), "Authentication did not become ready within 70 seconds.");
+            State(session, LaunchStage.Login, "Signing in to local profile · up to 5 minutes");
+            await WaitAsync(session, () => session.Signals.Login.Task.IsCompletedSuccessfully, TimeSpan.FromMinutes(5), "Login did not complete within five minutes. Open Logs for backend or game errors.");
+            State(session, LaunchStage.LoadingModule, "Login complete · loading game module");
+            var roleName = session.Role == GameRole.Host ? "Server" : "Client";
+            var moduleLog = Path.Combine(Path.GetTempPath(), $"Reboot-S19-S30-{roleName}-startup.log");
+            var previousLength = File.Exists(moduleLog) ? new FileInfo(moduleLog).Length : 0;
+            await Task.Run(() => NativeWindows.Inject(session.Process, module, token), token);
+            await WaitAsync(session, () =>
+            {
+                var text = ReadLog(moduleLog, previousLength);
+                if (!text.Contains($"[PID {session.Process.Id}]", StringComparison.Ordinal)) return false;
+                if (text.Contains("initialization stopped", StringComparison.OrdinalIgnoreCase)) throw new InvalidOperationException("The game module stopped during SDK initialization. Open Logs for the detected build and missing binding.");
+                return text.Contains("SDK initialized", StringComparison.Ordinal);
+            }, TimeSpan.FromMinutes(2), "The game module did not finish SDK initialization within two minutes.");
+            if (session.Role == GameRole.Host)
+            {
+                State(session, LaunchStage.LoadingMap, $"Loading {session.Install.Island} · waiting for host port");
+                await WaitAsync(session, () =>
+                {
+                    var text = ReadLog(moduleLog, previousLength);
+                    if (text.Contains("initialization stopped", StringComparison.OrdinalIgnoreCase)) throw new InvalidOperationException("Host initialization stopped. Open the server diagnostic log.");
+                    return NativeWindows.OwnsUdpPort(session.Process.Id, 7777);
+                }, TimeSpan.FromMinutes(10), "The host did not open port 7777 within ten minutes. The server log contains the last completed stage.");
+                State(session, LaunchStage.Listening, "Listening on 127.0.0.1:7777");
+            }
+            else State(session, LaunchStage.Active, "Client active · ready up in the lobby");
+            session.Ready.TrySetResult();
+            launchGate.Release(); gateHeld = false;
+            await session.Process.WaitForExitAsync(token);
+            var exit = session.Process.ExitCode;
+            State(session, exit == 0 ? LaunchStage.Idle : LaunchStage.Failed, $"Exited · code 0x{unchecked((uint)exit):X8}");
+        }
+        catch (OperationCanceledException)
+        {
+            session.Ready.TrySetCanceled();
+            State(session, LaunchStage.Idle, "Stopped");
+        }
+        catch (Exception error)
+        {
+            session.Ready.TrySetException(error);
+            State(session, LaunchStage.Failed, error.Message);
+        }
+        finally
+        {
+            if (gateHeld) launchGate.Release();
+            session.Cancellation.Cancel();
+            await EndProcessAsync(session.Process);
+            foreach (var companion in session.Companions) await EndProcessAsync(companion);
+            if (tail is not null) { try { await tail; } catch (OperationCanceledException) { } }
+            sessions.TryRemove(new KeyValuePair<GameRole, Session>(session.Role, session));
+        }
+    }
+    private static async Task WaitAsync(Session session, Func<bool> condition, TimeSpan timeout, string failure)
+    {
+        var watch = Stopwatch.StartNew();
+        while (watch.Elapsed < timeout)
+        {
+            session.Cancellation.Token.ThrowIfCancellationRequested();
+            if (session.Process!.HasExited) throw new InvalidOperationException($"Game exited during startup · code 0x{unchecked((uint)session.Process.ExitCode):X8}.");
+            if (session.Signals.FatalError.Task.IsCompleted) throw new InvalidOperationException(session.Signals.Error ?? "The game reported a fatal error.");
+            if (condition()) return;
+            await Task.Delay(250, session.Cancellation.Token);
+        }
+        throw new TimeoutException(failure);
+    }
+    private static async Task TailAsync(Session session, CancellationToken token)
+    {
+        while (!File.Exists(session.LogFile)) await Task.Delay(200, token);
+        try
+        {
+            using var file = new FileStream(session.LogFile, FileMode.Open, FileAccess.Read, FileShare.ReadWrite | FileShare.Delete);
+            using var reader = new StreamReader(file, Encoding.UTF8, true);
+            var pending = new StringBuilder();
+            var buffer = new char[8192];
+            while (!token.IsCancellationRequested)
+            {
+                var count = await reader.ReadAsync(buffer.AsMemory(), token);
+                if (count == 0) { await Task.Delay(150, token); continue; }
+                foreach (var value in buffer.AsSpan(0, count))
+                {
+                    if (value == '\n') { session.Signals.Observe(pending.ToString()); pending.Clear(); }
+                    else if (pending.Length < 65536) pending.Append(value);
+                }
+            }
+        }
+        catch (IOException) { /* stdout remains an independent source of game status. */ }
+    }
+    public static string ReadLog(string file, long offset = 0)
+    {
+        try
+        {
+            using var stream = new FileStream(file, FileMode.Open, FileAccess.Read, FileShare.ReadWrite | FileShare.Delete);
+            stream.Position = Math.Max(0, Math.Max(Math.Min(offset, stream.Length), stream.Length - 262144));
+            using var reader = new StreamReader(stream);
+            return reader.ReadToEnd();
+        }
+        catch (IOException) { return ""; }
+        catch (UnauthorizedAccessException) { return ""; }
+    }
+    private static async Task EndProcessAsync(Process? process)
+    {
+        if (process is null) return;
+        try { if (!process.HasExited) { process.Kill(true); await process.WaitForExitAsync().WaitAsync(TimeSpan.FromSeconds(5)); } }
+        catch (Exception e) when (e is InvalidOperationException or System.ComponentModel.Win32Exception or TimeoutException) { }
+        finally { process.Dispose(); }
+    }
+    public async Task StopAsync(GameRole role)
+    {
+        Interlocked.Increment(ref stopGeneration);
+        if (!sessions.TryGetValue(role, out var session)) return;
+        State(session, LaunchStage.Stopping, "Stopping instance");
+        session.Cancellation.Cancel();
+        await session.Work;
+    }
+    public async Task StopAllAsync()
+    {
+        Interlocked.Increment(ref stopGeneration);
+        foreach (var session in sessions.Values) session.Cancellation.Cancel();
+        await Task.WhenAll(sessions.Values.Select(s => s.Work));
+        await Backend.StopOwnedAsync();
+    }
+    public async Task ExportLogsAsync(string destination)
+    {
+        var files = Directory.EnumerateFiles(LogsRoot, "*.log").Select(f => (File: f, Name: "launcher/" + Path.GetFileName(f))).ToList();
+        foreach (var role in new[] { "Auth", "Client", "Server" })
+        {
+            var path = Path.Combine(Path.GetTempPath(), $"Reboot-S19-S30-{role}-startup.log");
+            if (File.Exists(path)) files.Add((path, "modules/" + Path.GetFileName(path)));
+        }
+        var backendLog = Path.Combine(DataRoot, "backend-candidate1", "backend-startup.log");
+        if (File.Exists(backendLog)) files.Add((backendLog, "backend/backend-startup.log"));
+        using var zip = ZipFile.Open(destination, ZipArchiveMode.Create);
+        foreach (var (file, name) in files)
+        {
+            using var input = new FileStream(file, FileMode.Open, FileAccess.Read, FileShare.ReadWrite | FileShare.Delete);
+            using var reader = new StreamReader(input, Encoding.UTF8, true);
+            using var writer = new StreamWriter(zip.CreateEntry(name, CompressionLevel.Fastest).Open());
+            while (await reader.ReadLineAsync() is { } line) await writer.WriteLineAsync(LaunchProtocol.Redact(line));
+        }
+    }
+}
diff --git a/launcher/Emilyfn.Core/Models.cs b/launcher/Emilyfn.Core/Models.cs
new file mode 100644
index 0000000..96892f6
--- /dev/null
+++ b/launcher/Emilyfn.Core/Models.cs
@@ -0,0 +1,109 @@
+using System.Diagnostics;
+using System.Text.Json;
+using System.Text.RegularExpressions;
+
+namespace Emilyfn.Core;
+
+public enum GameRole { Client, Host }
+public enum LaunchStage { Idle, Checking, Starting, Authentication, Login, LoadingModule, LoadingMap, Active, Listening, Failed, Stopping }
+public sealed record GameInstall(string Id, string Directory, string Release)
+{
+    public string Label => $"Fortnite {Release}";
+    public string Island => Releases.Island(Release);
+    public string Executable => Path.Combine(Directory, "FortniteGame", "Binaries", "Win64", "FortniteClient-Win64-Shipping.exe");
+}
+public sealed record SessionStatus(GameRole Role, LaunchStage Stage, string Detail, int? Pid = null)
+{
+    public bool Running => Pid is not null && Stage is not LaunchStage.Idle;
+}
+public sealed class LauncherSettings
+{
+    public List<GameInstall> Installations { get; set; } = [];
+    public string? SelectedId { get; set; }
+    public string DisplayName { get; set; } = "Emily";
+    public bool AutoHost { get; set; } = true;
+    public bool HeadlessHost { get; set; } = true;
+}
+public static partial class Releases
+{
+    [GeneratedRegex(@"^(19|2\d|30)\.\d{2}$", RegexOptions.CultureInvariant)] private static partial Regex ReleaseRegex();
+    [GeneratedRegex(@"\+{2,3}Fortnite\+Release-(\d{2}\.\d{2})(?=$|[^\d.])", RegexOptions.CultureInvariant)] private static partial Regex BuildRegex();
+    public static bool Valid(string release) => ReleaseRegex().IsMatch(release);
+    public static string? FromMetadata(params string?[] values)
+    {
+        foreach (var value in values)
+        {
+            if (string.IsNullOrWhiteSpace(value)) continue;
+            var match = BuildRegex().Match(value);
+            if (match.Success) return match.Groups[1].Value;
+            if (Regex.IsMatch(value.Trim(), @"^\d{2}\.\d{2}$")) return value.Trim();
+        }
+        return null;
+    }
+    public static string Island(string release)
+    {
+        if (!Valid(release)) return "Choose a build";
+        var season = int.Parse(release[..2], System.Globalization.CultureInfo.InvariantCulture);
+        return season <= 22 ? "Artemis" : season <= 26 ? "Asteria" : season == 27 ? "Athena" : "Helios";
+    }
+    public static (string Root, string? Release) Inspect(string directory)
+    {
+        var root = Path.GetFullPath(directory);
+        var exe = Path.Combine(root, "FortniteGame", "Binaries", "Win64", "FortniteClient-Win64-Shipping.exe");
+        if (!File.Exists(exe)) throw new IOException("Choose the Fortnite folder containing FortniteGame and Engine.");
+        PeImage.RequireX64(exe, false);
+        var paks = Path.Combine(root, "FortniteGame", "Content", "Paks");
+        if (!System.IO.Directory.Exists(paks) || !System.IO.Directory.EnumerateFiles(paks).Any(p => Path.GetExtension(p) is ".pak" or ".utoc"))
+            throw new IOException("The selected installation has no .pak or .utoc game content.");
+        var info = FileVersionInfo.GetVersionInfo(exe);
+        var release = FromMetadata(info.ProductVersion, info.FileVersion);
+        if (release is not null && !Valid(release)) throw new InvalidOperationException($"Fortnite {release} is outside the experimental 19.xx-30.xx range.");
+        return (root, release);
+    }
+}
+public static class PeImage
+{
+    public static void RequireX64(string file, bool dll)
+    {
+        using var stream = File.OpenRead(file);
+        using var reader = new BinaryReader(stream);
+        if (stream.Length < 0x40 || reader.ReadUInt16() != 0x5a4d) throw new InvalidDataException($"Invalid Windows file: {Path.GetFileName(file)}");
+        stream.Position = 0x3c;
+        var pe = reader.ReadInt32();
+        if (pe < 0x40 || (long)pe + 26 > stream.Length) throw new InvalidDataException("Invalid PE header bounds.");
+        stream.Position = pe;
+        if (reader.ReadUInt32() != 0x00004550 || reader.ReadUInt16() != 0x8664) throw new InvalidDataException("A Windows x64 build is required.");
+        stream.Position = pe + 22;
+        var flags = reader.ReadUInt16();
+        if (((flags & 0x2000) != 0) != dll || reader.ReadUInt16() != 0x20b) throw new InvalidDataException("Unexpected executable/DLL architecture.");
+    }
+}
+public sealed class SettingsStore(string directory)
+{
+    public string DirectoryPath { get; } = directory;
+    public LauncherSettings Load()
+    {
+        var file = Path.Combine(DirectoryPath, "settings.json");
+        if (!File.Exists(file)) return new();
+        try
+        {
+            var settings = JsonSerializer.Deserialize<LauncherSettings>(File.ReadAllText(file)) ?? new();
+            settings.Installations ??= [];
+            settings.Installations.RemoveAll(i => !Releases.Valid(i.Release) || string.IsNullOrWhiteSpace(i.Directory));
+            return settings;
+        }
+        catch (JsonException)
+        {
+            File.Copy(file, file + ".invalid-" + DateTime.UtcNow.ToString("yyyyMMddHHmmss"), true);
+            return new();
+        }
+    }
+    public void Save(LauncherSettings settings)
+    {
+        Directory.CreateDirectory(DirectoryPath);
+        var file = Path.Combine(DirectoryPath, "settings.json");
+        var temporary = file + ".tmp";
+        File.WriteAllText(temporary, JsonSerializer.Serialize(settings, new JsonSerializerOptions { WriteIndented = true }));
+        File.Move(temporary, file, true);
+    }
+}
