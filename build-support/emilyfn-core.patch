diff --git a/launcher/Emilyfn.Core/BackendManager.cs b/launcher/Emilyfn.Core/BackendManager.cs
new file mode 100644
index 0000000..153ee6a
--- /dev/null
+++ b/launcher/Emilyfn.Core/BackendManager.cs
@@ -0,0 +1,108 @@
+using System.Diagnostics;
+using System.Net.Sockets;
+using System.Text.Json;
+
+namespace Emilyfn.Core;
+
+public sealed class BackendManager(string resources, string dataRoot, Action<string> log)
+{
+    private readonly SemaphoreSlim gate = new(1, 1);
+    private Process? owned;
+    public string Status { get; private set; } = "Not started";
+    public event Action<string>? Changed;
+    private void Set(string status) { Status = status; Changed?.Invoke(status); log("Backend: " + status); }
+    public async Task<bool> HealthyAsync(CancellationToken cancellation)
+    {
+        try
+        {
+            using var http = new HttpClient { Timeout = TimeSpan.FromSeconds(2) };
+            var json = await http.GetStringAsync("http://127.0.0.1:3551/fortnite/api/discovery/accessToken/Emilyfn", cancellation);
+            using var doc = JsonDocument.Parse(json);
+            return doc.RootElement.TryGetProperty("appId", out var app) && app.GetString() == "Fortnite"
+                && doc.RootElement.TryGetProperty("token", out var token) && !string.IsNullOrWhiteSpace(token.GetString());
+        }
+        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or JsonException) { return false; }
+    }
+    public async Task EnsureAsync(CancellationToken cancellation)
+    {
+        await gate.WaitAsync(cancellation);
+        try
+        {
+            if (await HealthyAsync(cancellation)) { Set(owned is { HasExited: false } ? "Running · bundled" : "Running · existing"); return; }
+            using (var connection = new TcpClient())
+            {
+                try
+                {
+                    await connection.ConnectAsync("127.0.0.1", 3551, cancellation).AsTask().WaitAsync(TimeSpan.FromSeconds(2), cancellation);
+                    throw new InvalidOperationException("Port 3551 is occupied by an incompatible backend. Stop the old backend and try again.");
+                }
+                catch (SocketException) { }
+                catch (TimeoutException) { }
+            }
+            Set("Preparing");
+            var source = Path.Combine(resources, "backend");
+            var destination = Path.Combine(dataRoot, "backend-candidate1");
+            if (!Directory.Exists(destination))
+            {
+                if (!File.Exists(Path.Combine(source, "runtime", "node.exe"))) throw new FileNotFoundException("The bundled backend is missing. Extract the entire Emilyfn ZIP.");
+                var temporary = destination + ".staging-" + Guid.NewGuid().ToString("N");
+                try
+                {
+                    await Task.Run(() =>
+                    {
+                        foreach (var file in Directory.EnumerateFiles(source, "*", SearchOption.AllDirectories))
+                        {
+                            cancellation.ThrowIfCancellationRequested();
+                            var target = Path.Combine(temporary, Path.GetRelativePath(source, file));
+                            Directory.CreateDirectory(Path.GetDirectoryName(target)!);
+                            File.Copy(file, target);
+                        }
+                    }, cancellation);
+                    Directory.Move(temporary, destination);
+                }
+                finally { if (Directory.Exists(temporary)) Directory.Delete(temporary, true); }
+            }
+            var node = Path.Combine(destination, "runtime", "node.exe");
+            PeImage.RequireX64(node, false);
+            var info = new ProcessStartInfo(node) { WorkingDirectory = destination, UseShellExecute = false, RedirectStandardOutput = true, RedirectStandardError = true, CreateNoWindow = true };
+            info.ArgumentList.Add("start-backend.cjs");
+            var process = new Process { StartInfo = info, EnableRaisingEvents = true };
+            process.OutputDataReceived += (_, e) => { if (e.Data is { Length: > 0 }) log("Backend: " + LaunchProtocol.Redact(e.Data)); };
+            process.ErrorDataReceived += (_, e) => { if (e.Data is { Length: > 0 }) log("Backend: " + LaunchProtocol.Redact(e.Data)); };
+            process.Exited += (_, _) =>
+            {
+                try { Set($"Stopped · exit 0x{unchecked((uint)process.ExitCode):X8}"); }
+                catch (InvalidOperationException) { }
+            };
+            process.Start(); owned = process;
+            process.BeginOutputReadLine(); process.BeginErrorReadLine();
+            Set("Starting");
+            var deadline = Stopwatch.StartNew();
+            while (deadline.Elapsed < TimeSpan.FromSeconds(20))
+            {
+                cancellation.ThrowIfCancellationRequested();
+                if (process.HasExited) throw new InvalidOperationException($"Backend exited with code {process.ExitCode}. Open Logs for the port or startup error.");
+                if (await HealthyAsync(cancellation)) { Set("Running · bundled"); return; }
+                await Task.Delay(250, cancellation);
+            }
+            throw new TimeoutException("The bundled backend did not respond within 20 seconds. Open Logs for details.");
+        }
+        catch
+        {
+            if (owned is { HasExited: false }) owned.Kill(true);
+            Set("Needs attention");
+            throw;
+        }
+        finally { gate.Release(); }
+    }
+    public async Task StopOwnedAsync()
+    {
+        await gate.WaitAsync();
+        try
+        {
+            if (owned is { HasExited: false }) { owned.Kill(true); await owned.WaitForExitAsync(); }
+            owned?.Dispose(); owned = null;
+        }
+        finally { gate.Release(); }
+    }
+}
