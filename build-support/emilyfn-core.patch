new file mode 100644
index 0000000..f83e31e
--- /dev/null
+++ b/launcher/Emilyfn.Core/NativeWindows.cs
@@ -0,0 +1,130 @@
+using System.ComponentModel;
+using System.Diagnostics;
+using System.Runtime.InteropServices;
+using System.Text;
+
+namespace Emilyfn.Core;
+
+public static class NativeWindows
+{
+    public static Process StartSuspendedCompanion(string executable)
+    {
+        PeImage.RequireX64(executable, false);
+        var startup = new StartupInfo { cb = Marshal.SizeOf<StartupInfo>() };
+        if (!CreateProcessW(executable, new StringBuilder('"' + executable + '"'), IntPtr.Zero, IntPtr.Zero, false,
+            0x00000004 | 0x08000000, IntPtr.Zero, Path.GetDirectoryName(executable), ref startup, out var information))
+            throw Error("Could not create a launcher companion");
+        try { return Process.GetProcessById(information.dwProcessId); }
+        finally { CloseHandle(information.hThread); CloseHandle(information.hProcess); }
+    }
+
+    public static void Inject(Process process, string dll, CancellationToken cancellation, int timeoutMilliseconds = 20000)
+    {
+        if (!OperatingSystem.IsWindows() || !Environment.Is64BitProcess) throw new PlatformNotSupportedException("Emilyfn requires Windows x64.");
+        dll = Path.GetFullPath(dll);
+        PeImage.RequireX64(dll, true);
+        if (process.HasExited) throw new InvalidOperationException("The game exited before its module could load.");
+        var handle = OpenProcess(0x043a, false, process.Id);
+        if (handle == IntPtr.Zero) throw Error("Cannot open the game process");
+        IntPtr remoteMemory = IntPtr.Zero, thread = IntPtr.Zero;
+        var completed = false;
+        try
+        {
+            var localLoadLibrary = GetProcAddress(GetModuleHandleW("kernel32.dll"), "LoadLibraryW");
+            if (localLoadLibrary == IntPtr.Zero || !GetModuleHandleExW(0x6, localLoadLibrary, out var localOwner)) throw Error("Cannot locate the Windows module loader");
+            var ownerPath = new StringBuilder(1024);
+            if (GetModuleFileNameW(localOwner, ownerPath, ownerPath.Capacity) == 0) throw Error("Cannot identify the Windows module loader");
+            var ownerName = Path.GetFileName(ownerPath.ToString());
+            var clock = Stopwatch.StartNew();
+            ProcessModule? remoteOwner = null;
+            while (clock.ElapsedMilliseconds < timeoutMilliseconds)
+            {
+                cancellation.ThrowIfCancellationRequested();
+                process.Refresh();
+                if (process.HasExited) throw new InvalidOperationException("The game exited while loading Windows modules.");
+                try { remoteOwner = process.Modules.Cast<ProcessModule>().FirstOrDefault(m => string.Equals(m.ModuleName, ownerName, StringComparison.OrdinalIgnoreCase)); }
+                catch (Win32Exception) { }
+                if (remoteOwner is not null) break;
+                Thread.Sleep(50);
+            }
+            if (remoteOwner is null) throw new TimeoutException("The game's Windows module loader did not become available.");
+            // Resolve the function relative to its actual owning DLL, including forwarded exports.
+            var offset = localLoadLibrary.ToInt64() - localOwner.ToInt64();
+            if (offset < 0 || offset >= remoteOwner.ModuleMemorySize) throw new InvalidOperationException("Unexpected Windows loader address.");
+            var remoteLoader = new IntPtr(remoteOwner.BaseAddress.ToInt64() + offset);
+            var bytes = Encoding.Unicode.GetBytes(dll + '\0');
+            remoteMemory = VirtualAllocEx(handle, IntPtr.Zero, (nuint)bytes.Length, 0x3000, 0x04);
+            if (remoteMemory == IntPtr.Zero) throw Error("Cannot allocate the module path");
+            if (!WriteProcessMemory(handle, remoteMemory, bytes, (nuint)bytes.Length, out var written) || written != (nuint)bytes.Length) throw Error("Cannot write the module path");
+            thread = CreateRemoteThread(handle, IntPtr.Zero, 0, remoteLoader, remoteMemory, 0, out _);
+            if (thread == IntPtr.Zero) throw Error("Cannot start the game's module loader");
+            while (clock.ElapsedMilliseconds < timeoutMilliseconds)
+            {
+                cancellation.ThrowIfCancellationRequested();
+                var status = WaitForSingleObject(thread, 50);
+                if (status == 0) { completed = true; break; }
+                if (status != 258) throw Error("The module loader wait failed");
+            }
+            if (!completed) throw new TimeoutException("The game's module loader timed out. Close this instance before retrying.");
+            process.Refresh();
+            if (process.HasExited) throw new InvalidOperationException("The game exited while loading its module.");
+            // Thread exit codes are 32-bit; confirm the full module path instead of truncating HMODULE.
+            var found = process.Modules.Cast<ProcessModule>().Any(m => string.Equals(Path.GetFullPath(m.FileName), dll, StringComparison.OrdinalIgnoreCase));
+            if (!found) throw new InvalidOperationException($"Windows could not load {Path.GetFileName(dll)}. Check that the full package was extracted.");
+        }
+        finally
+        {
+            if (thread != IntPtr.Zero) CloseHandle(thread);
+            // Do not free a path still in use by a loader thread on cancellation/timeout.
+            if (completed && remoteMemory != IntPtr.Zero) VirtualFreeEx(handle, remoteMemory, 0, 0x8000);
+            CloseHandle(handle);
+        }
+    }
+
+    public static bool OwnsUdpPort(int pid, int port)
+    {
+        var size = 0;
+        var result = GetExtendedUdpTable(IntPtr.Zero, ref size, true, 2, 1, 0);
+        if (result != 0 && result != 122) throw new Win32Exception((int)result);
+        if (size < 4 || size > 16 * 1024 * 1024) return false;
+        var buffer = Marshal.AllocHGlobal(size);
+        try
+        {
+            result = GetExtendedUdpTable(buffer, ref size, true, 2, 1, 0);
+            if (result != 0) return false;
+            var count = Marshal.ReadInt32(buffer);
+            if (count < 0 || 4L + count * 12L > size) return false;
+            for (var index = 0; index < count; index++)
+            {
+                var row = IntPtr.Add(buffer, 4 + index * 12);
+                var networkPort = (ushort)Marshal.ReadInt32(row, 4);
+                var localPort = (ushort)((networkPort >> 8) | (networkPort << 8));
+                if (localPort == port && Marshal.ReadInt32(row, 8) == pid) return true;
+            }
+            return false;
+        }
+        finally { Marshal.FreeHGlobal(buffer); }
+    }
+
+    private static Win32Exception Error(string message) => new(Marshal.GetLastWin32Error(), message);
+    [StructLayout(LayoutKind.Sequential, CharSet = CharSet.Unicode)] private struct StartupInfo
+    {
+        public int cb; public string? reserved, desktop, title;
+        public int x, y, xSize, ySize, xCountChars, yCountChars, fillAttribute, flags;
+        public short showWindow, reserved2; public IntPtr reservedPointer, stdInput, stdOutput, stdError;
+    }
+    [StructLayout(LayoutKind.Sequential)] private struct ProcessInformation { public IntPtr hProcess, hThread; public int dwProcessId, dwThreadId; }
+    [DllImport("kernel32.dll", SetLastError = true, CharSet = CharSet.Unicode)] [return: MarshalAs(UnmanagedType.Bool)] private static extern bool CreateProcessW(string application, StringBuilder command, IntPtr processAttributes, IntPtr threadAttributes, bool inherit, uint flags, IntPtr environment, string? directory, ref StartupInfo startup, out ProcessInformation information);
+    [DllImport("kernel32.dll", SetLastError = true)] private static extern IntPtr OpenProcess(uint access, bool inherit, int pid);
+    [DllImport("kernel32.dll", SetLastError = true)] private static extern IntPtr VirtualAllocEx(IntPtr process, IntPtr address, nuint size, uint allocation, uint protection);
+    [DllImport("kernel32.dll", SetLastError = true)] [return: MarshalAs(UnmanagedType.Bool)] private static extern bool VirtualFreeEx(IntPtr process, IntPtr address, nuint size, uint type);
+    [DllImport("kernel32.dll", SetLastError = true)] [return: MarshalAs(UnmanagedType.Bool)] private static extern bool WriteProcessMemory(IntPtr process, IntPtr address, byte[] buffer, nuint size, out nuint written);
+    [DllImport("kernel32.dll", SetLastError = true)] private static extern IntPtr CreateRemoteThread(IntPtr process, IntPtr attributes, nuint stackSize, IntPtr start, IntPtr argument, uint flags, out uint id);
+    [DllImport("kernel32.dll", SetLastError = true)] private static extern uint WaitForSingleObject(IntPtr handle, uint milliseconds);
+    [DllImport("kernel32.dll", SetLastError = true)] [return: MarshalAs(UnmanagedType.Bool)] private static extern bool CloseHandle(IntPtr handle);
+    [DllImport("kernel32.dll", CharSet = CharSet.Unicode)] private static extern IntPtr GetModuleHandleW(string name);
+    [DllImport("kernel32.dll", CharSet = CharSet.Ansi, ExactSpelling = true)] private static extern IntPtr GetProcAddress(IntPtr module, string name);
+    [DllImport("kernel32.dll", SetLastError = true)] [return: MarshalAs(UnmanagedType.Bool)] private static extern bool GetModuleHandleExW(uint flags, IntPtr address, out IntPtr module);
+    [DllImport("kernel32.dll", CharSet = CharSet.Unicode, SetLastError = true)] private static extern uint GetModuleFileNameW(IntPtr module, StringBuilder path, int size);
+    [DllImport("iphlpapi.dll", SetLastError = true)] private static extern uint GetExtendedUdpTable(IntPtr table, ref int size, bool order, uint family, uint tableClass, uint reserved);
+}
