new file mode 100644
--- /dev/null
+++ b/launcher/Emilyfn.Core/BoundedReadCache.cs
@@ -0,0 +1,67 @@
+namespace Emilyfn.Core;
+
+/// <summary>Bounded LRU cache for read-only live inspection. Not an atomic snapshot.</summary>
+public sealed class BoundedReadCache
+{
+    public const int PageSize = 4096;
+    public record Statistics(int CapacityPages, int ResidentPages, int PeakPages,
+        long Hits, long Misses, long Evictions, int Clears);
+    private readonly Func<ulong, int, byte[]> read;
+    private readonly int capacity;
+    private readonly Dictionary<ulong, LinkedListNode<(ulong Address, byte[] Bytes)>> pages = new();
+    private readonly LinkedList<(ulong Address, byte[] Bytes)> lru = new();
+    private long hits, misses, evictions;
+    private int peak, clears;
+
+    public BoundedReadCache(Func<ulong, int, byte[]> read, int capacityPages = 65536)
+    {
+        ArgumentNullException.ThrowIfNull(read);
+        if (capacityPages < 1 || capacityPages > 65536) throw new ArgumentOutOfRangeException(nameof(capacityPages));
+        this.read = read;
+        capacity = capacityPages;
+    }
+
+    public Statistics Snapshot() => new(capacity, pages.Count, peak, hits, misses, evictions, clears);
+
+    public void Clear()
+    {
+        pages.Clear(); lru.Clear(); clears++;
+    }
+
+    public byte[] Read(ulong address, int length)
+    {
+        if (length < 0 || length > 131072 || address > long.MaxValue ||
+            (ulong)length > (ulong)long.MaxValue - address)
+            throw new InvalidDataException("Invalid cached read bounds.");
+        var result = new byte[length];
+        int offset = 0;
+        while (offset < length)
+        {
+            ulong page = address & ~4095UL;
+            int within = (int)(address - page), take = Math.Min(length - offset, PageSize - within);
+            if (pages.TryGetValue(page, out var node))
+            {
+                hits++;
+                lru.Remove(node); lru.AddLast(node);
+            }
+            else
+            {
+                misses++;
+                // Evict before reading so even a failed read cannot exceed the payload budget.
+                if (pages.Count == capacity)
+                {
+                    var oldest = lru.First!;
+                    pages.Remove(oldest.Value.Address); lru.RemoveFirst(); evictions++;
+                }
+                var bytes = read(page, PageSize);
+                if (bytes is null || bytes.Length != PageSize)
+                    throw new InvalidDataException("Required memory page was not read completely.");
+                node = lru.AddLast((page, bytes)); pages.Add(page, node);
+                peak = Math.Max(peak, pages.Count);
+            }
+            node.Value.Bytes.AsSpan(within, take).CopyTo(result.AsSpan(offset));
+            address += (ulong)take; offset += take;
+        }
+        return result;
+    }
+}
