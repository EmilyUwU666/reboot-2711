diff --git a/launcher/Emilyfn.SdkTests/BoundedReadCacheChecks.cs b/launcher/Emilyfn.SdkTests/BoundedReadCacheChecks.cs
new file mode 100644
--- /dev/null
+++ b/launcher/Emilyfn.SdkTests/BoundedReadCacheChecks.cs
@@ -0,0 +1,47 @@
+using Emilyfn.Core;
+
+static class BoundedReadCacheChecks
+{
+    public static void Run()
+    {
+        void Check(bool ok, string message) { if (!ok) throw new Exception(message); }
+        int calls = 0; byte generation = 1;
+        var cache = new BoundedReadCache((address, length) =>
+        {
+            calls++;
+            Check(address % 4096 == 0 && length == 4096, "Unaligned raw read");
+            return Enumerable.Repeat(generation, length).ToArray();
+        }, 2);
+        Check(cache.Read(4095, 2).SequenceEqual(new byte[] {1, 1}) && calls == 2, "Cross-page read");
+        cache.Read(0, 1); // Page zero is most recently used.
+        generation = 2;
+        cache.Read(8192, 1); // Evicts page one.
+        Check(cache.Read(0, 1)[0] == 1 && calls == 3, "LRU hit should retain page zero");
+        Check(cache.Read(4096, 1)[0] == 2 && calls == 4, "Evicted page must be read again");
+        for (ulong i = 3; i < 1000; i++) cache.Read(i * 4096, 1);
+        var stats = cache.Snapshot();
+        Check(stats.ResidentPages == 2 && stats.PeakPages == 2 && stats.Evictions > 990, "Cache must stay bounded and keep scanning");
+        cache.Clear(); generation = 3;
+        Check(cache.Snapshot().ResidentPages == 0 && cache.Read(4096, 1)[0] == 3, "Retry must discard cached pages");
+        int attempts = 0;
+        var shortRead = new BoundedReadCache((_, n) => ++attempts == 1 ? new byte[n - 1] : new byte[n], 1);
+        bool rejected = false;
+        try { shortRead.Read(0, 1); } catch (InvalidDataException) { rejected = true; }
+        Check(rejected && shortRead.Snapshot().ResidentPages == 0, "Partial page cached");
+        shortRead.Read(0, 1); Check(attempts == 2, "Partial page not retried");
+        attempts = 0;
+        var failed = new BoundedReadCache((_, n) => ++attempts == 1 ? throw new TimeoutException() : new byte[n], 1);
+        rejected = false;
+        try { failed.Read(0, 1); } catch (TimeoutException) { rejected = true; }
+        Check(rejected && failed.Snapshot().ResidentPages == 0, "Infrastructure failure swallowed or cached");
+        failed.Read(0, 1); Check(attempts == 2, "Failed page not retried");
+        foreach (var (address, size) in new (ulong, int)[] {(0, -1), (0, 131073), (ulong.MaxValue, 1), ((ulong)long.MaxValue, 2)})
+        {
+            rejected = false;
+            try { cache.Read(address, size); } catch (InvalidDataException) { rejected = true; }
+            Check(rejected, "Invalid bounds accepted");
+        }
+        Check(cache.Read(0, 0).Length == 0, "Empty read");
+        Console.WriteLine("Bounded read cache checks passed: LRU eviction, continued scans, retry clearing, cross-page reads, failures and bounds.");
+    }
+}
