diff --git a/launcher/Emilyfn.Core/WorldReadiness38.cs b/launcher/Emilyfn.Core/WorldReadiness38.cs
new file mode 100644
--- /dev/null
+++ b/launcher/Emilyfn.Core/WorldReadiness38.cs
@@ -0,0 +1,51 @@
+using System.Buffers.Binary;
+namespace Emilyfn.Core;
+
+// Inventory only. Does not traverse unverified superclass layouts or invoke game code.
+public static class WorldReadiness38
+{
+    public sealed record ClassInventory(string ClassName,int ClassMatches,int ExactInstances,
+        int DefaultObjects,List<uint> InstanceSlots,int OmittedInstances,
+        List<CaptureReflectionExporter38.Property> DeclaredProperties,
+        List<CaptureFunctionMetadata38.Function> DeclaredFunctions,int OmittedFunctions);
+    public sealed record Report(bool GameplayReady,string Scope,int UnreadableHeaders,List<ClassInventory> Classes);
+    private static readonly string[] Targets = {
+        "/Script/Engine.World", "/Script/Engine.GameInstance", "/Script/FortniteGame.FortGameInstance",
+        "/Script/Engine.Engine", "/Script/FortniteGame.FortEngine",
+        "/Script/Engine.NetDriver", "/Script/OnlineSubsystemUtils.IpNetDriver",
+        "/Script/FortniteGame.FortGameModeAthena", "/Script/FortniteGame.FortGameStateAthena"
+    };
+    private static readonly HashSet<string> Fields = new(StringComparer.Ordinal) {
+        "PersistentLevel", "OwningGameInstance", "AuthorityGameMode", "GameState", "NetDriver",
+        "GameViewport", "LocalPlayers", "World", "ServerConnection", "ClientConnections"
+    };
+    public static Report Inspect(Func<ulong,int,byte[]> read,CaptureReflectionExporter38.Observation reflection,
+        CaptureFunctionMetadata38.Observation metadata)
+    {
+        var classes=Targets.ToDictionary(n=>n,n=>reflection.Candidates.Where(c=>c.Kind=="Class"&&c.Name==n).ToList());
+        var byAddress=classes.Where(c=>c.Value.Count==1).ToDictionary(c=>c.Value[0].Address,c=>c.Key);
+        var instances=Targets.ToDictionary(n=>n,_=>new List<uint>());
+        var defaults=Targets.ToDictionary(n=>n,_=>0); int unreadable=0;
+        foreach(var entry in reflection.Registry?.Entries ?? new List<RuntimeObjectRegistry38.Entry>())
+        {
+            try
+            {
+                ulong klass=BinaryPrimitives.ReadUInt64LittleEndian(read(checked(entry.Address+0x18),8));
+                if(!byAddress.TryGetValue(klass,out var name))continue;
+                uint flags=BinaryPrimitives.ReadUInt32LittleEndian(read(checked(entry.Address+0x10),4));
+                if((flags&0x10)!=0)defaults[name]++;
+                else instances[name].Add(entry.Index);
+            }
+            catch(Exception e) when(e is InvalidDataException or OverflowException){unreadable++;}
+        }
+        var result=new List<ClassInventory>();
+        foreach(var name in Targets)
+        {
+            var functions=metadata.Functions.Where(f=>f.Owner.StartsWith(name+".",StringComparison.Ordinal)).ToList();
+            result.Add(new(name,classes[name].Count,instances[name].Count,defaults[name],instances[name].Take(16).ToList(),
+                Math.Max(0,instances[name].Count-16),reflection.Properties.Where(p=>p.Owner==name&&Fields.Contains(p.Name)).ToList(),
+                functions.Take(48).ToList(),Math.Max(0,functions.Count-48)));
+        }
+        return new(false,"Read-only exact-class inventory; derived classes are not counted. Instances may be inactive or pending destruction. Presence does not prove a playable world, active net driver or server readiness. No object pointers are exported and no world functions are called.",unreadable,result);
+    }
+}
