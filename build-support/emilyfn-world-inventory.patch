@@ -0,0 +1,24 @@
+using Emilyfn.Core;
+static class WorldReadinessChecks
+{
+    public static void Run()
+    {
+        const string name="/Script/Engine.World";
+        var reflection=new CaptureReflectionExporter38.Observation(new(),new(){new(name,"PersistentLevel","ObjectProperty",0x80,8,1)},new(),0,0,
+            new(){new(0x1000,name,"Class")}) { Registry=new(21,0,Enumerable.Range(0,21).Select(i=>new RuntimeObjectRegistry38.Entry((uint)i,0x2000UL+(ulong)i*0x100)).ToList(),new()) };
+        byte[] Read(ulong a,int n) {
+            if(n==8)return BitConverter.GetBytes(0x1000UL);
+            return BitConverter.GetBytes(a==0x2010?0x10u:0u);
+        }
+        var result=WorldReadiness38.Inspect(Read,reflection,new(new(),new(),new()));
+        var world=result.Classes.Single(c=>c.ClassName==name);
+        if(result.GameplayReady||world.ExactInstances!=20||world.DefaultObjects!=1||world.InstanceSlots.Count!=16||world.OmittedInstances!=4||world.DeclaredProperties.Count!=1)
+            throw new Exception("World inventory counts/default exclusion/bounds differ");
+        var ambiguous=reflection with { Candidates=new(){new(0x1000,name,"Class"),new(0x1100,name,"Class")} };
+        if(WorldReadiness38.Inspect(Read,ambiguous,new(new(),new(),new())).Classes.Single(c=>c.ClassName==name).ExactInstances!=0)
+            throw new Exception("Ambiguous world class selected");
+        var failed=WorldReadiness38.Inspect((a,n)=>throw new InvalidDataException(),reflection,new(new(),new(),new()));
+        if(failed.UnreadableHeaders!=21)throw new Exception("Unreadable world headers hidden");
+        Console.WriteLine("World inventory checks passed: exact classes, ambiguity, default exclusion, report bounds and read failures.");
+    }
+}
