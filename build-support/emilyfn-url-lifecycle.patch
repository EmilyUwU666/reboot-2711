+++ b/launcher/native/ThreadProbe/UrlLifecycleTests.cpp
@@ -0,0 +1,17 @@
+#include "UrlLifecycle38.h"
+#include <stdexcept>
+#include <iostream>
+int main() {
+    auto check=[](bool value){if(!value)throw std::runtime_error("URL lifecycle sequence failed");};
+    int stage=0;
+    auto result=EmilyfnUrl38::Run([&](bool& same){check(stage++==0);same=true;return 0u;},[&](){check(stage++==1);return 0u;});
+    check(result.status==7&&stage==2&&result.constructCalls==1&&result.destroyCalls==1);
+    stage=0;
+    result=EmilyfnUrl38::Run([](bool& same){same=false;return 0xc0000005u;},[&](){++stage;return 0u;});
+    check(result.status==4&&result.exception==0xc0000005u&&stage==0&&result.destroyCalls==0);
+    result=EmilyfnUrl38::Run([](bool& same){same=false;return 0u;},[&](){++stage;return 0u;});
+    check(result.status==6&&stage==0&&result.destroyCalls==0);
+    result=EmilyfnUrl38::Run([](bool& same){same=true;return 0u;},[&](){++stage;return 0xc0000005u;});
+    check(result.status==5&&result.exception==0xc0000005u&&stage==1&&result.destroyCalls==1);
+    std::cout<<"URL LIFECYCLE: order, partial construction, wrong return and destructor failure passed\n";
+}
