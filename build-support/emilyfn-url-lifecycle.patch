@@ -0,0 +1,15 @@
+#pragma once
+#include <cstdint>
+namespace EmilyfnUrl38 {
+// Fixed diagnostic sequence. No networking or parsing, no retry after exceptions.
+// construct returns an exception code; completed construction must return the input address.
+struct Outcome {std::uint32_t status=0,constructCalls=0,destroyCalls=0,exception=0;};
+template<class Construct,class Destroy> Outcome Run(Construct construct,Destroy destroy) {
+    Outcome o;o.constructCalls=1;bool same=false;
+    o.exception=construct(same);
+    if(o.exception) {o.status=4;return o;}
+    if(!same) {o.status=6;return o;}
+    o.destroyCalls=1;o.exception=destroy();
+    o.status=o.exception?5:7;return o;
+}
+}
