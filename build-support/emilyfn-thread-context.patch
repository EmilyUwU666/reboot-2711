+#include "ThreadContext38.h"
+#include <cstring>
+#include <map>
+#include <vector>
+#include <stdexcept>
+#include <iostream>
+int main() {
+    std::map<std::uint64_t,std::vector<unsigned char>> memory;
+    auto put=[&](std::uint64_t a,auto value){std::vector<unsigned char> bytes(sizeof(value));std::memcpy(bytes.data(),&value,sizeof(value));memory[a]=bytes;};
+    auto read=[&](std::uint64_t a,auto& value){auto it=memory.find(a);if(it==memory.end()||it->second.size()!=sizeof(value))return false;std::memcpy(&value,it->second.data(),sizeof(value));return true;};
+    auto check=[](bool ok){if(!ok)throw std::runtime_error("TLS diagnostic fixture failed");};
+    constexpr std::uint64_t image=0x10000000, array=0x20000000, block=0x30000000;
+    put(image+0x16b43a24,std::uint32_t(3));put(array+24,block);put(block+0xca0,std::uint32_t(2));
+    auto result=EmilyfnThreadContext38::Inspect(read,image,array);check(result.status==5&&result.index==3&&result.value==2);
+    put(block+0xca0,std::uint32_t(0));result=EmilyfnThreadContext38::Inspect(read,image,array);check(result.status==5&&result.value==0);
+    check(EmilyfnThreadContext38::Inspect(read,image,0).status==2);
+    put(array+24,std::uint64_t(0));check(EmilyfnThreadContext38::Inspect(read,image,array).status==2);
+    put(array+24,block);memory.erase(block+0xca0);check(EmilyfnThreadContext38::Inspect(read,image,array).status==4);
+    put(image+0x16b43a24,std::uint32_t(1024));check(EmilyfnThreadContext38::Inspect(read,image,array).status==3);
+    put(image+0x16b43a24,std::uint32_t(3));check(EmilyfnThreadContext38::Inspect(read,image,UINT64_MAX-8).status==4);
+    put(array+24,UINT64_MAX-10);check(EmilyfnThreadContext38::Inspect(read,image,array).status==4);
+    memory.erase(image+0x16b43a24);check(EmilyfnThreadContext38::Inspect(read,image,array).status==4);
+    std::cout<<"THREAD CONTEXT: 9 read-only checks passed\n";
+}
