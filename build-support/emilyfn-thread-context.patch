+++ b/launcher/native/ThreadProbe/ThreadContext38.h
@@ -0,0 +1,19 @@
+#pragma once
+#include <cstdint>
+namespace EmilyfnThreadContext38 {
+// No engine calls or writes. Caller must validate the exact module profile first.
+// Status: 2 missing TLS, 3 index outside diagnostic bound, 4 unreadable, 5 observed.
+struct Observation { std::uint32_t status=4,index=0,value=0; };
+template<class Reader> Observation Inspect(Reader read,std::uint64_t image,std::uint64_t tlsArray) {
+    Observation o;
+    if (!read(image+0x16b43a24,o.index)) return o;
+    if (o.index>=1024) {o.status=3;return o;}
+    if (!tlsArray) {o.status=2;return o;}
+    std::uint64_t block=0;
+    if (tlsArray>UINT64_MAX-static_cast<std::uint64_t>(o.index)*8 ||
+        !read(tlsArray+static_cast<std::uint64_t>(o.index)*8,block)) return o;
+    if (!block) {o.status=2;return o;}
+    if (block>UINT64_MAX-0xca0 || !read(block+0xca0,o.value)) return o;
+    o.status=5;return o;
+}
+}
