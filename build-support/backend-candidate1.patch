diff --git a/tests/backend-smoke-tests.cjs b/tests/backend-smoke-tests.cjs
new file mode 100644
index 0000000..98fc915
--- /dev/null
+++ b/tests/backend-smoke-tests.cjs
@@ -0,0 +1,92 @@
+'use strict';
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const os = require('node:os');
+const {spawn} = require('node:child_process');
+const {once} = require('node:events');
+const crypto = require('node:crypto');
+const WebSocket = require('ws');
+
+const root = path.resolve(__dirname, '..');
+const scratch = fs.mkdtempSync(path.join(os.tmpdir(), 'reboot-backend-test-'));
+let child;
+let checks = 0;
+let output = '';
+const expect = (condition, label) => { assert.ok(condition, label); ++checks; };
+const wait = ms => new Promise(resolve => setTimeout(resolve, ms));
+async function request(endpoint, method = 'GET', body) {
+    const response = await fetch('http://127.0.0.1:3551' + endpoint, {
+        method, headers: {'content-type': 'application/json', 'user-agent': 'Fortnite/++Fortnite+Release-27.11-CL-29739262 Windows/10'},
+        body: body === undefined ? undefined : JSON.stringify(body), signal: AbortSignal.timeout(5000)
+    });
+    expect(response.status === 200, `${method} ${endpoint}: expected HTTP 200, got ${response.status}`);
+    return response;
+}
+async function testWebSocket(port) {
+    const socket = new WebSocket(`ws://127.0.0.1:${port}`, 'xmpp');
+    const timer = setTimeout(() => socket.terminate(), 5000);
+    try {
+        await once(socket, 'open', {signal: AbortSignal.timeout(5000)});
+        const message = once(socket, 'message', {signal: AbortSignal.timeout(5000)});
+        socket.send('<open xmlns="urn:ietf:params:xml:ns:xmpp-framing" to="prod.ol.epicgames.com" version="1.0"/>');
+        const [reply] = await message;
+        expect(reply.toString().includes('<open'), `XMPP framing reply on ${port}`);
+    } finally { clearTimeout(timer); socket.terminate(); }
+}
+async function main() {
+    child = spawn(process.execPath, ['start-backend.cjs'], {cwd: root, env: {...process.env, LOCALAPPDATA: scratch}, stdio: ['ignore', 'pipe', 'pipe']});
+    child.stdout.on('data', data => { output += data.toString(); });
+    child.stderr.on('data', data => { output += data.toString(); });
+    let ready = false;
+    for (let i = 0; i < 100; ++i) {
+        if (child.exitCode !== null) throw new Error('Backend exited during startup: ' + output);
+        if (output.includes('XMPP and Matchmaker started listening on port 80')) { ready = true; break; }
+        await wait(100);
+    }
+    expect(ready, 'backend and XMPP startup within 10 seconds');
+    const branch = '++Fortnite+Release-27.11';
+    const endpoint = '/fortnite/api/discovery/accessToken/' + encodeURIComponent(branch);
+    const token = await (await request(endpoint)).json();
+    expect(token.branchName === branch && token.appId === 'Fortnite' && typeof token.token === 'string' && token.token.length > 0,
+        '27.11 discovery-token schema and decoded branch');
+    const repeat = await (await request(endpoint)).json();
+    expect(repeat.token === token.token, 'repeated discovery requests succeed consistently');
+    for (const url of ['/discovery/surface/page', '/api/v2/discovery/surface/page']) {
+        const discovery = await (await request(url, 'POST', {})).json();
+        expect(Array.isArray(discovery.Panels) && discovery.Panels.length > 0, 'discovery panels');
+        const results = discovery.Panels.flatMap(panel => panel.Pages || []).flatMap(page => page.results || []);
+        expect(results.some(result => result.linkData?.mnemonic === 'playlist_defaultsolo'), 'default Solo playlist advertised');
+    }
+    const related = await (await request('/links/api/fn/mnemonic/playlist_defaultsolo/related')).json();
+    expect(related.links?.playlist_defaultsolo?.mnemonic === 'playlist_defaultsolo', 'Solo related link');
+    const meta = await (await request('/launcher/api/public/assets/Windows/5cb97847cee34581afdbc445400e2f77/FortniteContentBuilds')).json();
+    const manifest = Buffer.from(await (await request('/' + meta.items.MANIFEST.path)).arrayBuffer());
+    expect(manifest.length === 1281628, 'manifest body is complete');
+    expect(crypto.createHash('sha1').update(manifest).digest('hex') === meta.items.MANIFEST.hash, 'manifest body matches advertised hash');
+    const chunk = Buffer.from(await (await request('/Builds/Fortnite/Content/CloudDir/LawinServer.chunk')).arrayBuffer());
+    expect(chunk.length === 529481, 'chunk is complete');
+    const session = await (await request('/fortnite/api/matchmaking/session/test-session')).json();
+    expect(session.serverAddress === '127.0.0.1' && session.serverPort === 7777, 'matchmaking points to local game server');
+    const engine = await (await request('/fortnite/api/cloudstorage/system/DefaultEngine.ini')).text();
+    expect(engine.includes('ServerPort=80') && !engine.includes('ServerPort=8080'), 'cloud configuration matches primary XMPP listener');
+    await testWebSocket(80);
+    await testWebSocket(8080);
+
+    const duplicate = spawn(process.execPath, ['start-backend.cjs'], {cwd: root, env: {...process.env, LOCALAPPDATA: scratch}, stdio: ['ignore', 'pipe', 'pipe']});
+    let duplicateOutput = '';
+    duplicate.stdout.on('data', data => { duplicateOutput += data.toString(); });
+    duplicate.stderr.on('data', data => { duplicateOutput += data.toString(); });
+    const timeout = setTimeout(() => duplicate.kill(), 10000);
+    try {
+        const [code] = await once(duplicate, 'exit');
+        expect(code === 1 && duplicateOutput.includes('3551 is unavailable'), 'occupied backend port reported without takeover');
+    } finally { clearTimeout(timeout); if (duplicate.exitCode === null) duplicate.kill(); }
+    await request(endpoint);
+    console.log(`${checks} backend HTTP/WebSocket checks passed`);
+}
+main().catch(error => { console.error(error.stack || error); if (output) console.error(output); process.exitCode = 1; })
+    .finally(async () => {
+        if (child && child.exitCode === null) { const ended = once(child, 'exit'); child.kill(); await ended; }
+        fs.rmSync(scratch, {recursive: true, force: true});
+    });
