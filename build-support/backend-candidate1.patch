@@ -0,0 +1,15 @@
+@echo off
+setlocal
+cd /d "%~dp0"
+title Reboot 27.11 local backend
+if not exist "runtime\node.exe" (
+  echo Extract the entire Reboot-27.11-Backend-Windows-x64 ZIP first.
+  pause
+  exit /b 1
+)
+"runtime\node.exe" "start-backend.cjs"
+set "backend_exit_code=%errorlevel%"
+echo.
+echo Backend stopped. See backend-startup.log for details.
+pause
+exit /b %backend_exit_code%
