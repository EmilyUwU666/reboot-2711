diff --git a/start-backend.cjs b/start-backend.cjs
new file mode 100644
index 0000000..a36d3f7
--- /dev/null
+++ b/start-backend.cjs
@@ -0,0 +1,72 @@
+'use strict';
+
+// Local launcher for the pinned LawinServer source. No installation is required.
+const fs = require('node:fs');
+const path = require('node:path');
+const net = require('node:net');
+const crypto = require('node:crypto');
+const util = require('node:util');
+
+process.chdir(__dirname);
+const logFile = path.join(__dirname, 'backend-startup.log');
+// Append so a second launch cannot erase the running backend's diagnostics.
+fs.appendFileSync(logFile, '');
+const writeConsole = console.log.bind(console);
+function log(...values) {
+    const line = `[${new Date().toISOString()}] ${util.format(...values)}`;
+    writeConsole(line);
+    try { fs.appendFileSync(logFile, line + '\n'); } catch { /* Preserve console output if storage is unavailable. */ }
+}
+console.log = log;
+console.error = log;
+process.on('uncaughtExceptionMonitor', error => log('Backend exception:', error.stack || error.message));
+
+async function checkPort(port) {
+    await new Promise((resolve, reject) => {
+        const probe = net.createServer();
+        probe.once('error', error => reject(new Error(`Local port ${port} is unavailable (${error.code}). Stop the embedded backend or the other application using it, then retry.`)));
+        probe.listen(port, '127.0.0.1', () => probe.close(resolve));
+    });
+}
+
+async function main() {
+    log('Reboot 27.11 backend candidate 1; Node %s; PID %d', process.version, process.pid);
+    log('LawinServer source: 7f0f26d7a772c6122c42b1783fd75f497e86d3a9');
+    const expected = {
+        'LawinServer.manifest': '55bb954f5596cadbe03693e1c06ca73368d427f3',
+        'LawinServer.chunk': '96e1b78c367bd015f425abd8ca9ea1b6ccdee6f5'
+    };
+    for (const [name, digest] of Object.entries(expected)) {
+        const data = fs.readFileSync(path.join(__dirname, 'responses', 'CloudDir', name));
+        if (!data.length || crypto.createHash('sha1').update(data).digest('hex') !== digest)
+            throw new Error(`${name} is incomplete or changed. Extract a fresh copy of this package.`);
+    }
+    log('Manifest and chunk integrity verified.');
+    for (const port of [3551, 80, 8080]) await checkPort(port);
+
+    // Earlier launcher CloudStorage settings used 8080 while its XMPP server used 80.
+    // Accept that cached setting as well as the corrected port 80 supplied here.
+    const xmppAlias = net.createServer(socket => {
+        const upstream = net.connect({host: '127.0.0.1', port: 80});
+        socket.on('error', () => upstream.destroy());
+        upstream.on('error', () => socket.destroy());
+        socket.on('close', () => upstream.destroy());
+        upstream.on('close', () => socket.destroy());
+        socket.pipe(upstream).pipe(socket);
+    });
+    xmppAlias.on('error', error => {
+        log('XMPP compatibility listener failed:', error.message);
+        process.exit(1);
+    });
+    await new Promise(resolve => xmppAlias.listen(8080, '127.0.0.1', resolve));
+    require('./index.js');
+    log('Reboot Launcher: Backend type = Local; port = 3551. Keep this window open.');
+    log('Game-server destination: 127.0.0.1:7777. The game server must run separately.');
+}
+
+main().catch(error => {
+    log('Startup failed:', error.message);
+    process.exitCode = 1;
+    // Also close an alias if a source-loading error happened after it was opened.
+    process.exit(1);
+});
