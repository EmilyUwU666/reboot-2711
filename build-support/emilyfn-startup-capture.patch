+using System.ComponentModel;
+using System.Diagnostics;
+using System.Runtime.InteropServices;
+using System.Text;
+using Microsoft.Win32.SafeHandles;
+
+namespace Emilyfn.Core;
+
+public static class StartupCapture
+{
+    public sealed record Result(int ProcessId, string Folder, bool EarlyDumpSaved, int? ExitCode);
+    public static Task<Result> RunAsync(ProcessStartInfo start, string folder, string tracePath, IProgress<string>? progress = null) =>
+        Task.Run(() => Run(start, folder, tracePath, progress));
+
+    private static Result Run(ProcessStartInfo start, string folder, string tracePath, IProgress<string>? progress)
+    {
+        if (!OperatingSystem.IsWindows() || !Environment.Is64BitProcess) throw new PlatformNotSupportedException("Startup capture requires Windows x64.");
+        Directory.CreateDirectory(folder);
+        Directory.CreateDirectory(Path.GetDirectoryName(tracePath)!);
+        using var trace = new StreamWriter(new FileStream(tracePath, FileMode.CreateNew, FileAccess.Write, FileShare.Read)) { AutoFlush = true };
+        void Log(string message) => trace.WriteLine($"{DateTime.UtcNow:O} {message}");
+        Log("Early snapshot: PRE-INITIALIZATION evidence, not a live SDK dump.");
+        Log("Child observation uses 100ms snapshots. Brief processes and handoffs to an existing launcher may be missed.");
+        Log("Executable: " + start.FileName);
+        var command = new StringBuilder(Quote(start.FileName));
+        foreach (var argument in start.ArgumentList) command.Append(' ').Append(Quote(argument));
+        var si = new StartupInfo { cb = Marshal.SizeOf<StartupInfo>() };
+        if (!CreateProcessW(start.FileName, command, IntPtr.Zero, IntPtr.Zero, false, 6, IntPtr.Zero, start.WorkingDirectory, ref si, out var pi))
+        {
+            int error = Marshal.GetLastWin32Error(); Log($"CreateProcess failed: {error}");
+            File.Copy(tracePath, Path.Combine(folder, "startup.log"), true);
+            throw new Win32Exception(error);
+        }
+        bool resumed = false, early = false;
+        try
+        {
+            Log($"Created suspended: PID {pi.pid}");
+            if (!DebugSetProcessKillOnExit(false)) throw new Win32Exception(Marshal.GetLastWin32Error());
+            if (ResumeThread(pi.thread) == uint.MaxValue) throw new Win32Exception(Marshal.GetLastWin32Error());
+            resumed = true;
+            progress?.Report("Waiting for the initial Windows loader breakpoint…");
+            bool attached = true;
+            try
+            {
+                var loaderClock = Stopwatch.StartNew(); bool finished = false;
+                while (!finished && loaderClock.Elapsed < TimeSpan.FromSeconds(15))
+                {
+                    if (!WaitForDebugEvent(out var ev, 100))
+                    {
+                        int error = Marshal.GetLastWin32Error();
+                        if (error == 121) continue;
+                        throw new Win32Exception(error, "Startup debugger event failed");
+                    }
+                    uint disposition = ev.code == 1 ? 0x80010001u : 0x10002u;
+                    try
+                    {
+                        if (ev.code == 3 || ev.code == 6)
+                            if (ev.file != IntPtr.Zero && ev.file != new IntPtr(-1)) CloseHandle(ev.file);
+                        if (ev.code == 2 && ev.file != pi.thread) CloseHandle(ev.file);
+                        if (ev.code == 3)
+                        {
+                            if (ev.debugProcess != pi.process) CloseHandle(ev.debugProcess);
+                            if (ev.debugThread != pi.thread) CloseHandle(ev.debugThread);
+                        }
+                        if (ev.code == 1 && ev.exceptionCode == 0x80000003)
+                        {
+                            disposition = 0x10002; finished = true;
+                            Log("Initial loader breakpoint reached; capturing before game entry point.");
+                            progress?.Report("Saving early memory at the Windows loader breakpoint…");
+                            early = SaveEarly(pi, folder, Log);
+                        }
+                        if (ev.code == 5) { finished = true; Log("Game exited before the initial loader breakpoint."); }
+                    }
+                    finally
+                    {
+                        if (!ContinueDebugEvent(ev.pid, ev.tid, disposition))
+                            throw new Win32Exception(Marshal.GetLastWin32Error(), "Cannot continue startup event");
+                    }
+                }
+            }
+            finally
+            {
+                if (attached && !DebugActiveProcessStop(pi.pid) && WaitForSingleObject(pi.process, 0) != 0)
+                {
+                    TerminateProcess(pi.process, 1);
+                    throw new Win32Exception(Marshal.GetLastWin32Error(), "Could not detach startup debugger; stopped its own diagnostic process.");
+                }
+            }
+            var clock = Stopwatch.StartNew(); Log("Startup debugger detached; observing game execution.");
+            progress?.Report("Observing startup for 10 seconds…");
+            var descendants = new HashSet<uint> { pi.pid }; var seen = new HashSet<uint>();
+            int? exit = null; bool laterAttempted = false;
+            while (clock.Elapsed < TimeSpan.FromSeconds(10))
+            {
+                try
+                {
+                    var rows = Snapshot(); bool changed;
+                    do { changed = false; foreach (var row in rows) if (descendants.Contains(row.parent) && descendants.Add(row.pid)) changed = true; } while (changed);
+                    foreach (var row in rows)
+                        if (row.pid != pi.pid && descendants.Contains(row.pid) && seen.Add(row.pid))
+                            Log($"Observed descendant: PID {row.pid}, parent {row.parent}, image {row.name}");
+                }
+                catch (Exception error) { Log("Child observation unavailable: " + error.Message); }
+                if (exit is null && WaitForSingleObject(pi.process, 0) == 0)
+                {
+                    if (!GetExitCodeProcess(pi.process, out uint code)) throw new Win32Exception(Marshal.GetLastWin32Error());
+                    exit = unchecked((int)code); Log($"Root exited: code {exit}; observed running duration after debugger detach {clock.ElapsedMilliseconds} ms.");
+                }
+                if (!laterAttempted && exit is null && clock.ElapsedMilliseconds >= 2000)
+                {
+                    laterAttempted = true;
+                    try
+                    {
+                        var target = GameMemoryCapture.FindTargets().FirstOrDefault(t => t.Id == pi.pid);
+                        if (target is null) Log("Later capture: no accessible Fortnite target.");
+                        else
+                        {
+                            progress?.Report("Attempting later game-memory capture…");
+                            var path = GameMemoryCapture.CaptureAsync(target, folder).GetAwaiter().GetResult();
+                            Log("Later capture saved: " + path + "; engine initialization not verified.");
+                        }
+                    }
+                    catch (Exception error) { Log("Later capture failed: " + error.Message); }
+                }
+                Thread.Sleep(100);
+            }
+            if (exit is null) Log("Root still running when observation ended.");
+            File.WriteAllText(Path.Combine(folder, "README.txt"), "early.dmp is captured at the initial Windows loader breakpoint before the game entry point. It may lack live objects and cannot by itself generate an SDK.\nA later Emilyfn-memory-* folder is included only if a second capture succeeded.\nstartup.log records process startup, observed descendants and exit. Sampling may miss short processes or handoffs to an existing launcher.\nKeep dumps private: memory can contain sensitive information. Nothing was uploaded.\n");
+            return new((int)pi.pid, folder, early, exit);
+        }
+        finally
+        {
+            if (!resumed) TerminateProcess(pi.process, 1); // Only our newly created, unresumed child.
+            CloseHandle(pi.thread); CloseHandle(pi.process);
+            trace.Flush();
+            try { File.Copy(tracePath, Path.Combine(folder, "startup.log"), true); } catch { }
+        }
+    }
+    private static bool SaveEarly(ProcessInfo pi, string folder, Action<string> log)
+    {
+        var partial = Path.Combine(folder, "early.dmp.partial");
+        try
+        {
+            using (var file = new FileStream(partial, FileMode.CreateNew, FileAccess.ReadWrite, FileShare.None))
+            {
+                lock (GameMemoryCapture.DumpLock)
+                    if (!MiniDumpWriteDump(pi.process, pi.pid, file.SafeFileHandle, 2, IntPtr.Zero, IntPtr.Zero, IntPtr.Zero))
+                        throw new IOException($"MiniDumpWriteDump: 0x{Marshal.GetLastWin32Error():X8}");
+                file.Flush(true); file.Position = 0;
+                using var reader = new BinaryReader(file, Encoding.UTF8, true);
+                if (file.Length < 32 || reader.ReadUInt32() != 0x504d444d) throw new IOException("Invalid dump header.");
+            }
+            File.Move(partial, Path.Combine(folder, "early.dmp")); log("Early full-memory snapshot saved."); return true;
+        }
+        catch (Exception error)
+        {
+            log("Early capture failed: " + error.Message);
+            try { if (File.Exists(partial)) File.Delete(partial); } catch (Exception cleanup) { log("Partial cleanup failed: " + cleanup.Message); }
+            return false;
+        }
+    }
+    [StructLayout(LayoutKind.Explicit, Size=176)] private struct DebugEvent
+    {
+        [FieldOffset(0)] public uint code; [FieldOffset(4)] public uint pid; [FieldOffset(8)] public uint tid;
+        [FieldOffset(16)] public uint exceptionCode; [FieldOffset(16)] public IntPtr file;
+        [FieldOffset(24)] public IntPtr debugProcess; [FieldOffset(32)] public IntPtr debugThread;
+    }
+    [DllImport("kernel32.dll", SetLastError=true)] private static extern bool WaitForDebugEvent(out DebugEvent ev,uint timeout);
+    [DllImport("kernel32.dll", SetLastError=true)] private static extern bool ContinueDebugEvent(uint pid,uint tid,uint status);
+    [DllImport("kernel32.dll", SetLastError=true)] private static extern bool DebugActiveProcessStop(uint pid);
+    [DllImport("kernel32.dll", SetLastError=true)] private static extern bool DebugSetProcessKillOnExit(bool kill);
+    private static string Quote(string value)
+    {
+        var result = new StringBuilder("\""); int slashes = 0;
+        foreach (char c in value)
+        {
+            if (c == '\\') { slashes++; continue; }
+            result.Append('\\', c == '"' ? slashes * 2 + 1 : slashes);
+            result.Append(c); slashes = 0;
+        }
+        return result.Append('\\', slashes * 2).Append('"').ToString();
+    }
+    private static List<(uint pid, uint parent, string name)> Snapshot()
+    {
+        var result = new List<(uint,uint,string)>();
+        var handle = CreateToolhelp32Snapshot(2, 0);
+        if (handle == new IntPtr(-1)) throw new Win32Exception(Marshal.GetLastWin32Error());
+        try
+        {
+            var entry = new ProcessEntry { size = (uint)Marshal.SizeOf<ProcessEntry>() };
+            if (Process32FirstW(handle, ref entry)) do { result.Add((entry.pid, entry.parent, entry.name)); } while (Process32NextW(handle, ref entry));
+            return result;
+        }
+        finally { CloseHandle(handle); }
+    }
+    [StructLayout(LayoutKind.Sequential, CharSet=CharSet.Unicode)] private struct ProcessEntry { public uint size,usage,pid; public UIntPtr heap; public uint module,threads,parent; public int priority; public uint flags; [MarshalAs(UnmanagedType.ByValTStr, SizeConst=260)] public string name; }
+    [StructLayout(LayoutKind.Sequential, CharSet=CharSet.Unicode)] private struct StartupInfo { public int cb; public string? reserved,desktop,title; public int x,y,xSize,ySize,xChars,yChars,fill,flags; public short show,reserved2; public IntPtr reservedPointer,input,output,error; }
+    [StructLayout(LayoutKind.Sequential)] private struct ProcessInfo { public IntPtr process,thread; public uint pid,tid; }
+    [DllImport("kernel32.dll", CharSet=CharSet.Unicode, SetLastError=true)] [return: MarshalAs(UnmanagedType.Bool)] private static extern bool CreateProcessW(string app,StringBuilder cmd,IntPtr pa,IntPtr ta,bool inherit,uint flags,IntPtr env,string directory,ref StartupInfo si,out ProcessInfo pi);
+    [DllImport("kernel32.dll", SetLastError=true)] private static extern uint ResumeThread(IntPtr thread);
+    [DllImport("kernel32.dll")] private static extern uint WaitForSingleObject(IntPtr handle,uint timeout);
+    [DllImport("kernel32.dll", SetLastError=true)] private static extern bool GetExitCodeProcess(IntPtr process,out uint code);
+    [DllImport("kernel32.dll")] private static extern bool TerminateProcess(IntPtr process,uint code);
+    [DllImport("kernel32.dll")] private static extern bool CloseHandle(IntPtr handle);
+    [DllImport("kernel32.dll", SetLastError=true)] private static extern IntPtr CreateToolhelp32Snapshot(uint flags,uint pid);
+    [DllImport("kernel32.dll", CharSet=CharSet.Unicode)] private static extern bool Process32FirstW(IntPtr handle,ref ProcessEntry entry);
+    [DllImport("kernel32.dll", CharSet=CharSet.Unicode)] private static extern bool Process32NextW(IntPtr handle,ref ProcessEntry entry);
+    [DllImport("dbghelp.dll", SetLastError=true)] [DefaultDllImportSearchPaths(DllImportSearchPath.System32)] private static extern bool MiniDumpWriteDump(IntPtr process,uint pid,SafeFileHandle file,uint flags,IntPtr exception,IntPtr streams,IntPtr callback);
+}
