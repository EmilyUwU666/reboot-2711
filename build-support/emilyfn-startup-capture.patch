+using Emilyfn.Core;
+using System.Diagnostics;
+var root = Path.Combine(Path.GetTempPath(), "Emilyfn startup test " + Guid.NewGuid().ToString("N"));
+Directory.CreateDirectory(root);
+try
+{
+    var exe = Path.Combine(root, "startup child.exe"); File.Copy(Path.GetFullPath(args[0]), exe);
+    var folder = Path.Combine(root, "capture"); var trace = Path.Combine(root, "startup.log");
+    var result = await StartupCapture.RunAsync(new ProcessStartInfo(exe) { WorkingDirectory = root }, folder, trace);
+    if (result.ExitCode != 42) throw new Exception("Exit code not recorded: " + result.ExitCode);
+    if (!result.EarlyDumpSaved) throw new Exception("Early capture failed: " + File.ReadAllText(trace));
+    using (var reader = new BinaryReader(File.OpenRead(Path.Combine(folder, "early.dmp"))))
+    {
+        if (reader.ReadUInt32() != 0x504d444d) throw new Exception("Dump invalid");
+        reader.ReadUInt32(); uint count = reader.ReadUInt32(), offset = reader.ReadUInt32(); bool memory = false;
+        for (uint i = 0; i < count; i++) { reader.BaseStream.Position = offset + i * 12; if (reader.ReadUInt32() == 9) memory = true; }
+        if (!memory) throw new Exception("Full memory stream absent");
+    }
+    var log = File.ReadAllText(trace);
+    if (!log.Contains("Observed descendant:") || !log.Contains("observed running duration") || !log.Contains("PRE-INITIALIZATION")) throw new Exception("Trace incomplete: " + log);
+    if (!File.Exists(Path.Combine(folder, "startup.log"))) throw new Exception("Trace not copied");
+    if (Directory.EnumerateFiles(folder, "*.partial").Any()) throw new Exception("Partial dump remains");
+    Console.WriteLine("STARTUP CAPTURE PASSED: pre-run full-memory snapshot, resumed process, exit code 42, descendant discovery, lifetime, copied trace, no partial dump.");
+}
+finally { Directory.Delete(root, true); }
