+#include <windows.h>
+#include <string>
+int wmain(int argc, wchar_t**)
+{
+    if (argc > 1) { Sleep(1200); return 17; }
+    wchar_t file[MAX_PATH]{}; GetModuleFileNameW(nullptr, file, MAX_PATH);
+    std::wstring command = L"\"" + std::wstring(file) + L"\" child";
+    STARTUPINFOW si{}; si.cb = sizeof(si); PROCESS_INFORMATION pi{};
+    if (!CreateProcessW(file, command.data(), nullptr, nullptr, FALSE, 0, nullptr, nullptr, &si, &pi)) return 99;
+    CloseHandle(pi.hThread); CloseHandle(pi.hProcess);
+    Sleep(750); return 42;
+}
