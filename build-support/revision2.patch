diff --git a/Reboot2711/ProcessEventLookup.h b/Reboot2711/ProcessEventLookup.h
new file mode 100644
index 0000000..d3b882a
--- /dev/null
+++ b/Reboot2711/ProcessEventLookup.h
@@ -0,0 +1,183 @@
+#pragma once
+
+#include <Windows.h>
+#include <array>
+#include <cstdint>
+#include <cstring>
+#include <limits>
+#include <optional>
+#include <sstream>
+
+namespace Reboot2711::ProcessEventLookup
+{
+    inline std::string FailureDetails;
+    // Inspect only committed pages with the required access. This is used on
+    // stable engine objects and image sections during SDK initialization.
+    inline bool Accessible(uintptr_t address, size_t size, bool executable = false)
+    {
+        if (!address || !size || size > (std::numeric_limits<uintptr_t>::max)() - address)
+            return false;
+        const auto end = address + size;
+        while (address < end)
+        {
+            MEMORY_BASIC_INFORMATION info{};
+            if (!VirtualQuery(reinterpret_cast<const void*>(address), &info, sizeof(info))
+                || info.State != MEM_COMMIT || (info.Protect & (PAGE_GUARD | PAGE_NOACCESS)))
+                return false;
+            const auto access = info.Protect & 0xff;
+            const bool readable = access == PAGE_READONLY || access == PAGE_READWRITE || access == PAGE_WRITECOPY
+                || access == PAGE_EXECUTE_READ || access == PAGE_EXECUTE_READWRITE || access == PAGE_EXECUTE_WRITECOPY;
+            const bool isExecutable = access == PAGE_EXECUTE || access == PAGE_EXECUTE_READ
+                || access == PAGE_EXECUTE_READWRITE || access == PAGE_EXECUTE_WRITECOPY;
+            if (!readable || (executable && !isExecutable))
+                return false;
+            const auto next = reinterpret_cast<uintptr_t>(info.BaseAddress) + info.RegionSize;
+            if (next <= address)
+                return false;
+            address = next;
+        }
+        return true;
+    }
+
+    template <typename T>
+    inline bool Read(uintptr_t address, T& value)
+    {
+        if (!Accessible(address, sizeof(T)))
+            return false;
+        std::memcpy(&value, reinterpret_cast<const void*>(address), sizeof(T));
+        return true;
+    }
+
+    inline uintptr_t ResolveJump(uintptr_t address)
+    {
+        std::array<uintptr_t, 8> visited{};
+        for (size_t depth = 0; depth < visited.size(); ++depth)
+        {
+            if (!Accessible(address, 1, true))
+                return 0;
+            for (size_t i = 0; i < depth; ++i)
+                if (visited[i] == address)
+                    return 0;
+            visited[depth] = address;
+            uint8_t opcode{};
+            if (!Read(address, opcode))
+                return 0;
+            if (opcode == 0xe9)
+            {
+                int32_t displacement{};
+                if (!Read(address + 1, displacement))
+                    return 0;
+                address = address + 5 + static_cast<intptr_t>(displacement);
+            }
+            else if (opcode == 0xeb)
+            {
+                int8_t displacement{};
+                if (!Read(address + 1, displacement))
+                    return 0;
+                address = address + 2 + static_cast<intptr_t>(displacement);
+            }
+            else if (opcode == 0xff)
+            {
+                uint8_t operand{};
+                if (!Read(address + 1, operand))
+                    return 0;
+                if (operand != 0x25)
+                    return address;
+                int32_t displacement{};
+                uintptr_t target{};
+                if (!Read(address + 2, displacement)
+                    || !Read(address + 6 + static_cast<intptr_t>(displacement), target))
+                    return 0;
+                address = target;
+            }
+            else
+                return address;
+        }
+        return 0; // Do not follow unbounded or cyclic stubs.
+    }
+
+    inline uintptr_t FunctionStart(uintptr_t address)
+    {
+        if (!Accessible(address, 1, true))
+            return 0;
+        DWORD64 moduleBase = 0;
+        if (const auto entry = RtlLookupFunctionEntry(address, &moduleBase, nullptr))
+            return static_cast<uintptr_t>(moduleBase + entry->BeginAddress);
+        return address;
+    }
+
+    struct Result
+    {
+        std::optional<size_t> index;
+        bool ambiguous = false;
+        size_t examined = 0;
+        uintptr_t table = 0;
+    };
+
+    inline Result Find(const void* object, uintptr_t candidate)
+    {
+        Result result;
+        const auto target = ResolveJump(FunctionStart(candidate));
+        if (!target || !Read(reinterpret_cast<uintptr_t>(object), result.table))
+            return result;
+        // A vtable is a contiguous sequence of executable pointers. Stop at
+        // data/RTTI/null entries instead of walking into an adjacent table.
+        for (size_t i = 0; i < 0x100; ++i)
+        {
+            uintptr_t entry{};
+            if (!Read(result.table + i * sizeof(uintptr_t), entry) || !Accessible(entry, 1, true))
+                break;
+            ++result.examined;
+            if (ResolveJump(entry) == target)
+            {
+                if (result.index)
+                {
+                    result.index.reset();
+                    result.ambiguous = true;
+                    return result;
+                }
+                result.index = i;
+            }
+        }
+        return result;
+    }
+
+    inline std::string Describe(const Result& result, uintptr_t candidate)
+    {
+        const auto module = reinterpret_cast<uintptr_t>(GetModuleHandleW(nullptr));
+        std::ostringstream out;
+        out << "candidate RVA=0x" << std::hex << (candidate >= module ? candidate - module : 0)
+            << ", table=0x" << result.table << std::dec << ", entries=" << result.examined
+            << ", ambiguous=" << result.ambiguous;
+        if (result.index)
+            out << ", index=" << *result.index;
+        return out.str();
+    }
+
+    inline std::string Dump(const Result& result, uintptr_t candidate)
+    {
+        const auto module = reinterpret_cast<uintptr_t>(GetModuleHandleW(nullptr));
+        std::ostringstream out;
+        out << Describe(result, candidate) << "\nCandidate bytes:" << std::hex;
+        for (size_t i = 0; i < 48; ++i)
+        {
+            uint8_t byte{};
+            if (!Read(candidate + i, byte))
+                break;
+            out << ' ' << static_cast<unsigned>(byte);
+        }
+        out << "\nVirtual-table RVAs (or external absolute addresses):\n";
+        for (size_t i = 0; i < result.examined; ++i)
+        {
+            uintptr_t entry{};
+            if (!Read(result.table + i * sizeof(uintptr_t), entry))
+                break;
+            MEMORY_BASIC_INFORMATION info{};
+            const bool inMainImage = VirtualQuery(reinterpret_cast<const void*>(entry), &info, sizeof(info))
+                && reinterpret_cast<uintptr_t>(info.AllocationBase) == module;
+            out << std::dec << i << ": " << (inMainImage ? "RVA 0x" : "external 0x") << std::hex
+                << (inMainImage ? entry - module : entry) << '\n';
+        }
+        return out.str();
+    }
+}
