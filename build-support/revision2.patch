diff --git a/tests/process_event_lookup_tests.cpp b/tests/process_event_lookup_tests.cpp
new file mode 100644
index 0000000..e71fd9d
--- /dev/null
+++ b/tests/process_event_lookup_tests.cpp
@@ -0,0 +1,85 @@
+#include "../Reboot2711/ProcessEventLookup.h"
+#include <algorithm>
+#include <cstdlib>
+#include <iostream>
+
+static int checks = 0;
+static void Check(bool condition, const char* message)
+{
+    ++checks;
+    if (!condition)
+    {
+        std::cerr << "FAIL: " << message << '\n';
+        std::exit(1);
+    }
+}
+
+int main()
+{
+    using namespace Reboot2711::ProcessEventLookup;
+    auto code = static_cast<unsigned char*>(VirtualAlloc(nullptr, 4096, MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE));
+    Check(code != nullptr, "allocate synthetic code page");
+    std::fill_n(code, 4096, static_cast<unsigned char>(0xc3));
+    const auto base = reinterpret_cast<uintptr_t>(code);
+    const auto target = base + 0x200;
+    const auto other = base + 0x300;
+    code[0] = 0xe9;
+    const int32_t forward = 0x200 - 5;
+    std::memcpy(code + 1, &forward, sizeof(forward));
+    code[0x20] = 0xff;
+    code[0x21] = 0x25;
+    const int32_t indirect = 0x40 - 0x26;
+    std::memcpy(code + 0x22, &indirect, sizeof(indirect));
+    std::memcpy(code + 0x40, &target, sizeof(target));
+    code[0x100] = 0xeb;
+    code[0x101] = 0xfe; // Jump to self; must be rejected.
+    code[0x1e0] = 0xeb;
+    code[0x1e1] = 0x1e;
+    code[0x240] = 0xe9;
+    const int32_t backward = -0x45;
+    std::memcpy(code + 0x241, &backward, sizeof(backward));
+    Check(!Accessible(base, 1, true), "non-executable code is rejected");
+    DWORD oldProtect = 0;
+    Check(VirtualProtect(code, 4096, PAGE_EXECUTE_READ, &oldProtect) != 0, "protect synthetic code page");
+    Check(ResolveJump(base) == target, "resolve near forward jump");
+    Check(ResolveJump(base + 0x1e0) == target, "resolve short jump");
+    Check(ResolveJump(base + 0x240) == target, "resolve negative displacement");
+    Check(ResolveJump(base + 0x20) == target, "resolve RIP-relative indirect jump");
+    Check(ResolveJump(base + 0x100) == 0, "reject cyclic jump");
+    Check(ResolveJump(0) == 0, "reject missing target");
+
+    std::array<uintptr_t, 40> table{};
+    std::fill_n(table.begin(), 39, other);
+    table[17] = target; // Synthetic index, not a Fortnite offset.
+    struct FakeObject { uintptr_t* table; } object{table.data()};
+    auto result = Find(&object, target);
+    Check(result.index == 17 && !result.ambiguous, "match direct virtual-table entry");
+    Check(result.examined == 39, "stop at table terminator");
+    table[17] = base;
+    Check(Find(&object, target).index == 17, "match virtual-table jump stub");
+    Check(Find(&object, base + 0x20).index == 17, "normalize candidate jump stub");
+    table[18] = target;
+    result = Find(&object, target);
+    Check(!result.index && result.ambiguous, "reject multiple matches");
+    table[17] = table[18] = other;
+    Check(!Find(&object, target).index, "reject unrelated table");
+    Check(!Find(nullptr, target).index, "reject absent object");
+    Check(!Find(&object, 0).index, "reject absent function");
+    table[0] = target;
+    result = Find(&object, target);
+    Check(result.index.has_value() && *result.index == 0, "represent zero index explicitly");
+    table[0] = other;
+    table[10] = reinterpret_cast<uintptr_t>(table.data());
+    table[17] = target;
+    Check(!Find(&object, target).index, "do not continue past data into another table");
+    FakeObject invalid{reinterpret_cast<uintptr_t*>(1)};
+    Check(!Find(&invalid, target).index, "reject unreadable table");
+
+    auto pages = static_cast<unsigned char*>(VirtualAlloc(nullptr, 8192, MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE));
+    Check(pages != nullptr, "allocate boundary test pages");
+    Check(VirtualProtect(pages + 4096, 4096, PAGE_NOACCESS, &oldProtect) != 0, "protect boundary test page");
+    Check(!Accessible(reinterpret_cast<uintptr_t>(pages + 4092), 8), "reject reads crossing into inaccessible page");
+    VirtualFree(pages, 0, MEM_RELEASE);
+    VirtualFree(code, 0, MEM_RELEASE);
+    std::cout << checks << " ProcessEvent lookup checks passed.\n";
+}
