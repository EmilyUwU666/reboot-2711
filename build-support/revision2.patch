@@ -1289,6 +1292,41 @@ namespace SDK
 
     inline void InitializeProcessEventVft(uintptr_t PEAddr)
     {
+#ifdef REBOOT_TARGET_2711
+        using namespace Reboot2711::ProcessEventLookup;
+        Offsets::ProcessEventVft = 0;
+        FailureDetails.clear();
+        const auto ObjectClass = UObject::StaticClass();
+        if (!ObjectClass)
+            throw std::runtime_error("ProcessEvent lookup: the Object class was not found in GObjects.");
+
+        // UClass is itself a UObject. Its table can be inspected without
+        // first guessing the ClassDefaultObject field offset in UClass.
+        const auto classResult = Find(ObjectClass, PEAddr);
+        if (classResult.index && *classResult.index != 0)
+        {
+            Offsets::ProcessEventVft = *classResult.index;
+            printf("ProcessEvent via Object class: %s\n", Describe(classResult, PEAddr).c_str());
+            return;
+        }
+
+        // Locate the default object by its actual class and RF_ClassDefaultObject
+        // flag. Do not call GetDefaultObj(), whose field-offset inference may
+        // itself be unavailable at this early initialization stage.
+        const auto DefaultObj = DefaultObjImpl(ObjectClass, "Object");
+        const auto defaultResult = Find(DefaultObj, PEAddr);
+        if (defaultResult.index && *defaultResult.index != 0)
+        {
+            Offsets::ProcessEventVft = *defaultResult.index;
+            printf("ProcessEvent via Object CDO: %s\n", Describe(defaultResult, PEAddr).c_str());
+            return;
+        }
+
+        FailureDetails = "Object class:\n" + Dump(classResult, PEAddr) + "\nDefault object:\n" + Dump(defaultResult, PEAddr);
+        throw std::runtime_error(std::string("ProcessEvent lookup could not validate a virtual-table entry.\nClass: ")
+            + Describe(classResult, PEAddr) + "\nDefault object: " + (DefaultObj ? "present; " : "missing; ")
+            + Describe(defaultResult, PEAddr));
+#else
         const auto ObjectClass = UObject::StaticClass();
         auto DefaultObj = ObjectClass ? ObjectClass->GetDefaultObj() : nullptr;
 
@@ -1299,5 +1337,6 @@ namespace SDK
                     Offsets::ProcessEventVft = i;
                     break;
                 }
+#endif
     }
 } // namespace SDK
