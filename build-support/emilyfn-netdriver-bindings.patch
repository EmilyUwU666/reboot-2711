+using Emilyfn.Core;
+static class NetDriverBindingChecks
+{
+    public static void Run()
+    {
+        ulong image=0x10000000,vt=image+0x11ca8470;
+        var memory=new Dictionary<ulong,byte[]>();
+        void D(ulong a,uint v)=>memory[a]=BitConverter.GetBytes(v);
+        void Q(ulong a,ulong v)=>memory[a]=BitConverter.GetBytes(v);
+        byte[] Read(ulong a,int n)=>memory.TryGetValue(a,out var b)&&b.Length==n?b:throw new InvalidDataException("Missing fixture memory");
+        Q(0x2000,vt);Q(0x2018,0x1000);D(0x2010,0x10);D(0x2014,1u^RuntimeObjectRegistry38.IndexMask);D(0x2020,0);
+        Q(vt+50*8,image+0xc306f9a);Q(vt+93*8,image+0x4655228);Q(vt+130*8,image+0xfc3134);
+        foreach(var a in NetDriverBindings38.Anchors)memory[image+a.Key]=a.Value.ToArray();
+        var reflection=new CaptureReflectionExporter38.Observation(new(),new(),new(),0,0,new(){new(0x1000,"/Script/Engine.NetDriver","Class")})
+            {Registry=new(2,0,new(){new(1,0x2000)},new())};
+        var names=new Dictionary<uint,string>{{0,"Default__NetDriver"}};
+        NetDriverBindings38.Report Run()=>NetDriverBindings38.Inspect(Read,image,reflection,names);
+        void Check(bool b){if(!b)throw new Exception("NetDriver binding fixture failed");}
+        var good=Run();Check(!good.CallableBindingsVerified&&!good.NetworkingCallsAttempted&&good.Drivers[0].KnownTable&&good.Drivers[0].Methods.All(m=>m.EntryBytesMatch));
+        memory[image+0xfc3134][0]^=1;Check(!Run().Drivers[0].Methods.Single(m=>m.Slot==130).EntryBytesMatch);memory[image+0xfc3134][0]^=1;
+        Q(vt+93*8,image+0x999);Check(!Run().Drivers[0].Methods.Single(m=>m.Slot==93).KnownCandidate);Q(vt+93*8,image+0x4655228);
+        D(0x2014,2u^RuntimeObjectRegistry38.IndexMask);Check(Run().Drivers[0].Failure is not null);D(0x2014,1u^RuntimeObjectRegistry38.IndexMask);
+        names[0]="WrongName";Check(Run().Drivers[0].DefaultMatches==0);names[0]="Default__NetDriver";
+        D(0x2010,0);Check(Run().Drivers[0].DefaultMatches==0);
+        Check(good.Drivers.Skip(1).All(d=>d.Failure is not null));
+        Console.WriteLine("NetDriver binding checks passed: identity, known tables, changed bytes, unknown entries and no callable approval.");
+    }
+}
