+        try
+        {
+            using(var output=new StreamWriter(Path.Combine(folder,"names.hpp"),false,new UTF8Encoding(false)))
+            {
+                output.WriteLine("#pragma once\n#include <array>\n#include <cstdint>\nnamespace emilyfn_names38 {\n// Captured names only: no verified UObject layouts or dispatch wrappers.\ninline constexpr bool sdk_ready = false;\nstruct Name { std::uint32_t index; const char* text; bool numbered; };\ninline constexpr std::array<Name, "+names.Count+"> names = {{");
