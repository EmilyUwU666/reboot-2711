+                {
+                    string escaped=string.Concat(Encoding.UTF8.GetBytes(name.Name).Select(b=>"\\"+Convert.ToString(b,8).PadLeft(3,'0')));
+                    output.WriteLine("{"+name.Index+"u, \""+escaped+"\", "+(name.Numbered?"true":"false")+"},");
+                }
+                output.WriteLine("}};\n}");
+            }
+            int numbered=names.Count(n=>n.Numbered);
+            File.WriteAllText(Path.Combine(folder,"report.json"),JsonSerializer.Serialize(new {
+                Profile="38.00 CL47722112 name-decoding anchors",SourceDumpBytes=input.Length,ModuleCount=moduleCount,
+                MemoryRanges=map.Count,NameBlocks=blocks.Count,PlainNames=names.Count-numbered,NumberedNames=numbered,
