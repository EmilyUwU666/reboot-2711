+using System.Buffers.Binary;
+using System.Text;
+namespace Emilyfn.Core;
+
+// Exact CL47722112 name format; does not describe UObject layouts.
+public static class NamePool38
+{
+    public const ulong PoolRva = 0x16c1c5c0;
+    public sealed record Entry(uint Index, string Name, bool Numbered);
+    public static uint DecodeIndex(uint stored)
+    {
+        if (stored == 0) return 0;
+        uint value = unchecked(((stored - 1) ^ 0x6f01622bu) + 1);
+        return value == 0 ? 0x90fe9dd5u : value;
+    }
+    public static string DecodePlain(ReadOnlySpan<byte> entry)
+    {
+        if (entry.Length < 2) throw new InvalidDataException("Missing name header.");
+        ushort h = BinaryPrimitives.ReadUInt16LittleEndian(entry);
+        int length = (h >> 6) ^ 0x26f;
+        if (length == 0) throw new InvalidDataException("Numbered name needs pool resolution.");
+        bool wide = (h & 1) != 0;
+        int count = length * (wide ? 2 : 1);
+        if (entry.Length < count + 2) throw new InvalidDataException("Truncated name payload.");
+        byte[] bytes = new byte[count]; uint state = (uint)length;
+        for (int i = 0; i < count; i++)
+        {
+            state = unchecked(state * 0xffffde61u + 0xfe93e844u);
+            bytes[i] = (byte)(entry[i + 2] ^ unchecked((byte)(state + 0x4a)));
+        }
+        if (wide) return new UnicodeEncoding(false, false, true).GetString(bytes);
+        return new string(bytes.Select(b => b < 128 ? (char)b : (char)(0xff00 + b)).ToArray());
+    }
+    public static List<Entry> DecodeBlocks(IReadOnlyList<byte[]> blocks)
+    {
+        if (blocks.Count is < 1 or > 2048) throw new InvalidDataException("Invalid block count.");
+        var plain = new Dictionary<uint, string>();
+        var numbered = new Dictionary<uint, (uint Number, uint Reference)>();
+        for (int block = 0; block < blocks.Count; block++)
+        {
+            byte[] data = blocks[block];
+            if (data.Length > 131072 || data.Length % 2 != 0 || (block < blocks.Count - 1 && data.Length != 131072))
+                throw new InvalidDataException("Invalid name block bounds.");
+            for (int offset = 0; offset < data.Length;)
+            {
+                ushort h = BinaryPrimitives.ReadUInt16LittleEndian(data.AsSpan(offset));
+                if (h == 0)
+                {
+                    // Some numbered allocations include two bytes of alignment padding.
+                    if (offset % 4 == 0 && offset + 4 <= data.Length &&
+                        (BinaryPrimitives.ReadUInt16LittleEndian(data.AsSpan(offset + 2)) >> 6) == 0x26f)
+                    { offset += 2; continue; }
+                    if (data.AsSpan(offset).IndexOfAnyExcept((byte)0) < 0) break;
+                    throw new InvalidDataException($"Unknown name padding: block {block}, offset {offset:X}.");
+                }
+                uint index = ((uint)block << 16) | ((uint)offset / 2);
+                int length = (h >> 6) ^ 0x26f;
+                if (length == 0)
+                {
+                    if (offset + 10 > data.Length) throw new InvalidDataException("Invalid numbered entry.");
+                    numbered.Add(index, (BinaryPrimitives.ReadUInt32LittleEndian(data.AsSpan(offset + 2)),
+                        DecodeIndex(BinaryPrimitives.ReadUInt32LittleEndian(data.AsSpan(offset + 6)))));
+                    offset += 10;
+                }
+                else
+                {
+                    int size = (2 + length * ((h & 1) != 0 ? 2 : 1) + 1) & ~1;
+                    if (offset + size > data.Length) throw new InvalidDataException("Name crosses block boundary.");
+                    plain.Add(index, DecodePlain(data.AsSpan(offset, size))); offset += size;
+                }
+            }
+        }
+        var result = plain.Select(p => new Entry(p.Key, p.Value, false)).ToList();
+        foreach (var pair in numbered)
+        {
+            if (!plain.TryGetValue(pair.Value.Reference, out string? name))
+                throw new InvalidDataException("Numbered name reference is missing or is not plain.");
+            uint stored = pair.Value.Number, v = unchecked(stored - 1);
+            int number = stored == 0 ? -1 : unchecked((int)(v == 0x0685c294u ? v : v ^ 0xf97a3d6bu));
+            result.Add(new(pair.Key, name + "_" + number.ToString(System.Globalization.CultureInfo.InvariantCulture), true));
+        }
+        result.Sort((a,b) => a.Index.CompareTo(b.Index));
+        if (result.Count == 0 || result[0].Index != 0 || result[0].Name != "None")
+            throw new InvalidDataException("Name sentinel did not decode to None.");
+        return result;
+    }
+}
