+                Limitation="Name metadata only. Class/property layouts and function dispatch are not verified."
+            },new JsonSerializerOptions{WriteIndented=true}));
+            File.WriteAllText(Path.Combine(folder,"README.txt"),"names.hpp contains captured names, not a usable gameplay SDK. UObject registry, layouts and function dispatch remain unverified. Runtime names may be private; keep generated files private.\n");
+            return new(folder,names.Count-numbered,numbered);
+        }
+        catch { Directory.Delete(folder,true); throw; }
+    }
