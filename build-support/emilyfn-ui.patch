+using Emilyfn.Core;
+using Microsoft.Win32;
+using System.Collections.ObjectModel;
+using System.ComponentModel;
+using System.Diagnostics;
+using System.IO;
+using System.Runtime.CompilerServices;
+using System.Windows;
+using System.Windows.Media;
+using System.Windows.Media.Imaging;
+using System.Windows.Threading;
+
+namespace Emilyfn.App;
+
+public partial class MainWindow : Window, INotifyPropertyChanged
+{
+    private readonly SettingsStore store;
+    private readonly LauncherSettings settings;
+    private readonly LauncherEngine engine;
+    private readonly CancellationTokenSource lifetime = new();
+    private readonly bool preview;
+    private bool closing;
+    private readonly List<string> lines = [];
+    private GameInstall? selectedInstall;
+    private SessionStatus host = new(GameRole.Host, LaunchStage.Idle, "Start a local server for your selected build.");
+    private SessionStatus client = new(GameRole.Client, LaunchStage.Idle, "Your selected build, with a local profile.");
+    public event PropertyChangedEventHandler? PropertyChanged;
+    public ObservableCollection<GameInstall> Installations { get; } = [];
+    public GameInstall? SelectedInstall { get => selectedInstall; set { selectedInstall = value; Notify(); RefreshDashboard(); } }
+    public string NewGamePath { get; set; } = "";
+    public string NewRelease { get; set; } = "";
+    public string DisplayName { get; set; } = "Emily";
+    public bool AutoHost { get; set; } = true;
+    public bool HeadlessHost { get; set; } = true;
+    public string BackendStatus { get; private set; } = "Not started";
+    public string PageTitle { get; private set; } = "Let's play, Emily.";
+    public string PageSubtitle { get; private set; } = "Your favorite chapters, in one place.";
+    public string Banner { get; private set; } = "";
+    public Visibility BannerVisibility => string.IsNullOrEmpty(Banner) ? Visibility.Collapsed : Visibility.Visible;
+    public string BuildHeadline => SelectedInstall?.Label ?? "Add your first Fortnite build";
+    public string BuildSubline => SelectedInstall is { } i ? i.Island + " island  ·  Local play" : "Open Library to choose your game folder.";
+    public string HostLabel => StageLabel(host.Stage);
+    public string ClientLabel => StageLabel(client.Stage);
+    public string HostDetail => host.Detail;
+    public string ClientDetail => client.Detail;
+    public bool HostBusy => host.Stage is not (LaunchStage.Idle or LaunchStage.Failed);
+    public bool ClientBusy => client.Stage is not (LaunchStage.Idle or LaunchStage.Failed);
+    public bool CanStartHost => !HostBusy && !closing;
+    public bool CanStartClient => !ClientBusy && !closing;
+    public string LatestActivity => lines.Count == 0 ? "Ready when you are. Add a build to get started." : lines[^1];
+    public string LogText => string.Join(Environment.NewLine, lines);
+    public MainWindow(bool renderPreview = false)
+    {
+        preview = renderPreview;
+        InitializeComponent();
+        var data = preview ? Path.Combine(Path.GetTempPath(), "Emilyfn-preview-" + Guid.NewGuid().ToString("N")) : Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData), "Emilyfn");
+        store = new SettingsStore(data);
+        settings = store.Load();
+        DisplayName = settings.DisplayName; AutoHost = settings.AutoHost; HeadlessHost = settings.HeadlessHost;
+        foreach (var install in settings.Installations) Installations.Add(install);
+        SelectedInstall = Installations.FirstOrDefault(i => i.Id == settings.SelectedId) ?? Installations.FirstOrDefault();
+        engine = new LauncherEngine(AppContext.BaseDirectory, data);
+        engine.Logged += line => UI(() => { lines.Add(line); if (lines.Count > 250) lines.RemoveAt(0); Notify(nameof(LogText)); Notify(nameof(LatestActivity)); });
+        engine.Backend.Changed += state => UI(() => { BackendStatus = state; Notify(nameof(BackendStatus)); });
+        engine.StatusChanged += state => UI(() => { if (state.Role == GameRole.Host) host = state; else client = state; RefreshDashboard(); if (state.Stage == LaunchStage.Failed) ShowBanner(state.Detail); });
+        if (preview)
+        {
+            var demo = new GameInstall("preview", @"D:\Fortnite\27.11", "27.11");
+            Installations.Add(demo); SelectedInstall = demo;
+            lines.Add("Emilyfn is ready. Select Play to start your local session.");
+        }
+        DataContext = this;
+        Navigate("Play");
+    }
+    private void UI(Action action) { if (!Dispatcher.HasShutdownStarted) _ = Dispatcher.BeginInvoke(action); }
+    private void Notify([CallerMemberName] string? name = null) => PropertyChanged?.Invoke(this, new PropertyChangedEventArgs(name));
+    private void RefreshDashboard()
+    {
+        foreach (var name in new[] { nameof(BuildHeadline), nameof(BuildSubline), nameof(HostLabel), nameof(ClientLabel), nameof(HostDetail), nameof(ClientDetail), nameof(HostBusy), nameof(ClientBusy), nameof(CanStartHost), nameof(CanStartClient) }) Notify(name);
+    }
+    private static string StageLabel(LaunchStage stage) => stage switch { LaunchStage.Idle => "Idle", LaunchStage.Listening => "Listening", LaunchStage.Active => "Active", LaunchStage.Failed => "Needs attention", LaunchStage.Login => "Signing in", LaunchStage.LoadingMap => "Loading island", _ => stage.ToString() };
+    private void ShowBanner(string message) { Banner = message; Notify(nameof(Banner)); Notify(nameof(BannerVisibility)); }
+    private void Save()
+    {
+        LaunchProtocol.ValidateName(DisplayName);
+        settings.DisplayName = DisplayName; settings.AutoHost = AutoHost; settings.HeadlessHost = HeadlessHost;
+        settings.Installations = Installations.ToList(); settings.SelectedId = SelectedInstall?.Id;
+        if (!preview) store.Save(settings);
+    }
+    private async Task ActionAsync(Func<Task> action)
+    {
+        if (preview || closing) return;
+        ShowBanner("");
+        try { await action(); }
+        catch (OperationCanceledException) { }
+        catch (Exception error) { engine.Log(error.Message); ShowBanner(error.Message); }
+        RefreshDashboard();
+    }
+    private GameInstall RequireBuild()
+    {
+        if (SelectedInstall is null) { Navigate("Library"); throw new InvalidOperationException("Add your Fortnite folder in Library first."); }
+        return SelectedInstall;
+    }
+    private void Navigate(string page)
+    {
+        PlayPage.Visibility = page == "Play" ? Visibility.Visible : Visibility.Collapsed;
+        LibraryPage.Visibility = page == "Library" ? Visibility.Visible : Visibility.Collapsed;
+        SettingsPage.Visibility = page == "Settings" ? Visibility.Visible : Visibility.Collapsed;
+        LogsPage.Visibility = page == "Logs" ? Visibility.Visible : Visibility.Collapsed;
+        PageTitle = page == "Play" ? $"Let's play, {DisplayName}." : page;
+        PageSubtitle = page switch { "Library" => "Bring your builds. Keep your favorites.", "Settings" => "A little setup. A lot of possibility.", "Logs" => "See exactly where your session is up to.", _ => "Your favorite chapters, in one place." };
+        foreach (var (button, title) in new[] { (PlayNav, "Play"), (LibraryNav, "Library"), (SettingsNav, "Settings"), (LogsNav, "Logs") })
+            button.Background = (Brush)new BrushConverter().ConvertFromString(page == title ? "#29223D" : "Transparent")!;
+        Notify(nameof(PageTitle)); Notify(nameof(PageSubtitle));
+    }
+    private void PlayNav_Click(object sender, RoutedEventArgs e) => Navigate("Play");
+    private void LibraryNav_Click(object sender, RoutedEventArgs e) => Navigate("Library");
+    private void SettingsNav_Click(object sender, RoutedEventArgs e) => Navigate("Settings");
+    private void LogsNav_Click(object sender, RoutedEventArgs e) => Navigate("Logs");
+    private async void Play_Click(object sender, RoutedEventArgs e) => await ActionAsync(async () => { Save(); await engine.PlayAsync(RequireBuild(), settings); });
+    private async void Host_Click(object sender, RoutedEventArgs e) => await ActionAsync(async () => { Save(); await engine.StartAsync(GameRole.Host, RequireBuild(), settings); });
+    private async void StopClient_Click(object sender, RoutedEventArgs e) => await ActionAsync(() => engine.StopAsync(GameRole.Client));
+    private async void StopHost_Click(object sender, RoutedEventArgs e) => await ActionAsync(() => engine.StopAsync(GameRole.Host));
+    private async void StopAll_Click(object sender, RoutedEventArgs e) => await ActionAsync(engine.StopAllAsync);
+    private async void Backend_Click(object sender, RoutedEventArgs e) => await ActionAsync(() => engine.Backend.EnsureAsync(lifetime.Token));
+    private async void SaveSettings_Click(object sender, RoutedEventArgs e) => await ActionAsync(() => { Save(); ShowBanner("Preferences saved."); return Task.CompletedTask; });
+    private async void CopyJoin_Click(object sender, RoutedEventArgs e) => await ActionAsync(() => { Clipboard.SetText("open 127.0.0.1:7777"); ShowBanner("Copied. In Fortnite's console, paste the command to join your local host."); return Task.CompletedTask; });
+    private async void Browse_Click(object sender, RoutedEventArgs e) => await ActionAsync(() =>
+    {
+        var dialog = new OpenFolderDialog { Title = "Choose your Fortnite installation", Multiselect = false };
+        if (dialog.ShowDialog(this) == true)
+        {
+            var result = Releases.Inspect(dialog.FolderName);
+            NewGamePath = result.Root; NewRelease = result.Release ?? "";
+            Notify(nameof(NewGamePath)); Notify(nameof(NewRelease));
+        }
+        return Task.CompletedTask;
+    });
+    private async void AddBuild_Click(object sender, RoutedEventArgs e) => await ActionAsync(() =>
+    {
+        var result = Releases.Inspect(NewGamePath.Trim());
+        var release = result.Release ?? NewRelease.Trim();
+        if (!Releases.Valid(release)) throw new InvalidOperationException("Enter the installed release as 19.xx-30.xx, for example 27.11.");
+        var existing = Installations.FirstOrDefault(i => string.Equals(i.Directory, result.Root, StringComparison.OrdinalIgnoreCase));
+        if (existing is not null) SelectedInstall = existing;
+        else { var item = new GameInstall(Guid.NewGuid().ToString("N"), result.Root, release); Installations.Add(item); SelectedInstall = item; }
+        Save(); ShowBanner("Build added. You're ready to launch from Play.");
+        return Task.CompletedTask;
+    });
+    private async void RemoveBuild_Click(object sender, RoutedEventArgs e) => await ActionAsync(() =>
+    {
+        if (HostBusy || ClientBusy) throw new InvalidOperationException("Stop your game instances before changing the library.");
+        if (SelectedInstall is { } install) { Installations.Remove(install); SelectedInstall = Installations.FirstOrDefault(); Save(); }
+        return Task.CompletedTask;
+    });
+    private void BuildSelection_Changed(object sender, System.Windows.Controls.SelectionChangedEventArgs e)
+    {
+        if (engine is null || preview) return;
+        try { Save(); } catch (Exception error) { ShowBanner(error.Message); }
+    }
+    private async void OpenLogs_Click(object sender, RoutedEventArgs e) => await ActionAsync(() => { Process.Start(new ProcessStartInfo("explorer.exe") { ArgumentList = { engine.LogsRoot }, UseShellExecute = true }); return Task.CompletedTask; });
+    private async void ExportLogs_Click(object sender, RoutedEventArgs e) => await ActionAsync(async () =>
+    {
+        var dialog = new SaveFileDialog { Title = "Export Emilyfn diagnostics", Filter = "ZIP archive|*.zip", FileName = $"Emilyfn-logs-{DateTime.Now:yyyyMMdd-HHmmss}.zip", OverwritePrompt = false };
+        if (dialog.ShowDialog(this) != true) return;
+        if (File.Exists(dialog.FileName)) throw new IOException("Choose a new filename for the diagnostic ZIP.");
+        await engine.ExportLogsAsync(dialog.FileName);
+        ShowBanner("Diagnostic ZIP saved.");
+    });
+    private async void Window_Closing(object? sender, CancelEventArgs e)
+    {
+        if (closing || preview) return;
+        e.Cancel = true; closing = true; lifetime.Cancel(); RefreshDashboard();
+        try
+        {
+            try { Save(); } catch (Exception error) { engine.Log(error.Message); }
+            await engine.StopAllAsync();
+        }
+        catch (Exception error) { engine.Log(error.Message); }
+        finally { Close(); }
+    }
+    public void RenderPreview(string file)
+    {
+        System.Windows.Media.RenderOptions.ProcessRenderMode = System.Windows.Interop.RenderMode.SoftwareOnly;
+        Show();
+        Dispatcher.Invoke(() => { }, DispatcherPriority.ApplicationIdle);
+        UpdateLayout();
+        var visual = (FrameworkElement)Content;
+        var image = new RenderTargetBitmap((int)visual.ActualWidth, (int)visual.ActualHeight, 96, 96, PixelFormats.Pbgra32);
+        image.Render(visual);
+        var encoder = new PngBitmapEncoder(); encoder.Frames.Add(BitmapFrame.Create(image));
+        using var stream = File.Create(file); encoder.Save(stream);
+    }
+}
