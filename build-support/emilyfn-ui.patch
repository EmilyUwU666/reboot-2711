diff --git a/launcher/assets/README.md b/launcher/assets/README.md
new file mode 100644
index 0000000..761c633
--- /dev/null
+++ b/launcher/assets/README.md
@@ -0,0 +1,10 @@
+Emilyfn permanent logo supplied by the user on 2026-09-16.
+
+Emilyfn-logo.jpg.base64 is the unmodified IMG_1228(1).jpeg encoded as text.
+Original SHA256: eed3e37042af34edb7a4d3ac7df8bdce1c496ec644ddbc8521fdd0ca78592d73
+Original dimensions: 1536 x 1536 pixels.
+
+This replaces the former illustrated mascot artwork as the default launcher logo.
+build-icon.ps1 uses the complete square artwork without cropping or added borders
+to generate seven Windows icon sizes and the in-app PNG resource. Future builds
+use this logo unless the user asks to replace it.
diff --git a/launcher/build-icon.ps1 b/launcher/build-icon.ps1
new file mode 100644
index 0000000..8da50ff
--- /dev/null
+++ b/launcher/build-icon.ps1
@@ -0,0 +1,65 @@
+param([string]$Output = "$PSScriptRoot/assets/Emilyfn.ico")
+$ErrorActionPreference = 'Stop'
+Add-Type -AssemblyName System.Drawing
+# Original user-supplied JPEG, stored as text so the source patch is self-contained.
+$bytes = [Convert]::FromBase64String([IO.File]::ReadAllText("$PSScriptRoot/assets/Emilyfn-logo.jpg.base64"))
+$hash = [Convert]::ToHexString([Security.Cryptography.SHA256]::HashData($bytes)).ToLowerInvariant()
+if ($hash -ne 'eed3e37042af34edb7a4d3ac7df8bdce1c496ec644ddbc8521fdd0ca78592d73') { throw 'The original Emilyfn logo differs from the supplied artwork.' }
+$imageStream = [IO.MemoryStream]::new($bytes, $false)
+$source = [Drawing.Bitmap]::new($imageStream)
+try {
+    # Preserve the complete permanent square artwork, including its wordmark and background.
+    $crop = [Drawing.RectangleF]::new(0,0,1536,1536)
+    if ($source.Width -ne 1536 -or $source.Height -ne 1536) { throw 'Unexpected source logo dimensions.' }
+    # Keep the largest frame first; the in-app badge also uses its own PNG resource.
+    $sizes = @(256,128,64,48,32,24,16)
+    $frames = [Collections.Generic.List[byte[]]]::new()
+    foreach ($size in $sizes) {
+        $bitmap = [Drawing.Bitmap]::new($size, $size, [Drawing.Imaging.PixelFormat]::Format32bppArgb)
+        $graphics = [Drawing.Graphics]::FromImage($bitmap)
+        $encoded = [IO.MemoryStream]::new()
+        try {
+            $graphics.Clear([Drawing.Color]::Transparent)
+            $graphics.InterpolationMode = [Drawing.Drawing2D.InterpolationMode]::HighQualityBicubic
+            $graphics.PixelOffsetMode = [Drawing.Drawing2D.PixelOffsetMode]::HighQuality
+            $scale = $size / [Math]::Max($crop.Width, $crop.Height)
+            $width = $crop.Width * $scale
+            $height = $crop.Height * $scale
+            $destination = [Drawing.RectangleF]::new(($size-$width)/2, ($size-$height)/2, $width, $height)
+            $graphics.DrawImage($source, $destination, $crop, [Drawing.GraphicsUnit]::Pixel)
+            $bitmap.Save($encoded, [Drawing.Imaging.ImageFormat]::Png)
+            $frames.Add($encoded.ToArray())
+        }
+        finally { $encoded.Dispose(); $graphics.Dispose(); $bitmap.Dispose() }
+    }
+    $null = New-Item -ItemType Directory -Force -Path (Split-Path -Parent $Output)
+    $stream = [IO.File]::Create($Output)
+    $writer = [IO.BinaryWriter]::new($stream)
+    try {
+        $writer.Write([uint16]0); $writer.Write([uint16]1); $writer.Write([uint16]$sizes.Count)
+        $offset = 6 + 16 * $sizes.Count
+        for ($i=0; $i -lt $sizes.Count; $i++) {
+            $dimension = if ($sizes[$i] -eq 256) { 0 } else { $sizes[$i] }
+            $writer.Write([byte]$dimension); $writer.Write([byte]$dimension)
+            $writer.Write([byte]0); $writer.Write([byte]0)
+            $writer.Write([uint16]1); $writer.Write([uint16]32)
+            $writer.Write([uint32]$frames[$i].Length); $writer.Write([uint32]$offset)
+            $offset += $frames[$i].Length
+        }
+        foreach ($frame in $frames) { $writer.Write([byte[]]$frame) }
+    }
+    finally { $writer.Dispose(); $stream.Dispose() }
+    $check = [Drawing.Icon]::new($Output, 32, 32)
+    try { if ($check.Width -ne 32 -or $check.Height -ne 32) { throw 'Icon validation failed.' } }
+    finally { $check.Dispose() }
+    # System.Drawing.Icon ranks the ICO directory's 0-byte width as zero, not 256.
+    # Validate the largest PNG directly and the taskbar-sized native icon above.
+    $largeStream = [IO.MemoryStream]::new($frames[0], $false)
+    $large = [Drawing.Bitmap]::new($largeStream)
+    try { if ($large.Width -ne 256 -or $large.Height -ne 256) { throw 'Large icon frame validation failed.' } }
+    finally { $large.Dispose(); $largeStream.Dispose() }
+    [IO.File]::WriteAllBytes("$PSScriptRoot/assets/Emilyfn-logo.png", $frames[0])
+    Write-Host ('EMILYFN_ICON_BASE64=' + [Convert]::ToBase64String($frames[0]))
+    Write-Host 'Emilyfn permanent logo icon built: 16, 24, 32, 48, 64, 128 and 256 pixels.'
+}
+finally { $source.Dispose(); $imageStream.Dispose() }
