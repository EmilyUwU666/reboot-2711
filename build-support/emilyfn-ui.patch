@@ -0,0 +1,30 @@
+using System.Windows;
+
+namespace Emilyfn.App;
+public partial class App : Application
+{
+    private Mutex? instance;
+    protected override void OnStartup(StartupEventArgs e)
+    {
+        base.OnStartup(e);
+        try
+        {
+            var preview = e.Args.Length == 2 && e.Args[0] == "--render-preview";
+            if (!preview)
+            {
+                instance = new Mutex(true, @"Local\Emilyfn-Launcher", out var first);
+                if (!first) { MessageBox.Show("Emilyfn is already open.", "Emilyfn"); Shutdown(); return; }
+            }
+            var window = new MainWindow(preview);
+            MainWindow = window;
+            if (preview) { window.RenderPreview(System.IO.Path.GetFullPath(e.Args[1])); window.Close(); Shutdown(); }
+            else window.Show();
+        }
+        catch (Exception error)
+        {
+            if (e.Args.Contains("--render-preview")) { System.IO.File.WriteAllText("Emilyfn-preview-error.txt", error.ToString()); Shutdown(1); }
+            else { MessageBox.Show(error.Message, "Emilyfn startup"); Shutdown(1); }
+        }
+    }
+    protected override void OnExit(ExitEventArgs e) { instance?.Dispose(); base.OnExit(e); }
+}
