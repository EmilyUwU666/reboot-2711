+param([string]$Output = "$PSScriptRoot/assets/Emilyfn.ico")
+$ErrorActionPreference = 'Stop'
+Add-Type -AssemblyName System.Drawing
+$bitmap = [System.Drawing.Bitmap]::new(256,256)
+$graphics = [System.Drawing.Graphics]::FromImage($bitmap)
+$graphics.SmoothingMode = 'AntiAlias'
+$graphics.Clear([System.Drawing.Color]::FromArgb(16,21,34))
+$rectangle = [System.Drawing.Rectangle]::new(16,16,224,224)
+$gradient = [System.Drawing.Drawing2D.LinearGradientBrush]::new($rectangle,[System.Drawing.Color]::FromArgb(172,118,255),[System.Drawing.Color]::FromArgb(98,77,220),45)
+$graphics.FillEllipse($gradient,$rectangle)
+$font = [System.Drawing.Font]::new('Segoe UI',155,[System.Drawing.FontStyle]::Bold,[System.Drawing.GraphicsUnit]::Pixel)
+$format = [System.Drawing.StringFormat]::new()
+$format.Alignment = 'Center'
+$format.LineAlignment = 'Center'
+$graphics.DrawString('E',$font,[System.Drawing.Brushes]::White,[System.Drawing.RectangleF]::new(7,0,242,247),$format)
+$icon = [System.Drawing.Icon]::FromHandle($bitmap.GetHicon())
+$null = New-Item -ItemType Directory -Force -Path (Split-Path -Parent $Output)
+$stream = [System.IO.File]::Create($Output)
+$icon.Save($stream)
+$stream.Dispose()
+$icon.Dispose()
+$format.Dispose()
+$font.Dispose()
+$gradient.Dispose()
+$graphics.Dispose()
+$bitmap.Dispose()
