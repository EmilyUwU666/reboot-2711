+        Notify(nameof(CanDetect)); Notify(nameof(CanCancelDetection)); Notify(nameof(CanDownload)); Notify(nameof(DownloadIdle)); Notify(nameof(CanEditDownloadLink));
+        DetectionStatus = "Looking for Fortnite builds…"; Notify(nameof(DetectionStatus));
+        var saved = Installations.ToArray();
+        try
+        {
+            var result = await Task.Run(() => BuildDetector.Scan(roots ?? BuildDetector.DefaultRoots(saved).ToArray(), scan.Token,
+                message => UI(() => { DetectionStatus = message; Notify(nameof(DetectionStatus)); })));
+            if (closing) return;
+            var added = 0;
+            foreach (var item in result.Builds)
+            {
+                if (Installations.Any(i => string.Equals(Path.TrimEndingDirectorySeparator(i.Directory), item.Directory, StringComparison.OrdinalIgnoreCase))) continue;
+                Installations.Add(item); added++;
+            }
+            SelectedInstall ??= Installations.FirstOrDefault();
+            if (result.Unknown.Count > 0 && string.IsNullOrWhiteSpace(NewGamePath))
+            {
+                NewGamePath = result.Unknown[0]; NewRelease = "";
+                Notify(nameof(NewGamePath)); Notify(nameof(NewRelease));
+            }
+            settings.Installations = Installations.ToList(); settings.SelectedId = SelectedInstall?.Id;
+            store.Save(settings);
+            DetectionStatus = $"{added} new build(s) added · {result.Builds.Count} supported build(s) found";
+            if (result.Unknown.Count > 0) DetectionStatus += $" · {result.Unknown.Count} need a release number";
+            if (result.Incomplete) DetectionStatus += " · scan stopped; you can scan a smaller folder";
+            Notify(nameof(DetectionStatus)); engine.Log(DetectionStatus);
+        }
+        finally
+        {
+            detection = null; scan.Dispose();
+            Notify(nameof(CanDetect)); Notify(nameof(CanCancelDetection)); Notify(nameof(CanDownload)); Notify(nameof(DownloadIdle)); Notify(nameof(CanEditDownloadLink));
+        }
+    }
+    private async void DownloadFolder_Click(object sender, RoutedEventArgs e) => await ActionAsync(() =>
+    {
+        var dialog = new OpenFolderDialog { Title = "Choose where to install downloaded builds", Multiselect = false };
+        if (dialog.ShowDialog(this) == true) { DownloadFolder = dialog.FolderName; Notify(nameof(DownloadFolder)); }
+        return Task.CompletedTask;
+    });
+    private async void CatalogSource_Click(object sender, RoutedEventArgs e) => await ActionAsync(() => { Process.Start(new ProcessStartInfo(BuildCatalog.Credits) { UseShellExecute = true }); return Task.CompletedTask; });
+    private void CancelDownload_Click(object sender, RoutedEventArgs e) => download?.Cancel();
+    private async void DownloadBuild_Click(object sender, RoutedEventArgs e) => await ActionAsync(async () =>
+    {
+        if (!CanDownload) return;
+        download = CancellationTokenSource.CreateLinkedTokenSource(lifetime.Token);
+        downloadTask = DownloadCoreAsync(download);
+        await downloadTask;
+    });
+    private async Task DownloadCoreAsync(CancellationTokenSource cancellation)
+    {
+        var url = DownloadUrl.Trim(); var folder = DownloadFolder.Trim(); var release = DownloadRelease.Trim(); var checksum = DownloadChecksum.Trim();
+        Notify(nameof(CanDownload)); Notify(nameof(DownloadIdle)); Notify(nameof(CanEditDownloadLink)); Notify(nameof(CanCancelDownload)); Notify(nameof(CanDetect));
+        DownloadPercent = 0; DownloadIndeterminate = true; DownloadStatus = "Preparing download…";
+        Notify(nameof(DownloadPercent)); Notify(nameof(DownloadIndeterminate)); Notify(nameof(DownloadStatus));
+        var progress = new Progress<DownloadProgress>(state =>
+        {
+            if (download != cancellation || closing) return;
+            DownloadStatus = state.Label; DownloadPercent = state.Percent; DownloadIndeterminate = state.Total is null;
+            Notify(nameof(DownloadStatus)); Notify(nameof(DownloadPercent)); Notify(nameof(DownloadIndeterminate));
+        });
+        try
+        {
+            using var downloader = new BuildDownloader();
+            var catalog = SelectedCatalog;
+            var install = await Task.Run(() => catalog.BrowserDownload
+                ? downloader.InstallWithProviderAsync(folder, release, checksum,
+                    (file, ct) => Dispatcher.InvokeAsync(() => FortForgeDownloadWindow.AcquireAsync(this, url, file, progress, ct)).Task.Unwrap(), progress, cancellation.Token)
+                : downloader.InstallAsync(url, folder, release, checksum, progress, cancellation.Token));
+            Installations.Add(install);
+            if (!HostBusy && !ClientBusy) SelectedInstall = install;
+            settings.Installations = Installations.ToList(); settings.SelectedId = SelectedInstall?.Id;
+            store.Save(settings);
+            DownloadPercent = 100; DownloadStatus = $"Fortnite {install.Release} installed and added to Library.";
+            if (SelectedCatalog.Custom) { DownloadUrl = ""; Notify(nameof(DownloadUrl)); }
+            engine.Log(DownloadStatus);
+        }
+        catch (OperationCanceledException) { DownloadStatus = "Download cancelled. Temporary files removed; retry starts from the beginning."; }
+        catch (Exception error) { DownloadStatus = "Download failed: " + error.Message; throw; }
+        finally
+        {
+            download = null; cancellation.Dispose(); DownloadIndeterminate = false;
+            foreach (var property in new[] { nameof(CanDownload), nameof(CanCancelDownload), nameof(DownloadIdle), nameof(CanEditDownloadLink), nameof(CanDetect), nameof(DownloadIndeterminate), nameof(DownloadStatus), nameof(DownloadPercent) }) Notify(property);
+        }
+    }
+    public void RenderPreview(string file)
+    {
+        System.Windows.Media.RenderOptions.ProcessRenderMode = System.Windows.Interop.RenderMode.SoftwareOnly;
+        Show();
+        foreach (var page in new[] { "Play", "Library", "Settings" })
+        {
+            Navigate(page);
+            Dispatcher.Invoke(() => { }, DispatcherPriority.ApplicationIdle);
+            UpdateLayout();
+            var visual = (FrameworkElement)Content;
+            var bitmap = new RenderTargetBitmap((int)visual.ActualWidth, (int)visual.ActualHeight, 96, 96, PixelFormats.Pbgra32);
+            bitmap.Render(visual);
+            var encoder = new PngBitmapEncoder(); encoder.Frames.Add(BitmapFrame.Create(bitmap));
+            var output = page == "Play" ? file : Path.Combine(Path.GetDirectoryName(file)!, Path.GetFileNameWithoutExtension(file) + "-" + page + ".png");
+            using var stream = File.Create(output); encoder.Save(stream);
+        }
+        Navigate("Play");
+    }
+}
