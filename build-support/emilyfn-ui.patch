diff --git a/launcher/Emilyfn.App/FortForgeDownloadWindow.cs b/launcher/Emilyfn.App/FortForgeDownloadWindow.cs
new file mode 100644
index 0000000..eb5bb29
--- /dev/null
+++ b/launcher/Emilyfn.App/FortForgeDownloadWindow.cs
@@ -0,0 +1,108 @@
+using Emilyfn.Core;
+using Microsoft.Web.WebView2.Core;
+using Microsoft.Web.WebView2.Wpf;
+using System.Diagnostics;
+using System.IO;
+using System.Windows;
+using System.Windows.Controls;
+using System.Windows.Media;
+using System.Windows.Threading;
+
+namespace Emilyfn.App;
+
+/// <summary>Uses FortForge's normal public page and queue; never caches temporary download URLs.</summary>
+public sealed class FortForgeDownloadWindow : Window
+{
+    public static async Task AcquireAsync(Window owner, string page, string destination, IProgress<DownloadProgress>? progress, CancellationToken token)
+    {
+        var uri = BuildDownloader.ValidateUrl(page);
+        if (uri.Host != "www.fortforge.co.uk" || !uri.AbsolutePath.StartsWith("/builds/", StringComparison.Ordinal)) throw new ArgumentException("Choose a FortForge build from the catalog.");
+        token.ThrowIfCancellationRequested();
+        var window = new FortForgeDownloadWindow { Owner = owner, Icon = owner.Icon, Title = "Emilyfn · FortForge download", Width = 960, Height = 720, Background = new SolidColorBrush(Color.FromRgb(13, 17, 28)), WindowStartupLocation = WindowStartupLocation.CenterOwner };
+        var web = new WebView2();
+        var panel = new DockPanel();
+        var caption = new TextBlock { Text = "FortForge manages the download queue. If needed, click Download Build below. Close this window to cancel.", TextWrapping = TextWrapping.Wrap, Margin = new Thickness(14), Foreground = Brushes.White };
+        DockPanel.SetDock(caption, Dock.Top); panel.Children.Add(caption); panel.Children.Add(web); window.Content = panel;
+        var done = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
+        CoreWebView2DownloadOperation? operation = null;
+        var timer = new DispatcherTimer { Interval = TimeSpan.FromMilliseconds(500) };
+        var clock = Stopwatch.StartNew();
+        void Cancel() { try { operation?.Cancel(); } catch { } done.TrySetCanceled(token.IsCancellationRequested ? token : new CancellationToken(true)); }
+        window.Closed += (_, _) => Cancel();
+        using var cancellation = token.Register(() => window.Dispatcher.BeginInvoke(new Action(Cancel)));
+        try
+        {
+            window.Show();
+            var profile = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData), "Emilyfn", "FortForge-browser");
+            CoreWebView2Environment environment;
+            try { environment = await CoreWebView2Environment.CreateAsync(userDataFolder: profile); }
+            catch (WebView2RuntimeNotFoundException) { throw new IOException("FortForge downloads need Microsoft Edge WebView2 Runtime. Install it from https://developer.microsoft.com/microsoft-edge/webview2 and retry."); }
+            token.ThrowIfCancellationRequested();
+            if (done.Task.IsCompleted) await done.Task;
+            await web.EnsureCoreWebView2Async(environment);
+            if (done.Task.IsCompleted) await done.Task;
+            var core = web.CoreWebView2;
+            core.Settings.AreDevToolsEnabled = false;
+            core.Settings.AreDefaultContextMenusEnabled = false;
+            core.Settings.IsWebMessageEnabled = false;
+            core.Settings.IsPasswordAutosaveEnabled = false;
+            core.Settings.IsGeneralAutofillEnabled = false;
+            core.PermissionRequested += (_, e) => e.State = CoreWebView2PermissionState.Deny;
+            bool Allowed(string address) => Uri.TryCreate(address, UriKind.Absolute, out var target) && target.Scheme == "https" && (target.Host == "fortforge.co.uk" || target.Host.EndsWith(".fortforge.co.uk", StringComparison.OrdinalIgnoreCase));
+            core.NavigationStarting += (_, e) => { if (!Allowed(e.Uri)) { e.Cancel = true; caption.Text = "This window only opens FortForge pages. Close it to cancel."; } };
+            core.NewWindowRequested += (_, e) => { e.Handled = true; if (Allowed(e.Uri)) core.Navigate(e.Uri); };
+            core.ProcessFailed += (_, _) => done.TrySetException(new IOException("The download browser stopped unexpectedly. Retry the download."));
+            bool clicked = false;
+            core.NavigationCompleted += async (_, e) =>
+            {
+                if (!e.IsSuccess) { caption.Text = "FortForge could not load. Close this window and retry later."; return; }
+                if (!clicked && core.Source == page)
+                {
+                    clicked = true;
+                    try { await core.ExecuteScriptAsync("Array.from(document.querySelectorAll('button')).find(b => b.textContent.trim().startsWith('Download Build'))?.click();"); }
+                    catch { caption.Text = "Click Download Build to continue."; }
+                }
+            };
+            core.DownloadStarting += (_, e) =>
+            {
+                try
+                {
+                if (operation is not null || !Path.GetExtension(e.ResultFilePath).Equals(".zip", StringComparison.OrdinalIgnoreCase) || !Uri.TryCreate(e.DownloadOperation.Uri, UriKind.Absolute, out var downloadUri) || downloadUri.Scheme != "https")
+                {
+                    e.Cancel = true;
+                    if (operation is null) done.TrySetException(new IOException("This FortForge download is not a HTTPS ZIP. RAR, 7z and split archives are not supported yet."));
+                    return;
+                }
+                operation = e.DownloadOperation;
+                if (operation.TotalBytesToReceive > 512UL * 1024 * 1024 * 1024) { e.Cancel = true; done.TrySetException(new IOException("The download exceeds the 512 GiB limit.")); return; }
+                var drive = new DriveInfo(Path.GetPathRoot(destination)!);
+                if (drive.AvailableFreeSpace < checked((long)(operation.TotalBytesToReceive ?? 0)) + 256L * 1024 * 1024) { e.Cancel = true; done.TrySetException(new IOException("Not enough free disk space for the download.")); return; }
+                e.ResultFilePath = destination; e.Handled = true;
+                clock.Restart(); caption.Text = "Downloading into Emilyfn. Keep this window open; installation follows automatically.";
+                operation.StateChanged += (_, _) =>
+                {
+                    if (operation.State == CoreWebView2DownloadState.Completed) done.TrySetResult();
+                    else if (operation.State == CoreWebView2DownloadState.Interrupted) done.TrySetException(new IOException($"FortForge download interrupted ({operation.InterruptReason}). Retry from Library."));
+                };
+                }
+                catch (Exception) { e.Cancel = true; done.TrySetException(new IOException("Could not prepare the FortForge download. Check the installation folder and free space.")); }
+            };
+            timer.Tick += (_, _) =>
+            {
+                if (operation is null) { progress?.Report(new("Waiting for FortForge queue", 0, null)); return; }
+                if (operation.State != CoreWebView2DownloadState.InProgress) return;
+                if (operation.BytesReceived > 512L * 1024 * 1024 * 1024) { done.TrySetException(new IOException("Download exceeds the 512 GiB limit.")); operation.Cancel(); return; }
+                var state = new DownloadProgress("Downloading from FortForge", checked((long)operation.BytesReceived), operation.TotalBytesToReceive > 0 ? checked((long)operation.TotalBytesToReceive.Value) : null, operation.BytesReceived / Math.Max(.001, clock.Elapsed.TotalSeconds));
+                caption.Text = state.Label + " · Close to cancel"; progress?.Report(state);
+            };
+            timer.Start(); core.Navigate(page);
+            await done.Task;
+        }
+        finally
+        {
+            timer.Stop();
+            try { if (operation?.State == CoreWebView2DownloadState.InProgress) operation.Cancel(); } catch { }
+            web.Dispose(); window.Close();
+        }
+    }
+}
