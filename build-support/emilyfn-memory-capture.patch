+using Microsoft.Win32.SafeHandles;
+using System.ComponentModel;
+using System.Diagnostics;
+using System.Runtime.InteropServices;
+using System.Security.Cryptography;
+using System.Text.Json;
+
+namespace Emilyfn.Core;
+
+public sealed record CaptureTarget(int Id, DateTime StartedUtc, string Executable)
+{
+    public string Label => $"PID {Id} — {Executable}";
+}
+
+public static class GameMemoryCapture
+{
+    private static readonly SemaphoreSlim Gate = new(1, 1);
+    public static IReadOnlyList<CaptureTarget> FindTargets()
+    {
+        var targets = new List<CaptureTarget>();
+        foreach (var process in Process.GetProcessesByName("FortniteClient-Win64-Shipping"))
+        {
+            using (process)
+                try { targets.Add(new(process.Id, process.StartTime.ToUniversalTime(), process.MainModule!.FileName)); }
+                catch (Exception e) when (e is Win32Exception or InvalidOperationException or NotSupportedException) { }
+        }
+        return targets.OrderBy(t => t.Id).ToArray();
+    }
+
+    public static async Task<string> CaptureAsync(CaptureTarget target, string parent, IProgress<string>? progress = null)
+    {
+        if (!OperatingSystem.IsWindows() || !Environment.Is64BitProcess)
+            throw new PlatformNotSupportedException("Capture requires the Windows x64 launcher.");
+        if (!await Gate.WaitAsync(0)) throw new InvalidOperationException("A memory capture is already running.");
+        try { return await Task.Run(() => Capture(target, parent, progress)); }
+        finally { Gate.Release(); }
+    }
+
+    private static string Capture(CaptureTarget target, string parent, IProgress<string>? progress)
+    {
+        using var process = Process.GetProcessById(target.Id);
+        // Acquire a handle before validating identity so PID reuse cannot redirect the capture.
+        using var handle = OpenProcess(0x0400 | 0x0010, false, target.Id);
+        if (handle.IsInvalid) throw new Win32Exception(Marshal.GetLastWin32Error(), "Windows could not open this game for capture.");
+        if (process.HasExited || process.StartTime.ToUniversalTime() != target.StartedUtc ||
+            !string.Equals(process.ProcessName, "FortniteClient-Win64-Shipping", StringComparison.OrdinalIgnoreCase) ||
+            !string.Equals(process.MainModule?.FileName, target.Executable, StringComparison.OrdinalIgnoreCase))
+            throw new InvalidOperationException("The selected game exited or changed. Refresh the process list.");
+        // Verify creation time against the actual native handle as well.
+        if (!GetProcessTimes(handle, out long created, out _, out _, out _) ||
+            DateTime.FromFileTimeUtc(created) != target.StartedUtc)
+            throw new InvalidOperationException("The selected game changed before capture.");
+        var folder = Path.Combine(Path.GetFullPath(parent), $"Emilyfn-memory-{DateTime.UtcNow:yyyyMMdd-HHmmss}-{Guid.NewGuid():N}");
+        Directory.CreateDirectory(folder);
+        var partial = Path.Combine(folder, "game.dmp.partial");
+        try
+        {
+            progress?.Report("Recording build and module details…");
+            var modules = process.Modules.Cast<ProcessModule>().Select(m => new {
+                Name = m.ModuleName, Path = m.FileName, BaseAddress = $"0x{m.BaseAddress.ToInt64():X}", Size = m.ModuleMemorySize
+            }).ToArray();
+            var version = FileVersionInfo.GetVersionInfo(target.Executable);
+            using var executable = File.OpenRead(target.Executable);
+            var hash = Convert.ToHexString(SHA256.HashData(executable)).ToLowerInvariant();
+            File.WriteAllText(Path.Combine(folder, "capture.json"), JsonSerializer.Serialize(new {
+                FormatVersion = 1, CapturedUtc = DateTime.UtcNow, target.Id, target.StartedUtc,
+                target.Executable, version.FileVersion, version.ProductVersion, ExecutableSha256 = hash,
+                DumpFlags = "0x1822: FullMemory, FullMemoryInfo, ThreadInfo, UnloadedModules",
+                Modules = modules, Note = "Live process capture; not a decoded SDK or an atomic snapshot."
+            }, new JsonSerializerOptions { WriteIndented = true }));
+            File.WriteAllText(Path.Combine(folder, "README.txt"),
+                "Emilyfn runtime capture\r\n" +
+                "game.dmp contains full accessible game memory, modules and thread information.\r\n" +
+                "capture.json identifies the executable SHA-256 and module addresses.\r\n" +
+                "Capture while the game is initialized (lobby or the stuck screen), before closing it.\r\n" +
+                "This is raw runtime evidence, not generated SDK headers or proof of build support.\r\n" +
+                "Memory may contain credentials and personal data. Keep private; nothing is uploaded automatically.\r\n");
+            progress?.Report("Capturing game memory… This may take several minutes and several GB.");
+            using (var file = new FileStream(partial, FileMode.CreateNew, FileAccess.ReadWrite, FileShare.None))
+            {
+                if (!MiniDumpWriteDump(handle, (uint)target.Id, file.SafeFileHandle, 0x1822, IntPtr.Zero, IntPtr.Zero, IntPtr.Zero))
+                {
+                    int error = Marshal.GetLastWin32Error();
+                    throw new IOException($"Memory capture failed (0x{error:X8}). The game must stay running and Windows must allow memory access. Check free disk space.", Marshal.GetExceptionForHR(error));
+                }
+                file.Flush(true);
+                file.Position = 0;
+                using var reader = new BinaryReader(file, System.Text.Encoding.UTF8, leaveOpen: true);
+                if (file.Length < 32 || reader.ReadUInt32() != 0x504d444d)
+                    throw new IOException("Windows returned an invalid memory dump.");
+            }
+            File.Move(partial, Path.Combine(folder, "game.dmp"));
+            progress?.Report("Memory capture saved.");
+            return folder;
+        }
+        catch
+        {
+            // Remove only this operation's incomplete dump; preserve diagnostics about the attempt.
+            if (File.Exists(partial)) File.Delete(partial);
+            File.WriteAllText(Path.Combine(folder, "CAPTURE-FAILED.txt"), "Capture did not complete. No valid game.dmp was produced. Retry while the game is running.");
+            throw;
+        }
+    }
+
+    [DllImport("kernel32.dll", SetLastError = true)]
+    private static extern SafeProcessHandle OpenProcess(uint access, [MarshalAs(UnmanagedType.Bool)] bool inherit, int pid);
+    [DllImport("kernel32.dll", SetLastError = true)]
+    [return: MarshalAs(UnmanagedType.Bool)]
+    private static extern bool GetProcessTimes(SafeProcessHandle process, out long creation, out long exit, out long kernel, out long user);
+    [DllImport("dbghelp.dll", SetLastError = true)]
+    [DefaultDllImportSearchPaths(DllImportSearchPath.System32)]
+    [return: MarshalAs(UnmanagedType.Bool)]
+    private static extern bool MiniDumpWriteDump(SafeProcessHandle process, uint pid, SafeFileHandle file, uint flags, IntPtr exception, IntPtr streams, IntPtr callback);
+}
