+using Emilyfn.Core;
+using System.Diagnostics;
+using System.Text.Json;
+
+var root = Path.Combine(Path.GetTempPath(), "Emilyfn capture " + Guid.NewGuid().ToString("N"));
+Directory.CreateDirectory(root);
+Process? child = null;
+int checks = 0;
+void Check(bool ok, string message) { if (!ok) throw new Exception(message); checks++; }
+try
+{
+    var exe = Path.Combine(root, "FortniteClient-Win64-Shipping.exe");
+    File.Copy(Path.GetFullPath(args[0]), exe);
+    child = Process.Start(new ProcessStartInfo(exe) { UseShellExecute = false })!;
+    CaptureTarget? target = null;
+    for (int i = 0; i < 100 && target is null; i++)
+    {
+        target = GameMemoryCapture.FindTargets().SingleOrDefault(t => t.Id == child.Id);
+        if (target is null) await Task.Delay(100);
+    }
+    Check(target is not null, "Running target discovered");
+    bool rejected = false;
+    try { await GameMemoryCapture.CaptureAsync(target! with { StartedUtc = DateTime.MinValue }, root); }
+    catch (InvalidOperationException) { rejected = true; }
+    Check(rejected, "Stale identity rejected");
+    var folder = await GameMemoryCapture.CaptureAsync(target!, root);
+    using var manifest = JsonDocument.Parse(File.ReadAllText(Path.Combine(folder, "capture.json")));
+    Check(manifest.RootElement.GetProperty("Id").GetInt32() == child.Id, "Manifest identifies selected process");
+    Check(manifest.RootElement.GetProperty("ExecutableSha256").GetString()!.Length == 64, "Executable hash recorded");
+    using (var file = File.OpenRead(Path.Combine(folder, "game.dmp")))
+    using (var reader = new BinaryReader(file))
+    {
+        Check(reader.ReadUInt32() == 0x504d444d, "Dump signature");
+        reader.ReadUInt32(); uint count = reader.ReadUInt32(), directory = reader.ReadUInt32();
+        var streams = new HashSet<uint>();
+        for (uint i = 0; i < count; i++) { file.Position = directory + i * 12; streams.Add(reader.ReadUInt32()); }
+        Check(streams.Contains(9), "Full memory stream present");
+        Check(streams.Contains(4), "Module stream present");
+        Check(streams.Contains(16), "Memory region information present");
+    }
+    Check(!Directory.EnumerateFiles(folder, "*.partial").Any(), "No partial output on success");
+    Check(!child.HasExited, "Capture leaves target running");
+    child.Kill(); child.WaitForExit();
+    rejected = false;
+    try { await GameMemoryCapture.CaptureAsync(target!, root); } catch (Exception e) when (e is ArgumentException or InvalidOperationException or System.ComponentModel.Win32Exception) { rejected = true; }
+    Check(rejected, "Exited process rejected");
+    Console.WriteLine($"CAPTURE TESTS: {checks} checks passed (real Windows memory dump of synthetic child).");
+}
+finally
+{
+    if (child is not null) { if (!child.HasExited) { child.Kill(); child.WaitForExit(); } child.Dispose(); }
+    Directory.Delete(root, true);
+}
