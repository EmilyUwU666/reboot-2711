+using Emilyfn.Core;
+using Microsoft.Win32;
+using System.Diagnostics;
+using System.Windows;
+using System.Windows.Controls;
+
+namespace Emilyfn.App;
+
+public sealed class MemoryCaptureWindow : Window
+{
+    private readonly ComboBox targets = new() { Margin = new Thickness(0, 12, 0, 12), DisplayMemberPath = "Label" };
+    private readonly TextBlock status = new() { TextWrapping = TextWrapping.Wrap, Margin = new Thickness(0, 12, 0, 0) };
+    private readonly Button capture = new() { Content = "Choose folder and capture", Margin = new Thickness(0, 0, 12, 0) };
+    private readonly Button refresh = new() { Content = "Refresh" };
+    private readonly Func<string, Task> exportLogs;
+    private bool busy;
+
+    public MemoryCaptureWindow(Func<string, Task> exportLogs)
+    {
+        this.exportLogs = exportLogs;
+        Title = "Emilyfn — Capture game memory"; Width = 720; Height = 370;
+        WindowStartupLocation = WindowStartupLocation.CenterOwner;
+        var panel = new StackPanel { Margin = new Thickness(24) };
+        panel.Children.Add(new TextBlock { Text = "Select the running game to capture", FontSize = 20 });
+        panel.Children.Add(new TextBlock { Text = "Keep Fortnite open at the lobby or stuck screen. This saves full game memory locally and may take several GB. Memory can contain session credentials; keep the files private. Nothing is uploaded automatically.", TextWrapping = TextWrapping.Wrap, Margin = new Thickness(0, 12, 0, 0) });
+        panel.Children.Add(targets);
+        var buttons = new StackPanel { Orientation = Orientation.Horizontal };
+        buttons.Children.Add(capture); buttons.Children.Add(refresh); panel.Children.Add(buttons); panel.Children.Add(status);
+        Content = panel;
+        refresh.Click += (_, _) => Refresh();
+        capture.Click += async (_, _) => await Capture();
+        Closing += (_, e) => { if (busy) { e.Cancel = true; status.Text = "Please wait for the capture to finish before closing this window."; } };
+        Refresh();
+    }
+    private void Refresh()
+    {
+        try
+        {
+            var found = GameMemoryCapture.FindTargets(); targets.ItemsSource = found;
+            targets.SelectedIndex = found.Count == 1 ? 0 : -1;
+            capture.IsEnabled = found.Count > 0;
+            status.Text = found.Count == 0 ? "No accessible Fortnite game found. Start the game first, then refresh." : "Choose the client or host PID you want to capture.";
+        }
+        catch (Exception error) { status.Text = error.Message; capture.IsEnabled = false; }
+    }
+    private async Task Capture()
+    {
+        if (targets.SelectedItem is not CaptureTarget target) { status.Text = "Select a game process first."; return; }
+        var dialog = new OpenFolderDialog { Title = "Choose a folder with space for a full memory dump" };
+        if (dialog.ShowDialog(this) != true) return;
+        busy = true; capture.IsEnabled = refresh.IsEnabled = targets.IsEnabled = false;
+        try
+        {
+            var folder = await GameMemoryCapture.CaptureAsync(target, dialog.FolderName, new Progress<string>(s => status.Text = s));
+            string logStatus = "Logs included.";
+            try { await exportLogs(System.IO.Path.Combine(folder, "launcher-logs.zip")); }
+            catch (Exception error) { logStatus = "Memory saved, but log export failed: " + error.Message; }
+            status.Text = $"Saved to {folder}. {logStatus}";
+            try { Process.Start(new ProcessStartInfo("explorer.exe") { UseShellExecute = true, ArgumentList = { folder } }); }
+            catch { /* Saved files remain usable if Explorer is unavailable. */ }
+        }
+        catch (Exception error) { status.Text = error.Message; }
+        finally { busy = false; capture.IsEnabled = refresh.IsEnabled = targets.IsEnabled = true; }
+    }
+}
