diff --git a/tests/reflection38_tests.cpp b/tests/reflection38_tests.cpp
new file mode 100644
index 0000000..9c33c41
--- /dev/null
+++ b/tests/reflection38_tests.cpp
@@ -0,0 +1,54 @@
+#include "../Reboot2711/Reflection38.h"
+#include <fstream>
+#include <iterator>
+#include <iostream>
+#include <stdexcept>
+#include <vector>
+using namespace Reboot2711;
+int main(int argc, char** argv)
+{
+    int checks = 0;
+    const auto check = [&](bool ok) { ++checks; if (!ok) throw std::runtime_error("reflection check failed"); };
+    auto build = *ParseBuildVersion(L"5.7.0-47722112+++Fortnite+Release-38.00");
+    std::vector<std::uint8_t> image(0x93bdf82, 0);
+    const std::uint8_t fixture0[] = { 0x4c, 0x8b, 0x87, 0x88, 0x00, 0x00, 0x00, 0x49, 0x8b, 0x40, 0x10, 0x48, 0x89, 0xc1, 0x48, 0x83, 0xe1, 0xfe, 0x48, 0xba, 0x38, 0xec, 0x15, 0x3f, 0x17, 0xc0, 0xdc, 0x47, 0x48, 0x31, 0xca, 0xa8, 0x01, 0x48, 0x0f, 0x44, 0xd0, 0x48, 0x89, 0x97, 0x88, 0x00, 0x00, 0x00, 0x48, 0x8d, 0x54, 0x24, 0x48, 0x48, 0x89, 0xf9, 0xe8, 0x8c, 0xc9, 0xe4, 0x04 };
+    std::memcpy(image.data()+0x45714e1, fixture0, sizeof(fixture0));
+    const std::uint8_t fixture1[] = { 0x48, 0x63, 0x47, 0x3c, 0x48, 0x35, 0x6b, 0x71, 0x45, 0xf0, 0x48, 0x01, 0xd8 };
+    std::memcpy(image.data()+0x93bdf1d, fixture1, sizeof(fixture1));
+    const std::uint8_t fixture2[] = { 0x48, 0x63, 0x47, 0x28, 0x48, 0x35, 0x4b, 0x7e, 0x68, 0xaf };
+    std::memcpy(image.data()+0x93bdf78, fixture2, sizeof(fixture2));
+    auto profile = Reflection38::Verify(build, image.data(), image.size());
+    check(profile.has_value());
+    check(!Reflection38::Verify(build, nullptr, image.size()));
+    check(!Reflection38::Verify(build, image.data(), 10));
+    auto wrong = build; wrong.Changelist++;
+    check(!Reflection38::Verify(wrong, image.data(), image.size()));
+    wrong = build; wrong.Season = 37;
+    check(!Reflection38::Verify(wrong, image.data(), image.size()));
+    wrong = build; wrong.ReleaseMinor = 10;
+    check(!Reflection38::Verify(wrong, image.data(), image.size()));
+    wrong = build; wrong.EngineMinor = 6;
+    check(!Reflection38::Verify(wrong, image.data(), image.size()));
+    for (auto at : {0x45714e1u, 0x93bdf1du, 0x93bdf78u})
+    {
+        image[at] ^= 1;
+        check(!Reflection38::Verify(build, image.data(), image.size()));
+        image[at] ^= 1;
+    }
+    check(profile->DecodeFieldLink(0) == 0);
+    check(profile->DecodeFieldLink(0x1000) == 0x1000);
+    check(profile->DecodeFieldLink(0x47dcc0173f15ec39ull) == 0);
+    check(profile->DecodeFieldLink(0x47dcc0173f15fc39ull) == 0x1000);
+    check(profile->DecodePropertyOffset(0xf045716bu) == 0);
+    check(profile->DecodePropertyOffset(0xf045726bu) == 0x300);
+    check(profile->DecodeElementSize(0xaf687e4bu) == 0);
+    check(profile->DecodeElementSize(0xaf687e43u) == 8);
+    if (argc == 2)
+    {
+        std::ifstream stream(argv[1], std::ios::binary);
+        std::vector<std::uint8_t> actual((std::istreambuf_iterator<char>(stream)), {});
+        check(actual.size() == 411324416);
+        check(Reflection38::Verify(build, actual.data(), actual.size()).has_value());
+    }
+    std::cout << checks << " reflection primitive checks passed; gameplay not exercised.\n";
+}
