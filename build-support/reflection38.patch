diff --git a/REFLECTION38-PORT.md b/REFLECTION38-PORT.md
new file mode 100644
index 0000000..3b5d0c0
--- /dev/null
+++ b/REFLECTION38-PORT.md
@@ -0,0 +1,33 @@
+# 38.00 reflection primitives port
+
+Build identity: Fortnite 38.00 CL47722112, engine 5.7, supplied executable SHA256
+f4ddac1044edd0e8cc123f586f7204de8724989b6adcf25b2e34b4855747a5c0.
+
+This patch ports three verified operations into the SDK accessors:
+- FField next-link reads at 0x10 with conditional tagged-pointer decoding.
+- FProperty offset reads at 0x3c with 32-bit decoding.
+- FProperty element-size reads at 0x28 with 32-bit decoding.
+
+All property lookups and parameter-marshalling offset/element-size reads share
+the new helpers. Old releases keep their existing reads. Modern selection checks
+release, changelist, engine and three exact instruction anchors before accepting
+the primitives; other images fail closed. A changed instruction or mismatched
+build is not accepted merely because its label says 38.00.
+
+Evidence comes from the execConv_NameToString compiled-parameter path and its
+StepExplicitProperty call, confirmed independently in execGetObjectName. The
+StepExplicitProperty disassembly shows both decoded offset and decoded element
+size being used to address/copy property data. No access-control mechanism or
+anti-cheat component is modified.
+
+This is an incomplete port, not a playable release. Initialization still stops
+before gameplay hooks on 38.00. The exact failure distinguishes rejected identity
+from verified primitives with remaining bindings. UObject registry/layout,
+FField name/class/flags, function dispatch, allocation, networking and server
+hooks are not all validated. A separate GetObjectName trace reads UObject's name
+at 0x20; the legacy UObject layout must not be assumed compatible.
+
+Tests cover exact-image acceptance, each anchor mutation, wrong CL/release/engine,
+truncation, null/plain/tagged links and decoded scalar values. Portable actual-file
+checks do not execute game functions; Windows CI checks compilation and fixtures,
+not host startup, client join, replication, LEGO or Festival gameplay.
diff --git a/Reboot2711/Reflection38.h b/Reboot2711/Reflection38.h
new file mode 100644
index 0000000..c61c6df
--- /dev/null
+++ b/Reboot2711/Reflection38.h
@@ -0,0 +1,44 @@
+#pragma once
+#include "BuildVersion.h"
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <optional>
+
+namespace Reboot2711
+{
+    // Exact-image reflection primitives, not a complete supported runtime profile.
+    // Only construction through Verify prevents enabling these keys for another CL.
+    class Reflection38
+    {
+        Reflection38() = default;
+    public:
+        static std::optional<Reflection38> Verify(const BuildVersion& build,
+            const std::uint8_t* image, std::size_t size)
+        {
+            if (build.Season != 38 || build.ReleaseMinor != 0 || build.Changelist != 47722112
+                || build.EngineMajor != 5 || build.EngineMinor != 7 || !image)
+                return std::nullopt;
+            const auto matches = [&](std::size_t rva, const std::uint8_t* bytes, std::size_t count)
+            {
+                return rva <= size && count <= size - rva && std::memcmp(image + rva, bytes, count) == 0;
+            };
+        static constexpr std::uint8_t anchor0[] = { 0x4c, 0x8b, 0x87, 0x88, 0x00, 0x00, 0x00, 0x49, 0x8b, 0x40, 0x10, 0x48, 0x89, 0xc1, 0x48, 0x83, 0xe1, 0xfe, 0x48, 0xba, 0x38, 0xec, 0x15, 0x3f, 0x17, 0xc0, 0xdc, 0x47, 0x48, 0x31, 0xca, 0xa8, 0x01, 0x48, 0x0f, 0x44, 0xd0, 0x48, 0x89, 0x97, 0x88, 0x00, 0x00, 0x00, 0x48, 0x8d, 0x54, 0x24, 0x48, 0x48, 0x89, 0xf9, 0xe8, 0x8c, 0xc9, 0xe4, 0x04 };
+        static constexpr std::uint8_t anchor1[] = { 0x48, 0x63, 0x47, 0x3c, 0x48, 0x35, 0x6b, 0x71, 0x45, 0xf0, 0x48, 0x01, 0xd8 };
+        static constexpr std::uint8_t anchor2[] = { 0x48, 0x63, 0x47, 0x28, 0x48, 0x35, 0x4b, 0x7e, 0x68, 0xaf };
+        if (!matches(0x45714e1, anchor0, sizeof(anchor0))) return std::nullopt;
+        if (!matches(0x93bdf1d, anchor1, sizeof(anchor1))) return std::nullopt;
+        if (!matches(0x93bdf78, anchor2, sizeof(anchor2))) return std::nullopt;
+            return Reflection38{};
+        }
+        std::uint64_t DecodeFieldLink(std::uint64_t stored) const
+        {
+            return (stored & 1) ? ((stored & ~std::uint64_t{1}) ^ 0x47dcc0173f15ec38ull) : stored;
+        }
+        std::uint32_t DecodePropertyOffset(std::uint32_t stored) const { return stored ^ 0xf045716bu; }
+        std::uint32_t DecodeElementSize(std::uint32_t stored) const { return stored ^ 0xaf687e4bu; }
+        static constexpr std::size_t FieldNextOffset = 0x10;
+        static constexpr std::size_t PropertyOffsetOffset = 0x3c;
+        static constexpr std::size_t ElementSizeOffset = 0x28;
+    };
+}
