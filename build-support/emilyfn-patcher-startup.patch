+        var vtable=Alloc(vt,0x58);Q(vtable,0x10,image+0x8b84524);Q(vtable,0x40,image+0x70f7664);Q(vtable,0x50,image+0x1a38c0);
+        var state=Alloc(screen,0x200);Q(state,0,vt);state[0x63]=1;D(state,0x1f8,2);
+        F(state,0x188,0.25f);F(state,0x18c,0.5f);F(state,0x184,0.375f);
