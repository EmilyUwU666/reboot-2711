+        var token=new StringBuilder();bool quoted=false;
+        foreach(char c in command+' ')
+        {
+            if(c=='"'){quoted=!quoted;continue;}
+            if(char.IsWhiteSpace(c)&&!quoted)
+            {
+                if(token.ToString().Equals("-SkipPatchCheck",StringComparison.OrdinalIgnoreCase))return true;
+                token.Clear();
+            }
+            else token.Append(c);
+        }
+        return false;
+    }
