+                for(int i=0;i<chunk.Length;i+=2)
+                {
+                    if(chunk[i]==0&&chunk[i+1]==0)return HasSkipPatchCheck(Encoding.Unicode.GetString(command.ToArray()));
+                    command.Add(chunk[i]);command.Add(chunk[i+1]);
+                }
+            }
+        }
