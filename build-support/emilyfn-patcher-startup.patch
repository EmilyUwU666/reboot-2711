diff --git a/launcher/Emilyfn.Core/EarlyStartupPatcher38.cs b/launcher/Emilyfn.Core/EarlyStartupPatcher38.cs
new file mode 100644
--- /dev/null
+++ b/launcher/Emilyfn.Core/EarlyStartupPatcher38.cs
@@ -0,0 +1,98 @@
+using System.Buffers.Binary;
+using System.Text;
+namespace Emilyfn.Core;
+
+// Read-only observation of the CL47722112 early startup screen. Never changes completion flags.
+public static class EarlyStartupPatcher38
+{
+    public sealed record State(bool ProfileMatched,bool Active,bool? PatchCompleted,bool? ScreenFinished,
+        bool? MinimumDisplayTimeElapsed,uint? RawPatchState,float? DownloadProgress,float? InstallProgress,float? CombinedProgress,
+        bool? SkipPatchCheckTokenObserved,string? Failure);
+    public static State Inspect(Func<ulong,int,byte[]> read,ulong image)
+    {
+        bool profile=false,active=false;bool? skip=null;
+        var source=read;
+        read=(address,length)=>
+        {
+            var bytes=source(address,length);
+            if(bytes.Length!=length)throw new InvalidDataException("Incomplete startup-state read.");
+            return bytes;
+        };
+        try
+        {
+            foreach(var a in Anchors)
+                if(!read(checked(image+a.Rva),a.Bytes.Length).AsSpan().SequenceEqual(a.Bytes))
+                    throw new InvalidDataException("Early startup instruction profile does not match.");
+            profile=true;
+            uint D(ulong a)=>BinaryPrimitives.ReadUInt32LittleEndian(read(a,4));
+            ulong Q(ulong a)=>BinaryPrimitives.ReadUInt64LittleEndian(read(a,8));
+            skip=ObserveSkipPatchCheck(read,image);
+            ulong screen=Q(image+0x16e1b900);
+            if(screen==0)return new(profile,false,null,null,null,null,null,null,null,skip,null);
+            ulong vt=Q(screen);
+            if(vt!=image+0x1543a2e0 || Q(vt+0x10)!=image+0x8b84524 || Q(vt+0x40)!=image+0x70f7664 || Q(vt+0x50)!=image+0x1a38c0)
+                return new(profile,false,null,null,null,null,null,null,null,skip,"The active screen is not the verified early startup patcher.");
+            active=true;
+            bool Flag(ulong offset)
+            {
+                byte value=read(checked(screen+offset),1)[0];
+                if(value>1)throw new InvalidDataException("Unexpected startup-screen boolean.");
+                return value==1;
+            }
+            float Progress(ulong offset)
+            {
+                float value=BitConverter.Int32BitsToSingle(unchecked((int)D(checked(screen+offset))));
+                if(!float.IsFinite(value)||value < -1 || value > 2)throw new InvalidDataException("Unexpected startup progress value.");
+                return value;
