diff --git a/Reboot2711/RuntimeProfile.h b/Reboot2711/RuntimeProfile.h
new file mode 100644
index 0000000..6073364
--- /dev/null
+++ b/Reboot2711/RuntimeProfile.h
@@ -0,0 +1,54 @@
+#pragma once
+#include "BuildVersion.h"
+
+namespace Reboot2711
+{
+    struct ReflectionLayout
+    {
+        unsigned OffsetInternal;
+        unsigned FieldMask;
+        unsigned FieldNext;
+        unsigned FieldName;
+        unsigned FramePropertyChain;
+        unsigned FrameNativeFunction;
+    };
+
+    struct RuntimeProfile
+    {
+        unsigned Season = 0;
+        unsigned ReleaseMinor = 0;
+        unsigned EngineMinor = 0;
+        const wchar_t* OpenMap = L"";
+        bool UseIris = false;
+        bool NeedsInventoryFilter = false;
+        bool BeyondUpstreamDocumentedRange = false;
+        ReflectionLayout Reflection{};
+    };
+
+    inline std::optional<RuntimeProfile> SelectRuntimeProfile(const BuildVersion& build)
+    {
+        if (!IsTarget(build))
+            return std::nullopt;
+        const auto release = build.Season * 100 + build.ReleaseMinor;
+        RuntimeProfile result;
+        result.Season = build.Season;
+        result.ReleaseMinor = build.ReleaseMinor;
+        result.EngineMinor = build.EngineMinor;
+        // These map names, thresholds and layouts come from the pinned Erbium source.
+        result.OpenMap = build.Season <= 22 ? L"open Artemis_Terrain"
+            : build.Season <= 26 ? L"open Asteria_Terrain"
+            : build.Season == 27 ? L"open Athena_Terrain" : L"open Helios_Terrain";
+        result.UseIris = build.EngineMinor >= 3;
+        result.NeedsInventoryFilter = result.UseIris && build.Season >= 29;
+        result.BeyondUpstreamDocumentedRange = release > 3000;
+        result.Reflection = {
