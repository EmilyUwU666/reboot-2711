+using Emilyfn.Core;
+using System.Buffers.Binary;
+static class DispatchTargetChecks
+{
+    public static void Run()
+    {
+        const ulong image=0x50000,table=0x20000000,objects=0x30000000;
+        var memory=new Dictionary<ulong,byte[]>();
+        byte[] Alloc(ulong a,int n){var b=new byte[n];memory.Add(a,b);return b;}
+        void Q(byte[] b,int o,ulong v)=>BinaryPrimitives.WriteUInt64LittleEndian(b.AsSpan(o),v);
+        void D(byte[] b,int o,uint v)=>BinaryPrimitives.WriteUInt32LittleEndian(b.AsSpan(o),v);
+        void W(byte[] b,int o,ushort v)=>BinaryPrimitives.WriteUInt16LittleEndian(b.AsSpan(o),v);
+        uint Enc(uint v)=>unchecked(((v-1)^0x6f01622bu)+1);
+        var globals=Alloc(image+0x16cfacd8,12);Q(globals,0,table);D(globals,8,5);
+        var slots=Alloc(table,192);var vt=Alloc(image+0x1000,29*8);Q(vt,28*8,image+0x3729a);
+        for(int i=0;i<5;i++)
+        {
+            ulong a=objects+(ulong)i*0x100;var b=Alloc(a,0x100);Q(b,0,image+0x1000);D(b,0x20,Enc((uint)i+1));
+            Q(b,0x18,i==3?objects+0x200:i==4?objects+0x100:objects);Q(slots,i*32+8,a);
+        }
+        var obj=memory[objects+0x300];D(obj,0x10,0x31);
+        var fn=memory[objects+0x400];Q(fn,8,objects+0x200);D(fn,0xb8,0x54020401);
+        D(fn,0x68,8^0x1937f47b);W(fn,0xbc,8^0x8250);Q(fn,0xe0,image+0x432782a);
+        var names=new Dictionary<uint,string>{{1,"Class"},{2,"Function"},{3,"ActorComponent"},{4,"Default__ActorComponent"},{5,"GetOwner"}};
+        byte[] Read(ulong a,int n)
+        {
+            foreach(var p in memory)if(a>=p.Key&&a-p.Key<=(ulong)p.Value.Length&&(ulong)n<=(ulong)p.Value.Length-(a-p.Key))
+                return p.Value.AsSpan((int)(a-p.Key),n).ToArray();
+            throw new InvalidDataException("Fixture memory unavailable");
+        }
+        DispatchTarget38.Selection Find()=>DispatchTarget38.Find(Read,image,names);
+        if(Find().Value?.Object!=objects+0x300)throw new Exception("Default component target not resolved");
+        void Refuse(){if(Find().Value is not null)throw new Exception("Unverified target was accepted");}
+        Q(slots,3*32+8,0);Refuse();Q(slots,3*32+8,objects+0x300);
+        D(globals,8,4);Refuse();D(globals,8,5);
+        D(obj,0x10,0x40000031);Refuse();D(obj,0x10,0x31);
+        W(fn,0xbc,9^0x8250);Refuse();W(fn,0xbc,8^0x8250);
+        Q(fn,8,objects);Refuse();Q(fn,8,objects+0x200);
+        Q(fn,0xe0,image+0x432782b);Refuse();Q(fn,0xe0,image+0x432782a);
+        D(globals,8,6);Q(slots,5*32+8,objects+0x300);Refuse();
+        Console.WriteLine("Dispatch target checks passed: exact owner, missing/ambiguous instances, flags, parameters and entry mismatch.");
+    }
+}
