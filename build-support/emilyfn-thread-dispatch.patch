+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <cwchar>
+int wmain(int argc,wchar_t** argv) {
+    const bool noPump=argc>1 && std::wcscmp(argv[1],L"--no-pump")==0;
+    const bool wrongName=argc>1 && std::wcscmp(argv[1],L"--wrong-name")==0;
+    MSG msg{};PeekMessageW(&msg,nullptr,0,0,PM_NOREMOVE);
+    SetThreadDescription(GetCurrentThread(),wrongName?L"FixtureOtherThread":L"GameThread");
+    if(noPump){Sleep(60000);return 0;}
+    while(GetMessageW(&msg,nullptr,0,0)>0){TranslateMessage(&msg);DispatchMessageW(&msg);}
+    return 0;
+}
diff --git a/launcher/native/ThreadProbe/Protocol.h b/launcher/native/ThreadProbe/Protocol.h
new file mode 100644
--- /dev/null
+++ b/launcher/native/ThreadProbe/Protocol.h
@@ -0,0 +1,24 @@
+#pragma once
+#include <windows.h>
+#include <cstdint>
+#include <cstddef>
+namespace EmilyfnProbe {
+inline constexpr std::uint32_t Magic = 0xef380002;
+inline constexpr wchar_t MessageName[] = L"Emilyfn.DispatchProbe.v1";
+struct Shared {
+    std::uint32_t magic, version;
+    volatile LONG state; // 1 armed, 2 executing, 3 complete, 4 cancelled
+    std::uint32_t pid, tid, error;
+    std::uint64_t nonce, created, deadline, image, klass, object, function;
+    std::uint32_t objectName, className, functionName, hasTarget;
+    std::uint64_t dispatchRva, nativeRva;
+    volatile LONG calls;
+    std::uint32_t callbackTid, callbackPid, reserved;
+    std::uint64_t returned, expected;
+    std::uint32_t status, exception;
+};
+static_assert(sizeof(Shared) == 152);
+static_assert(offsetof(Shared, nonce) == 24 && offsetof(Shared, calls) == 112 && offsetof(Shared, status) == 144);
+// status: 1 callback observed, 2 target absent, 3 profile rejected,
+// 4 GetOwner matched, 5 exception, 6 return mismatch, 7 thread identity rejected.
+}
diff --git a/launcher/native/ThreadProbe/Probe.cpp b/launcher/native/ThreadProbe/Probe.cpp
new file mode 100644
--- /dev/null
+++ b/launcher/native/ThreadProbe/Probe.cpp
@@ -0,0 +1,95 @@
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#include "Protocol.h"
+#include <cstring>
+#include <cwchar>
+using namespace EmilyfnProbe;
+
+template<class T> bool Read(std::uint64_t a, T& value) {
+    SIZE_T got = 0;
+    return ReadProcessMemory(GetCurrentProcess(), reinterpret_cast<void*>(a), &value, sizeof(T), &got) && got == sizeof(T);
+}
+template<std::size_t N> bool Bytes(std::uint64_t a, const char (&bytes)[N]) {
+    char data[N - 1]{}; SIZE_T got = 0;
+    return ReadProcessMemory(GetCurrentProcess(), reinterpret_cast<void*>(a), data, sizeof(data), &got)
+        && got == sizeof(data) && std::memcmp(data, bytes, sizeof(data)) == 0;
+}
+bool GameThread() {
+    PWSTR name = nullptr;
+    const auto hr = GetThreadDescription(GetCurrentThread(), &name);
+    const bool same = SUCCEEDED(hr) && name && std::wcscmp(name, L"GameThread") == 0;
+    if (name) LocalFree(name);
+    return same;
+}
+bool Validate(const Shared& p, std::uint64_t& expected) {
+    const auto image = reinterpret_cast<std::uint64_t>(GetModuleHandleW(nullptr));
+    if (p.image != image || p.dispatchRva != 0x3729a || p.nativeRva != 0x432782a || p.hasTarget != 1) return false;
+    // Exact observed GetOwner exec wrapper: advance FFrame bytecode and return object+0xA8.
+    if (!Bytes(image + p.nativeRva, "\x48\x8b\x42\x20\x48\x83\xf8\x01\x48\x83\xd8\xff\x48\x89\x42\x20\x48\x8b\x81\xa8\x00\x00\x00\x49\x89\x00\xc3") ||
+        !Bytes(image + p.dispatchRva, "\x55\x41\x57\x41\x56\x41\x55\x41\x54\x56\x57\x53\x48\x81\xec\xc8\x00\x00\x00") ||
+        !Bytes(image + 0x373d5, "\x48\x63\x47\x68\xba\x7b\xf4\x37\x19\x48\x89\xc1\x48\x31\xd1\x48") ||
+        !Bytes(image + 0x3743c, "\x0f\xb7\x87\xbc\x00\x00\x00\x48\x35\x50\x82\x00\x00\x39")) return false;
+    std::uint64_t klass = 0, outer = 0, vt = 0, dispatch = 0, entry = 0;
+    std::uint32_t flags = 0, objectName = 0, className = 0, functionName = 0, functionFlags = 0, storage = 0;
+    std::uint16_t parameters = 0;
+    return p.object && p.klass && p.function &&
+        Read(p.object + 0x18, klass) && klass == p.klass &&
+        Read(p.function + 8, outer) && outer == p.klass &&
+        Read(p.object + 0x20, objectName) && objectName == p.objectName &&
+        Read(p.klass + 0x20, className) && className == p.className &&
+        Read(p.function + 0x20, functionName) && functionName == p.functionName &&
+        Read(p.object + 0x10, flags) && (flags & 0x10) && !(flags & 0x40000000) &&
+        Read(p.object, vt) && Read(vt + 28 * 8, dispatch) && dispatch == image + p.dispatchRva &&
+        Read(p.function + 0xe0, entry) && entry == image + p.nativeRva &&
+        Read(p.function + 0xb8, functionFlags) && functionFlags == 0x54020401 &&
+        Read(p.function + 0x68, storage) && (storage ^ 0x1937f47b) == 8 &&
+        Read(p.function + 0xbc, parameters) && (parameters ^ 0x8250) == 8 &&
+        Read(p.object + 0xa8, expected);
+}
+DWORD Call(Shared* p) {
+    // Only the fixed read-only GetOwner test can reach this point.
+    __try {
+        using Dispatch = void(*)(void*, void*, void*);
+        reinterpret_cast<Dispatch>(p->image + 0x3729a)(reinterpret_cast<void*>(p->object), reinterpret_cast<void*>(p->function), &p->returned);
+        return 0;
+    } __except(EXCEPTION_EXECUTE_HANDLER) { return GetExceptionCode(); }
+}
+extern "C" __declspec(dllexport) LRESULT CALLBACK EmilyfnThreadProbe(int code, WPARAM remove, LPARAM parameter) {
+    if (code == HC_ACTION && remove == PM_REMOVE && parameter) {
+        const auto msg = reinterpret_cast<const MSG*>(parameter);
+        const auto message = RegisterWindowMessageW(MessageName);
+        if (message && msg->message == message && msg->wParam) {
+            wchar_t name[128]{};
+            swprintf_s(name, L"Local\\Emilyfn-dispatch-%lu-%lu-%016llx", GetCurrentProcessId(), GetCurrentThreadId(), static_cast<unsigned long long>(msg->wParam));
+            const auto mapping = OpenFileMappingW(FILE_MAP_READ | FILE_MAP_WRITE, FALSE, name);
+            if (mapping) {
+                const auto p = static_cast<Shared*>(MapViewOfFile(mapping, FILE_MAP_READ | FILE_MAP_WRITE, 0, 0, 256));
+                if (p) {
+                    FILETIME created{}, exited{}, kernel{}, user{};
+                    const bool identity = GetProcessTimes(GetCurrentProcess(), &created, &exited, &kernel, &user) &&
+                        p->created == (static_cast<std::uint64_t>(created.dwHighDateTime) << 32 | created.dwLowDateTime);
+                    if (p->magic == Magic && p->version == 1 && p->nonce == msg->wParam && p->pid == GetCurrentProcessId() &&
+                        p->tid == GetCurrentThreadId() && identity && GetTickCount64() <= p->deadline &&
+                        InterlockedCompareExchange(&p->state, 2, 1) == 1) {
+                        p->callbackPid = GetCurrentProcessId(); p->callbackTid = GetCurrentThreadId(); p->status = 1;
+                        if (!GameThread()) p->status = 7;
+                        else if (!p->hasTarget) p->status = 2;
+                        else if (!Validate(*p, p->expected)) p->status = 3;
+                        else if (GetTickCount64() > p->deadline) p->status = 8;
+                        else {
+                            p->returned = p->expected ^ 0xffffffffffffffffULL;
+                            InterlockedExchange(&p->calls, 1);
+                            p->exception = Call(p);
+                            p->status = p->exception ? 5 : p->returned == p->expected ? 4 : 6;
+                        }
+                        InterlockedExchange(&p->state, 3);
+                    }
+                    UnmapViewOfFile(p);
+                }
+                CloseHandle(mapping);
+            }
+        }
+    }
+    return CallNextHookEx(nullptr, code, remove, parameter);
+}
+BOOL WINAPI DllMain(HINSTANCE, DWORD, LPVOID) { return TRUE; }
