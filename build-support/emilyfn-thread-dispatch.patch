+using System.Buffers.Binary;
+namespace Emilyfn.Core;
+
+internal static class DispatchTarget38
+{
+    internal sealed record Target(ulong Class,ulong Object,ulong Function,uint ObjectName,uint ClassName,uint FunctionName);
+    internal sealed record Selection(Target? Value,string Reason);
+    internal static Selection Find(Func<ulong,int,byte[]> read,ulong image,IReadOnlyDictionary<uint,string> names)
+    {
+        uint D(ulong a)=>BinaryPrimitives.ReadUInt32LittleEndian(read(a,4));
+        ulong Q(ulong a)=>BinaryPrimitives.ReadUInt64LittleEndian(read(a,8));
+        string Name(ulong a)=>names.TryGetValue(NamePool38.DecodeIndex(D(checked(a+0x20))),out var n)?n:throw new InvalidDataException("Unknown target name.");
+        var classes=new List<ulong>();var objects=new List<ulong>();var functions=new List<ulong>();
+        ulong table=Q(checked(image+0x16cfacd8));uint count=D(checked(image+0x16cface0));
+        if(count is 0 or >1000000)throw new InvalidDataException("Invalid object table.");
+        for(uint i=0;i<count;i++)
+        {
+            try
+            {
+                ulong obj=Q(checked(table+i*32UL+8));string name=Name(obj),kind=Name(Q(checked(obj+0x18)));
+                if(name=="ActorComponent" && kind=="Class")classes.Add(obj);
+                if(name=="Default__ActorComponent" && kind=="ActorComponent")objects.Add(obj);
+                if(name=="GetOwner" && kind=="Function")functions.Add(obj);
+            }
+            catch(InvalidDataException){} catch(OverflowException){}
+        }
+        if(classes.Count!=1)return new(null,"ActorComponent class is missing or ambiguous.");
+        ulong klass=classes[0];
+        objects=objects.Where(a=>Q(checked(a+0x18))==klass).ToList();
+        functions=functions.Where(a=>Q(checked(a+8))==klass).ToList();
+        if(objects.Count!=1)return new(null,"No unique initialized Default__ActorComponent is present; the function-call test will be skipped.");
+        if(functions.Count!=1)return new(null,"ActorComponent.GetOwner is missing or ambiguous.");
+        ulong o=objects[0],f=functions[0];
+        uint flags=D(o+0x10);ushort parameters=BinaryPrimitives.ReadUInt16LittleEndian(read(f+0xbc,2));
+        if((flags&0x10)==0 || (flags&0x40000000)!=0 || D(f+0xb8)!=0x54020401 ||
+            (D(f+0x68)^0x1937f47b)!=8 || (parameters^0x8250)!=8 || Q(f+0xe0)!=image+0x432782a || Q(Q(o)+28*8)!=image+0x3729a)
+            return new(null,"The default component or GetOwner call layout failed validation.");
+        return new(new(klass,o,f,D(o+0x20),D(klass+0x20),D(f+0x20)),"ActorComponent.GetOwner default-object target is available for a guarded call.");
+    }
+}
