new file mode 100644
--- /dev/null
+++ b/launcher/Emilyfn.ThreadProbeTests/Program.cs
@@ -0,0 +1,50 @@
+using Emilyfn.Core;
+using System.Diagnostics;
+using System.Text.Json;
+
+if(!OperatingSystem.IsWindows())throw new PlatformNotSupportedException();
+string root=Path.Combine(Path.GetTempPath(),"Emilyfn thread probe "+Guid.NewGuid().ToString("N"));Directory.CreateDirectory(root);
+var children=new List<Process>();int checks=0;
+void Check(bool ok,string reason){if(!ok)throw new Exception(reason);checks++;}
+try
+{
+    string exe=Path.Combine(root,"FortniteClient-Win64-Shipping.exe"),dll=Path.GetFullPath(args[1]);File.Copy(Path.GetFullPath(args[0]),exe);
+    async Task<(Process Process,int Tid)> Start(string argument)
+    {
+        var info=new ProcessStartInfo(exe){UseShellExecute=false};if(argument.Length>0)info.ArgumentList.Add(argument);
+        var process=Process.Start(info)!;children.Add(process);
+        for(int i=0;i<100;i++)
+        {
+            var found=GameThreadProbe38.FindGameThreads(process);
+            if(found.Count==1)return(process,found[0]);
+            await Task.Delay(25);
+        }
+        throw new Exception("Fixture GameThread was not discovered");
+    }
+    var child=await Start("");
+    var result=GameThreadProbe38.RunCallback(child.Process,child.Tid,dll,0,null,5000);
+    Check(result.State==3&&result.Status==2,"Thread-scoped callback did not report missing target");
+    Check(result.CallbackProcessId==child.Process.Id&&result.CallbackThreadId==child.Tid,"Callback ran in the wrong process/thread");
+    Check(result.FunctionCallsAttempted==false&&result.HookRemoved,"No-target callback called a function or leaked a hook");
+    var invalid=new DispatchTarget38.Target(1,2,3,4,5,6);
+    result=GameThreadProbe38.RunCallback(child.Process,child.Tid,dll,0,invalid,5000);
+    Check(result.State==3&&result.Status==3&&result.FunctionCallsAttempted==false&&result.HookRemoved,"Invalid call target did not fail closed");
+    var noPump=await Start("--no-pump");
+    result=GameThreadProbe38.RunCallback(noPump.Process,noPump.Tid,dll,0,null,500);
+    Check(result.State==4&&result.FunctionCallsAttempted==false&&result.HookRemoved&&result.Failure is not null,"Unpumped queue did not time out and cancel");
+    bool rejected=false;
+    try{GameThreadProbe38.RunCallback(child.Process,noPump.Tid,dll,0,null,500);}catch(InvalidOperationException){rejected=true;}
+    Check(rejected,"Another process's thread was accepted");
+    var target=new CaptureTarget(child.Process.Id,child.Process.StartTime.ToUniversalTime(),exe);
+    var gate=await GameThreadProbe38.RunAsync(target,root);
+    using var json=JsonDocument.Parse(File.ReadAllText(gate.File));
+    Check(!json.RootElement.GetProperty("FunctionCallsAttempted").GetBoolean(),"Unverified executable attempted a call");
+    Check(json.RootElement.GetProperty("Failure").GetString()!.Contains("exact 38.00"),"Exact-image gate missing");
+    Check(!child.Process.HasExited,"Probe terminated fixture");
+    Console.WriteLine($"THREAD PROBE: {checks} checks passed; native callback ran in synthetic GameThread, no game functions called.");
+}
+finally
+{
+    foreach(var child in children){if(!child.HasExited){child.Kill();child.WaitForExit();}child.Dispose();}
+    Directory.Delete(root,true);
+}
